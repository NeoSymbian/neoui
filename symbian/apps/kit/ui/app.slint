// SPDX-License-Identifier: GPL-3.0-only
// NEOKIT.EXE: the kit gallery under a kit header (its ⋮ picks the sheet). A new app starts from this file: import
// what it needs from "@neoui/kit.slint", export Theme (the app sets Theme.dp), Scroll (smooth scrolling) and Kit (Back
// through menus and sheets), and draw its header, footer and content with the kit's parts.
import "@neoui/fonts/NeoSans-Regular.ttf";
import "@neoui/fonts/NeoSans-Medium.ttf";
import "@neoui/fonts/NeoSans-SemiBold.ttf";
import "@neoui/fonts/NeoSans-Bold.ttf";
import "@neoui/fonts/DejaVuSans.ttf";
import { Theme, Kit, Scroll, Header, Button, SectionHeader } from "@neoui/kit.slint";
import { GalleryPages, GalleryState } from "@neoui/gallery/gallery.slint";

export { Theme, Kit, Scroll, GalleryState }

// The "Files" page (protocol 1.12, docs files-app.md FA8): files picked and saved through Files, and files other
// apps open here with Open with. The app fills `file-*` from the file it got (its name, size and first line).
export global FileDemo {
    in property <string> status: "Pick a file in Files, or save one there.";
    in property <string> name;
    in property <string> size;
    in property <string> first-line;
    callback pick();
    callback save();
}

component FilesPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.margin;
        spacing: Theme.margin;
        alignment: start;
        Button {
            text: "Pick a file";
            clicked => {
                FileDemo.pick();
            }
        }

        Button {
            text: "Save a file";
            primary: false;
            clicked => {
                FileDemo.save();
            }
        }

        Text {
            text: FileDemo.status;
            color: Theme.text-secondary;
            font-size: Theme.font-label;
            wrap: word-wrap;
        }

        if FileDemo.name != "": VerticalLayout {
            spacing: 4 * Theme.dp;
            SectionHeader {
                text: "The file";
            }

            // a name or a line in any keyboard language (Armenian, Cyrillic): NeoSans has Latin only
            Text {
                text: FileDemo.name;
                font-family: "DejaVu Sans";
                color: Theme.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            Text {
                text: FileDemo.size;
                color: Theme.text-dim;
                font-size: Theme.font-label;
            }

            Text {
                text: FileDemo.first-line;
                font-family: "DejaVu Sans";
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }
        }
    }
}

// TP2a's cards from an app (docs neoui-shell/top-panel.md): post a sample set, clear it, and what the shade did; and
// (home.md Part 4) the kit's home widget, `kit.demo`: add it on home in edit mode, then send its content
export global NotifyDemo {
    in property <string> status: "Post sample cards, then pull the shade down.";
    callback post();
    callback clear();
    callback widget();
    // (TP5, TP6, TP4) a ringing call card, a timer and a call in the island, a card to reply to inline, and the end
    callback ring();
    callback live();
    callback reply();
    callback end-live();
}

component NotificationsPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.margin;
        spacing: Theme.margin;
        alignment: start;
        Button {
            text: "Post sample cards";
            clicked => {
                NotifyDemo.post();
            }
        }

        Button {
            text: "Clear them";
            primary: false;
            clicked => {
                NotifyDemo.clear();
            }
        }

        Button {
            text: "Send home widget";
            primary: false;
            clicked => {
                NotifyDemo.widget();
            }
        }

        Button {
            text: "Ringing call card";
            primary: false;
            clicked => {
                NotifyDemo.ring();
            }
        }

        Button {
            text: "Start a timer and a call";
            primary: false;
            clicked => {
                NotifyDemo.live();
            }
        }

        Button {
            text: "Card to reply to";
            primary: false;
            clicked => {
                NotifyDemo.reply();
            }
        }

        Button {
            text: "End the live demo";
            primary: false;
            clicked => {
                NotifyDemo.end-live();
            }
        }

        Text {
            text: NotifyDemo.status;
            color: Theme.text-secondary;
            font-size: Theme.font-label;
            wrap: word-wrap;
        }
    }
}

// TP3's media session from an app (docs neoui-shell/top-panel.md): post a sample track that "plays", end it, and the
// commands the shade's and home's buttons sent
export global MediaDemo {
    in property <string> status: "Play the sample, then pull the shade down.";
    callback play();
    callback end();
}

component MediaPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.margin;
        spacing: Theme.margin;
        alignment: start;
        Button {
            text: "Play a sample track";
            clicked => {
                MediaDemo.play();
            }
        }

        Button {
            text: "End the session";
            primary: false;
            clicked => {
                MediaDemo.end();
            }
        }

        Text {
            text: MediaDemo.status;
            color: Theme.text-secondary;
            font-size: Theme.font-label;
            wrap: word-wrap;
        }
    }
}

export component KitApp inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;
    property <[string]> names: [
        "Headers", "Footer", "Lists", "Menus", "Date picker", "Time picker", "Controls", "Feedback", "Phone parts",
        "Files", "Notifications", "Media"
    ];
    VerticalLayout {
        Header {
            title: root.names[GalleryState.page];
            search: false;
            menu: root.names;
            menu-picked(i) => {
                GalleryState.page = i;
            }
        }

        if GalleryState.page < 9: GalleryPages {
            vertical-stretch: 1;
        }
        if GalleryState.page == 9: FilesPage {
            vertical-stretch: 1;
        }
        if GalleryState.page == 10: NotificationsPage {
            vertical-stretch: 1;
        }
        if GalleryState.page == 11: MediaPage {
            vertical-stretch: 1;
        }
    }
}
