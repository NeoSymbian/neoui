// SPDX-License-Identifier: GPL-3.0-only
// The Terminal app (NEOTERM.EXE): a Symbian text console window -- ESHELL and the 2010 text programs -- in the look
// of the design's prototype Terminal screen (ui/screens/terminal.slint): dark ground, a monospaced font and a green
// cursor. Rows and the cursor come from the console server (Rust). Keys, including Esc, Tab and the arrows, come from
// the system keyboard in its terminal mode.
// DejaVu Sans Mono: Latin, Cyrillic and Armenian in one monospaced face (the keyboard's languages)
import "../../../../ui/fonts/DejaVuSansMono.ttf";
import { Theme } from "../../../../ui/theme.slint";
import { Alphabets } from "../../../../ui/components/keyboard/glyphs.slint";

export { Theme }

export component TermApp inherits Window {
    in property <[string]> rows;
    in property <int> cursor-x;
    in property <int> cursor-y;
    in property <bool> cursor-on: true;
    in property <length> cell-w;
    in property <length> cell-h;
    in property <length> font-px;
    in property <length> pad;
    // the system keyboard's height over the bottom of the surface
    in property <length> kb-h;
    default-font-family: "DejaVu Sans Mono";
    background: #07090c;

    // The grid is sized for the keyboard it started with; if the keyboard grew since (another language), the rows
    // move up so the cursor's row stays above it.
    property <length> lift: max(0, root.pad * 2 + (root.cursor-y + 1) * root.cell-h - (root.height - root.kb-h));

    Alphabets { }

    for row[i] in root.rows: Text {
        x: root.pad;
        y: root.pad + i * root.cell-h - root.lift;
        height: root.cell-h;
        text: row;
        color: #d7dde5;
        font-family: "DejaVu Sans Mono";
        font-size: root.font-px;
        vertical-alignment: center;
    }

    if root.cursor-on: Rectangle {
        x: root.pad + root.cursor-x * root.cell-w;
        y: root.pad + root.cursor-y * root.cell-h - root.lift;
        width: root.cell-w;
        height: root.cell-h;
        background: #7ee787;
        opacity: 0.55;
    }
}
