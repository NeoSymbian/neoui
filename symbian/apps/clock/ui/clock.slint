// SPDX-License-Identifier: GPL-3.0-only
// The Clock app (NEOCLOCK.EXE), the kit's footer app (Shell v2 K02): five top pages (Clock, Alarms, World, Timer,
// Stopwatch) behind icon-only footer tabs, a sideways swipe between them, and a header that names the tab with its
// actions (+ on Alarms and World, ⋮ Settings). The sub-views cover header and footer with their own: [✕ Set time ✓],
// [✕ Edit alarm ✓], [← Add a city], [← Settings]; a ringing alarm is full screen.
//
// State lives in the `ClockState` global (state.slint), filled by src/pages/*.rs; each page is one file in pages/.
import "@neoui/fonts/NeoSans-Regular.ttf";
import "@neoui/fonts/NeoSans-Medium.ttf";
import "@neoui/fonts/NeoSans-SemiBold.ttf";
import "@neoui/fonts/NeoSans-Bold.ttf";
import { Theme, Kit, Scroll, Header, SubHeader, FormHeader, Footer, TabPages, Act } from "@neoui/kit.slint";
import { ClockState } from "state.slint";
import { FacePage } from "pages/face.slint";
import { SetTimePage } from "pages/set_time.slint";
import { AlarmsPage, AlarmEditor } from "pages/alarms.slint";
import { WorldPage, CityPicker } from "pages/world.slint";
import { TimerPage } from "pages/timer.slint";
import { StopwatchPage } from "pages/stopwatch.slint";
import { RingingPage } from "pages/ringing.slint";
import { SettingsPage } from "pages/settings.slint";

export { Theme, ClockState, Scroll, Kit }

// A sub-view: its header on top, the page under it, over the tabs and the footer.
component SubView inherits Rectangle {
    background: Theme.bg;
    TouchArea { }

    VerticalLayout {
        @children
    }
}

export component ClockApp inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;
    property <[string]> names: ["Clock", "Alarms", "World", "Timer", "Stopwatch"];

    VerticalLayout {
        Header {
            title: root.names[ClockState.tab];
            search: false;
            tap-to-top: false;
            actions: ClockState.tab == 1 ? [
                { icon: @image-url("@neoui/icons/sys/add.svg"), label: "Add alarm", disabled: ClockState.alarms-full },
            ] : ClockState.tab == 2 ? [
                { icon: @image-url("@neoui/icons/sys/add.svg"), label: "Add city", disabled: ClockState.cities-full },
            ] : [];
            menu: ["Settings"];
            action(i) => {
                if ClockState.tab == 1 {
                    ClockState.add-alarm();
                } else {
                    ClockState.add-city();
                }
            }
            menu-picked(i) => {
                ClockState.open-settings();
            }
        }

        TabPages {
            count: 5;
            current: ClockState.tab;
            tab-changed(i) => {
                ClockState.tab-chosen(i);
            }
            FacePage { }
            AlarmsPage { }
            WorldPage { }
            TimerPage { }
            StopwatchPage { }
        }

        Footer {
            current: ClockState.tab;
            picked(i) => {
                ClockState.tab-chosen(i);
            }
            tabs: [
                { icon: @image-url("@neoui/icons/sys/clock.svg"), label: "Clock" },
                { icon: @image-url("@neoui/icons/sys/alarm.svg"), label: "Alarms" },
                { icon: @image-url("@neoui/icons/sys/world.svg"), label: "World" },
                { icon: @image-url("@neoui/icons/sys/timer.svg"), label: "Timer", badge: ClockState.timer-phase == 3 ? -1 : 0 },
                { icon: @image-url("@neoui/icons/sys/stopwatch.svg"), label: "Stopwatch" },
            ];
        }
    }

    // sub-views cover the tabs (Back, ✕ or ← closes them)
    if ClockState.view == "set-time": SubView {
        FormHeader {
            title: "Set time";
            cancel => { ClockState.close(); }
            save => { ClockState.save-time(); }
        }
        SetTimePage { }
    }
    if ClockState.view == "alarm": SubView {
        FormHeader {
            title: ClockState.edit-new ? "New alarm" : "Edit alarm";
            cancel => { ClockState.close(); }
            save => { ClockState.save-alarm(); }
        }
        AlarmEditor { }
    }
    if ClockState.view == "cities": SubView {
        SubHeader {
            title: "Add a city";
            search: false;
            back => { ClockState.close(); }
        }
        CityPicker { }
    }
    if ClockState.view == "settings": SubView {
        SubHeader {
            title: "Settings";
            search: false;
            back => { ClockState.close(); }
        }
        SettingsPage { }
    }
    if ClockState.view == "ringing": RingingPage { }
}
