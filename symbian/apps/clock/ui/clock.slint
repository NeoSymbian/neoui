// SPDX-License-Identifier: GPL-3.0-only
// The Clock app (NEOCLOCK.EXE): five tabs (Clock, Alarms, World, Timer, Stopwatch) and the sub-views that open over
// them (Set time, the alarm editor, the city catalogue, a ringing alarm). Drawn by its own process into the surface
// the UI server shows in the shell's body; it reuses the design's tokens, digits and components.
//
// State lives in the `ClockState` global (state.slint), filled by src/pages/*.rs; each page is one file in pages/.
import "../../../../ui/fonts/Inter-VariableFont.ttf";
import { Theme } from "../../../../ui/theme.slint";
import { TabBar } from "../../../../ui/components/controls.slint";
import { ClockState } from "state.slint";
import { FacePage } from "pages/face.slint";
import { SetTimePage } from "pages/set_time.slint";
import { AlarmsPage, AlarmEditor } from "pages/alarms.slint";
import { WorldPage, CityPicker } from "pages/world.slint";
import { TimerPage } from "pages/timer.slint";
import { StopwatchPage } from "pages/stopwatch.slint";
import { RingingPage } from "pages/ringing.slint";

export { Theme, ClockState }

export component ClockApp inherits Window {
    default-font-family: "Inter";
    background: Theme.bg;

    tabs := TabBar {
        y: 0;
        tabs: ["Clock", "Alarms", "World", "Timer", "Stopwatch"];
        current: ClockState.tab;
        font-size: 12.5 * Theme.dp;
        tab-clicked(i) => {
            ClockState.tab-chosen(i);
        }
    }

    Rectangle {
        y: tabs.height;
        height: root.height - tabs.height;
        if ClockState.tab == 0: FacePage { }
        if ClockState.tab == 1: AlarmsPage { }
        if ClockState.tab == 2: WorldPage { }
        if ClockState.tab == 3: TimerPage { }
        if ClockState.tab == 4: StopwatchPage { }
    }

    // sub-views cover the tabs (Back or Cancel closes them)
    if ClockState.view == "set-time": SetTimePage { }
    if ClockState.view == "alarm": AlarmEditor { }
    if ClockState.view == "cities": CityPicker { }
    if ClockState.view == "ringing": RingingPage { }
}
