// The Clock tab: the time (digital, or the analog face the app draws), the seconds and the date when enabled (Clock
// settings), the next alarm; "Set time" opens the editor.
import { Theme } from "../../../../../ui/theme.slint";
import { BigClock, Button } from "../../../../../ui/components/controls.slint";
import { Glyph } from "../../../../../ui/components/frame.slint";
import { ClockState } from "../state.slint";

export component FacePage inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 12 * Theme.dp;
        if ClockState.analog: HorizontalLayout {
            alignment: center;
            Image {
                source: ClockState.analog-face;
                width: 220 * Theme.dp;
                height: 220 * Theme.dp;
            }
        }

        if !ClockState.analog: HorizontalLayout {
            alignment: center;
            spacing: 8 * Theme.dp;
            BigClock {
                hours: ClockState.hours;
                minutes: ClockState.minutes;
                lead-zero: ClockState.h24;
                digit-h: 88 * Theme.dp;
            }

            if ClockState.am-pm != "": VerticalLayout {
                alignment: end;
                padding-bottom: 8 * Theme.dp;
                Text {
                    text: ClockState.am-pm;
                    color: Theme.text-secondary;
                    font-size: 24 * Theme.dp;
                }
            }
        }

        if !ClockState.analog && ClockState.show-seconds: Text {
            text: (ClockState.seconds < 10 ? ":0" : ":") + ClockState.seconds;
            color: Theme.text-dim;
            font-size: 26 * Theme.dp;
            horizontal-alignment: center;
        }

        if ClockState.show-date: Text {
            text: ClockState.date;
            color: Theme.text;
            font-size: 18 * Theme.dp;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 6 * Theme.dp;
            height: 20 * Theme.dp;
            Glyph {
                visible: ClockState.next-alarm != "";
                source: @image-url("../../../../../ui/icons/sys/alarm.svg");
                size: 16 * Theme.dp;
                colorize: Theme.text-dim;
            }

            Text {
                text: ClockState.next-alarm == "" ? "No alarms on" : ClockState.next-alarm;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;
            padding-top: 20 * Theme.dp;
            Button {
                text: "Set time";
                primary: false;
                clicked => {
                    ClockState.set-time();
                }
            }
        }
    }
}
