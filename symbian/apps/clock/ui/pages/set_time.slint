// "Set time" (sub-view): a stepper per field (date, time, zone) in fixed columns, so every row's buttons line up
// whatever the value's width; ✕ (or Back) leaves it unchanged, ✓ sets Symbian's clock (FormHeader in clock.slint).
import { Theme } from "@neoui/theme.slint";
import { Button } from "@neoui/components/controls.slint";
import { ClockState } from "../state.slint";

export component SetTimePage inherits Rectangle {
    background: Theme.bg;
    property <length> label-w: 72 * Theme.dp;
    property <length> step-w: 56 * Theme.dp;
    VerticalLayout {
        alignment: start;
        spacing: 8 * Theme.dp;
        padding: Theme.margin;
        for field[i] in ClockState.fields: HorizontalLayout {
            spacing: 8 * Theme.dp;
            height: 52 * Theme.dp;
            Text {
                text: field;
                width: root.label-w;
                color: Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }

            Button {
                text: "−";
                primary: false;
                width: root.step-w;
                clicked => {
                    ClockState.adjust(i, -1);
                }
            }

            Text {
                text: ClockState.values[i];
                horizontal-stretch: 1;
                min-width: 0;
                color: Theme.text;
                font-size: Theme.font-title;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            Button {
                text: "+";
                primary: false;
                width: root.step-w;
                clicked => {
                    ClockState.adjust(i, 1);
                }
            }
        }
    }
}
