// The World tab: the time in each chosen city against local time; tap a city to remove it. "+ Add city" opens the
// catalogue (sub-view "cities").
import { Theme } from "@neoui/theme.slint";
import { EmptyState } from "@neoui/components/feedback.slint";
import { ListRow } from "@neoui/components/lists.slint";
import { NeoList } from "@neoui/components/scroll.slint";
import { ClockState } from "../state.slint";

export component WorldPage inherits Rectangle {
    NeoList {
        VerticalLayout {
            alignment: start;
            if ClockState.cities.length == 0: EmptyState {
                icon: @image-url("@neoui/icons/sys/world.svg");
                title: "No cities";
                action: "+ Add city";
                acted => {
                    ClockState.add-city();
                }
            }
            for c[i] in ClockState.cities: ListRow {
                title: c.name;
                subtitle: c.day + " · " + c.difference;
                value: c.time;
                clicked => {
                    ClockState.remove-city(i);
                }
            }
        }
    }
}

export component CityPicker inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        NeoList {
            VerticalLayout {
                alignment: start;
                for c[i] in ClockState.catalogue: ListRow {
                    title: c.name;
                    value: c.added ? "Added" : c.offset;
                    clicked => {
                        ClockState.pick-city(i);
                    }
                }
            }
        }
    }
}
