// Clock settings (sub-view "settings", from the header's ⋮): what the Clock tab shows. Back or ← closes it.
import { Theme } from "@neoui/theme.slint";
import { ListRow, SectionHeader } from "@neoui/components/lists.slint";
import { ChoiceSheet } from "@neoui/components/sheet.slint";
import { ClockState } from "../state.slint";

export component SettingsPage inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Clock face"; }
        ListRow {
            title: "Face";
            value: ClockState.analog ? "Analog" : "Digital";
            clicked => { face.open = true; }
        }

        ListRow {
            title: "Show seconds";
            has-switch: true;
            switch-on: ClockState.show-seconds;
            switch-toggled(on) => { ClockState.set-seconds(on); }
        }

        ListRow {
            title: "Show date";
            has-switch: true;
            switch-on: ClockState.show-date;
            switch-toggled(on) => { ClockState.set-date(on); }
        }

        ListRow {
            title: "24-hour time";
            has-switch: true;
            switch-on: ClockState.h24;
            switch-toggled(on) => { ClockState.set-h24(on); }
            divider: false;
        }
    }

    face := ChoiceSheet {
        title: "Face";
        choices: ["Digital", "Analog"];
        current: ClockState.analog ? 1 : 0;
        chosen(i) => { ClockState.set-analog(i == 1); }
    }
}
