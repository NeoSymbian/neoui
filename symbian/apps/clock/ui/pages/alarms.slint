// The Alarms tab: one row per alarm (tap to edit, switch to turn on or off; + in the header adds one); the editor
// (sub-view "alarm", under a [✕ Edit alarm ✓] header) sets the time, the days and a label.
import { Theme } from "@neoui/theme.slint";
import { Button } from "@neoui/components/controls.slint";
import { Chip } from "@neoui/components/rows.slint";
import { EmptyState } from "@neoui/components/feedback.slint";
import { ListRow } from "@neoui/components/lists.slint";
import { NeoList } from "@neoui/components/scroll.slint";
import { ClockState } from "../state.slint";

export component AlarmsPage inherits Rectangle {
    NeoList {
        VerticalLayout {
            alignment: start;
            if ClockState.alarms.length == 0: EmptyState {
                icon: @image-url("@neoui/icons/sys/alarm.svg");
                title: "No alarms";
                action: "+ Add alarm";
                acted => {
                    ClockState.add-alarm();
                }
            }
            for a in ClockState.alarms: ListRow {
                title: a.time;
                subtitle: a.label + " · " + a.days;
                has-switch: true;
                switch-on: a.on;
                clicked => {
                    ClockState.edit-alarm(a.id);
                }
                switch-toggled(on) => {
                    ClockState.alarm-switched(a.id, on);
                }
            }
        }
    }
}

// A large value with − and + steppers above and below.
component Stepper inherits VerticalLayout {
    in property <string> text;
    callback step(int);
    spacing: 4 * Theme.dp;
    alignment: center;
    Button {
        text: "+";
        primary: false;
        clicked => {
            root.step(1);
        }
    }

    Text {
        text: root.text;
        color: Theme.text;
        font-size: 48 * Theme.dp;
        horizontal-alignment: center;
    }

    Button {
        text: "−";
        primary: false;
        clicked => {
            root.step(-1);
        }
    }
}

export component AlarmEditor inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        alignment: center;
        spacing: 14 * Theme.dp;
        padding: Theme.margin;
        HorizontalLayout {
            alignment: center;
            spacing: 12 * Theme.dp;
            Stepper {
                text: ClockState.h24 ? (ClockState.edit-hour < 10 ? "0" : "") + ClockState.edit-hour : ClockState.edit-hour;
                step(d) => {
                    ClockState.edit-step(0, d);
                }
            }

            Text {
                text: ":";
                color: Theme.text;
                font-size: 48 * Theme.dp;
                vertical-alignment: center;
            }

            Stepper {
                text: (ClockState.edit-minute < 10 ? "0" : "") + ClockState.edit-minute;
                step(d) => {
                    ClockState.edit-step(1, d);
                }
            }

            if ClockState.edit-am-pm != "": Text {
                text: ClockState.edit-am-pm;
                color: Theme.text-secondary;
                font-size: 22 * Theme.dp;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 6 * Theme.dp;
            for letter[i] in ["M", "T", "W", "T", "F", "S", "S"]: Chip {
                text: letter;
                on: ClockState.edit-days[i];
                toggled => {
                    ClockState.edit-day(i);
                }
            }
        }

        Text {
            text: ClockState.edit-repeat;
            color: Theme.text-dim;
            font-size: Theme.font-label;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            Button {
                text: "Label: " + ClockState.edit-label;
                primary: false;
                clicked => {
                    ClockState.edit-label-next();
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12 * Theme.dp;
            padding-top: 8 * Theme.dp;
            // Cancel and Save are the header's ✕ and ✓ (FormHeader in clock.slint)
            if !ClockState.edit-new: Button {
                text: "Delete";
                tint: Theme.danger;
                clicked => {
                    ClockState.delete-alarm();
                }
            }
        }
    }
}
