// SPDX-License-Identifier: GPL-3.0-only
// The Files app (NEOFILES.EXE) on the neoui kit (Shell v2): real drives and folders from Symbian's file server. The
// app draws its header (Header on the drives, SubHeader with ⋮ in a folder, the selection header while rows are
// picked) and forms ([✕ New folder ✓], [✕ Rename ✓]); the shell draws dialogs (QUERY) and toasts (NOTE).
// The Rust side owns the state; this file draws it and reports taps as callbacks.
import "@neoui/fonts/NeoSans-Regular.ttf";
import "@neoui/fonts/NeoSans-Medium.ttf";
import "@neoui/fonts/NeoSans-SemiBold.ttf";
import "@neoui/fonts/NeoSans-Bold.ttf";
// Latin, Cyrillic and Armenian: names and text typed on the system keyboard, in any of its languages
import "@neoui/fonts/DejaVuSans.ttf";
import "@neoui/fonts/DejaVuSansMono.ttf";
import {
    Theme, Kit, Scroll, Alphabets, Card, Glyph, NeoList, ListRow, Header, SubHeader, FormHeader, TextField, Act,
    EmptyState
} from "@neoui/kit.slint";

export { Theme, Scroll, Kit }

export struct DriveRow { label: string, detail: string, used: float, rom: bool }
export struct FileRow { name: string, detail: string, kind: string, checked: bool }

export component FilesApp inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;

    // "drives", "folder" or "text"
    in property <string> view: "drives";
    in property <[DriveRow]> drives;
    // the open folder or file: its full path, and its name (the header's title)
    in property <string> path;
    in property <string> name;
    in property <[FileRow]> rows;
    in property <string> text;
    // rows picked (selection mode, K03): how many
    in property <int> selected;
    // "" (none), "new" or "rename": a form page over the folder
    in property <string> form;
    in-out property <string> name-text;
    in property <bool> refreshing;
    // the system keyboard's height over the bottom of the surface, while a name is typed
    in property <length> kb-h;

    callback drive(int);
    callback open-row(int);
    callback toggle(int);
    callback up();
    callback new-folder();
    callback rename();
    callback delete();
    callback clear-selection();
    callback refresh();
    callback form-cancel();
    callback form-save();

    Alphabets { }

    VerticalLayout {
        if root.view == "drives": Header {
            title: "Files";
            search: false;
            top => {
                drives-list.to-top();
            }
        }
        if root.view == "folder": SubHeader {
            title: root.name;
            search: false;
            menu: ["New folder"];
            selected: root.selected;
            selection-actions: [
                { icon: @image-url("@neoui/icons/sys/edit.svg"), label: "Rename", disabled: root.selected != 1 },
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete" },
            ];
            back => {
                root.up();
            }
            menu-picked(i) => {
                root.new-folder();
            }
            selection-action(i) => {
                if i == 0 {
                    root.rename();
                } else {
                    root.delete();
                }
            }
            selection-closed => {
                root.clear-selection();
            }
            top => {
                folder-list.to-top();
            }
        }
        if root.view == "text": SubHeader {
            title: root.name;
            search: false;
            back => {
                root.up();
            }
        }

        if root.view != "drives": Text {
            x: Theme.card-pad;
            height: 30 * Theme.dp;
            text: root.path;
            font-family: "DejaVu Sans";
            color: Theme.text-dim;
            font-size: Theme.font-label;
            vertical-alignment: center;
            overflow: elide;
        }

        // the three views share the rest of the surface; the hidden ones stay (their ids are used above)
        Rectangle {
            vertical-stretch: 1;
        drives-list := NeoList {
            visible: root.view == "drives";
            VerticalLayout {
                alignment: start;
                padding: Theme.margin;
                spacing: 12 * Theme.dp;
                for d[i] in root.drives: Card {
                    height: 108 * Theme.dp;
                    VerticalLayout {
                        padding: Theme.card-pad;
                        spacing: 10 * Theme.dp;
                        HorizontalLayout {
                            spacing: 12 * Theme.dp;
                            Glyph {
                                source: d.rom ? @image-url("@neoui/icons/sys/lock.svg") : @image-url("@neoui/icons/sys/phone_storage.svg");
                                size: 28 * Theme.dp;
                                colorize: Theme.accent;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: d.label;
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                }

                                Text {
                                    text: d.detail;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-label;
                                }
                            }

                            Glyph {
                                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                                size: 18 * Theme.dp;
                                colorize: Theme.text-dim;
                            }
                        }

                        Rectangle {
                            height: 6 * Theme.dp;
                            border-radius: self.height / 2;
                            background: Theme.dialog-button;
                            Rectangle {
                                x: 0;
                                width: parent.width * d.used;
                                border-radius: parent.border-radius;
                                background: d.rom ? #e2a92a : Theme.accent;
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.drive(i);
                        }
                    }
                }
            }
        }

        // files come from outside (K03): pull to list the folder again
        folder-list := NeoList {
            visible: root.view == "folder";
            pull-refresh: true;
            refreshing: root.refreshing;
            selected: root.selected;
            refresh => {
                root.refresh();
            }
            VerticalLayout {
                alignment: start;
                if root.rows.length == 0: EmptyState {
                    icon: @image-url("@neoui/icons/sys/folder.svg");
                    title: "Empty folder";
                    action: "New folder";
                    acted => {
                        root.new-folder();
                    }
                }
                for f[i] in root.rows: ListRow {
                    title: f.name;
                    title-font: "DejaVu Sans";
                    subtitle: f.detail;
                    has-icon: true;
                    icon: f.kind == "folder" ? @image-url("@neoui/icons/sys/folder.svg") : f.kind == "image" ? @image-url("@neoui/icons/sys/image.svg") : f.kind == "text" ? @image-url("@neoui/icons/sys/doc.svg") : @image-url("@neoui/icons/sys/file.svg");
                    icon-tint: f.kind == "folder" ? #e2a92a : f.kind == "image" ? #14a37f : f.kind == "text" ? #e04e9b : Theme.text-secondary;
                    chevron: f.kind == "folder" && root.selected == 0;
                    selecting: root.selected > 0;
                    checked: f.checked;
                    long-pressed => {
                        root.toggle(i);
                    }
                    clicked => {
                        if root.selected > 0 {
                            root.toggle(i);
                        } else {
                            root.open-row(i);
                        }
                    }
                }
            }
        }

        NeoList {
            visible: root.view == "text";
            VerticalLayout {
                alignment: start;
                padding: Theme.margin;
                Text {
                    text: root.text;
                    wrap: char-wrap;
                    font-family: "DejaVu Sans Mono";
                    font-size: 13.5 * Theme.dp;
                    color: #d7dde5;
                }
            }
        }
        }
    }

    // a form page over the folder: [✕ New folder ✓] or [✕ Rename ✓] and the name field (the keyboard comes up)
    if root.form != "": Rectangle {
        background: Theme.bg;
        TouchArea { }

        VerticalLayout {
            alignment: start;
            FormHeader {
                title: root.form == "new" ? "New folder" : "Rename";
                can-save: root.name-text != "";
                cancel => {
                    root.form-cancel();
                }
                save => {
                    root.form-save();
                }
            }

            VerticalLayout {
                padding: Theme.card-pad;
                TextField {
                    text <=> root.name-text;
                    placeholder: "Name";
                    autofocus: true;
                    accepted(t) => {
                        root.form-save();
                    }
                }
            }
        }
    }
}
