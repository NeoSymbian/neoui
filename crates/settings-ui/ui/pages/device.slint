// SPDX-License-Identifier: GPL-3.0-only
// Device: Display (set2-display, set2-timeout's choice sheet), Home & navigation (set2-navigation, the three modes),
// Sounds & profiles (set2-sounds, set2-profile: profiles SE2a; media, the test sound and record-and-play-back) and Battery
// (set2-battery: the HAL's reading and the shell's 24-hour history).
import { Theme, NeoList, SectionHeader, ListRow, Slider, Button, Sheet, TextField } from "@neoui/kit.slint";
import { ChoiceRow, Note, Pair, ModeCard, ActiveCard } from "../parts.slint";
import { SetState, ProfileRow } from "../state.slint";

export component DisplayPage inherits NeoList {
    // the slider has no callback: a move changes `brightness`, stored as 0..255
    property <float> brightness: SetState.brightness;
    changed brightness => {
        SetState.act("display.brightness", round(self.brightness * 255));
    }
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Brightness"; }
        HorizontalLayout {
            padding-left: Theme.margin + 4 * Theme.dp;
            padding-right: Theme.margin + 4 * Theme.dp;
            spacing: 12 * Theme.dp;
            height: 56 * Theme.dp;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 18 * Theme.dp;
                    height: self.width;
                    source: @image-url("@neoui/icons/sys/brightness.svg");
                    colorize: Theme.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;
                Slider {
                    label: "Brightness";
                    value <=> SetState.brightness;
                }
            }
            VerticalLayout {
                alignment: center;
                Image {
                    width: 22 * Theme.dp;
                    height: self.width;
                    source: @image-url("@neoui/icons/sys/brightness.svg");
                    colorize: Theme.text-secondary;
                }
            }
        }

        SectionHeader { text: "Appearance"; }
        ListRow {
            value-bright: true;
            title: "Dark theme";
            checked: SetState.found == "display.dark";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/theme.svg");
            has-switch: true;
            switch-on <=> SetState.dark;
            switch-toggled(v) => { SetState.act("display.dark", v ? "1" : "0"); }
        }

        // D7: the text size's page
        ListRow {
            value-bright: true;
            title: "Font size";
            checked: SetState.found == "display.font_size";
            value: SetState.font-sizes.length > SetState.font-size ? SetState.font-sizes[SetState.font-size] : "";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/text_size.svg");
            chevron: true;
            clicked => { SetState.act("open", "26"); }
        }

        ListRow {

            value-bright: true;
            title: "Screen timeout";
            checked: SetState.found == "display.timeout";
            value: SetState.timeout-text;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/stopwatch.svg");
            chevron: true;
            clicked => { SetState.sheet = "timeout"; }
        }

        // D7: home's wallpaper (the colours' page)
        ListRow {
            value-bright: true;
            title: "Wallpaper";
            checked: SetState.found == "display.wallpaper";
            value: SetState.wallpaper-name;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/image.svg");
            chevron: true;
            divider: false;
            clicked => { SetState.act("open", "25"); }
        }
    }
}

export component NavigationPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Navigation"; }
        VerticalLayout {
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            padding-bottom: 4 * Theme.dp;
            spacing: 8 * Theme.dp;
            // Gestures (1) is the default (D12)
            for name[i] in SetState.nav-modes: ModeCard {
                mode: i;
                title: name;
                subtitle: SetState.nav-hints[i];
                on: i == SetState.nav-mode;
                is-default: i == 1;
                found: SetState.found == "nav." + i;
                clicked => { SetState.act("nav.mode", i); }
            }
        }
        Note { text: "The top edge opens the shade in every mode. Switching may resize open apps once."; }
    }
}

export component SoundsPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        // the active profile (set2-sounds' card): ✎ opens its page
        SectionHeader { text: "Active"; }
        HorizontalLayout {
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            padding-top: 4 * Theme.dp;
            padding-bottom: 6 * Theme.dp;
            ActiveCard {
                name: SetState.active-profile-name;
                summary: SetState.active-profile-summary;
                edit => {
                    SetState.act("profile-open", SetState.active-profile);
                }
            }
        }

        // the profiles (S05): a row's sheet activates it or opens its page; the active one has ✓
        SectionHeader { text: "Profiles"; }
        for p in SetState.profiles: ListRow {
            value-bright: true;
            title: p.name;
            checked: SetState.found == "sounds.p" + p.id;
            subtitle: p.summary;
            has-icon: true;
            icon: p.id == 1 ? @image-url("@neoui/icons/sys/silent.svg")
                : p.id == 2 ? @image-url("@neoui/icons/sys/bell.svg")
                : p.id == 3 ? @image-url("@neoui/icons/sys/speaker.svg")
                : p.id == 4 ? @image-url("@neoui/icons/sys/plane.svg")
                : @image-url("@neoui/icons/sys/volume.svg");
            icon-tint: p.id == SetState.active-profile ? Theme.accent : Theme.text-secondary;
            trailing-check: p.id == SetState.active-profile;
            check-label: "Active";
            clicked => {
                SetState.profile-current = p;
                SetState.sheet = "profile";
            }
        }
        ListRow {
            title: "Add profile";
            title-accent: true;
            checked: SetState.found == "sounds.add";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/add.svg");
            icon-tint: Theme.accent;
            divider: false;
            clicked => {
                SetState.new-name = "";
                SetState.sheet = "profile-add";
            }
        }

        if SetState.phone-feedback != "": Note { text: SetState.phone-feedback; }
        Note { text: "The shade's Silent tile and the power menu switch profiles too."; }

        SectionHeader { text: "Media"; }
        ListRow {
            value-bright: true;
            title: "Media volume";
            checked: SetState.found == "sounds.media";
            value: SetState.media-volume;
            subtitle: "Apps, games and the volume keys outside a call";
            divider: false;
        }

        Pair {
            Button {
                text: "Quieter";
                primary: false;
                clicked => { SetState.act("sound.media_volume", max(0, SetState.media-volume - 1)); }
            }

            Button {
                text: "Louder";
                primary: false;
                clicked => { SetState.act("sound.media_volume", min(10, SetState.media-volume + 1)); }
            }
        }

        ListRow {

            value-bright: true;
            title: "Play media on";
            checked: SetState.found == "sounds.route";
            value: SetState.media-routes.length > SetState.media-route ? SetState.media-routes[SetState.media-route] : "";
            clicked => { SetState.act("sound.media_route", Math.mod(SetState.media-route + 1, 3)); }
        }

        ListRow {

            value-bright: true;
            title: "Microphone";
            checked: SetState.found == "sounds.mic";
            value: SetState.mics.length > SetState.mic ? SetState.mics[SetState.mic] : "";
            subtitle: "For recordings (calls use the main one)";
            divider: false;
            clicked => { SetState.act("sound.mic", 1 - SetState.mic); }
        }

        Pair {
            Button {
                text: "Test sound";
                clicked => { SetState.act("sound", "test"); }
            }

            Button {
                text: "Record and play back";
                clicked => { SetState.act("sound", "record"); }
            }
        }

        if SetState.sound-feedback != "": Note { text: SetState.sound-feedback; }
    }
}

export component BatteryPage inherits NeoList {
    VerticalLayout {
    alignment: start;
    VerticalLayout {
        alignment: start;
        spacing: 14 * Theme.dp;
        padding: Theme.margin;
        Text {
            text: SetState.battery-text;
            font-size: Theme.font-title * 2;
            font-weight: 700;
            color: Theme.text;
        }

        Text {
            text: SetState.battery-state + " · USB " + SetState.battery-usb;
            font-size: Theme.font-body;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        Text {
            text: "Battery voltage: " + SetState.battery-voltage;
            font-size: Theme.font-label;
            color: Theme.text;
        }

        Text {
            text: "Reported by the PMIC · battery profile unverified";
            font-size: Theme.font-status;
            color: Theme.text-dim;
            wrap: word-wrap;
        }

        SectionHeader { text: "Battery level · last 24 hours"; }
        chart := Rectangle {
            height: 180 * Theme.dp;
            background: #151719;
            border-radius: 8 * Theme.dp;
            for value[i] in SetState.battery-history: Rectangle {
                x: i / 1440 * chart.width;
                width: chart.width / 1440;
                height: value < 0 ? 0px : max(1px, value * (chart.height - 20 * Theme.dp));
                y: chart.height - self.height;
                background: #22b46a;
            }
        }

        HorizontalLayout {
            Text {
                text: "24 hours ago";
                font-size: Theme.font-status;
                color: Theme.text-dim;
            }

            Text {
                text: "Now";
                horizontal-stretch: 1;
                horizontal-alignment: right;
                font-size: Theme.font-status;
                color: Theme.text-dim;
            }
        }

        Text {
            text: "0–100% · one sample per minute. Gaps mean no reading; history begins with real observations.";
            font-size: Theme.font-status;
            color: Theme.text-dim;
            wrap: word-wrap;
        }

        Text {
            text: SetState.battery-storage;
            font-size: Theme.font-status;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
    }

    // SE3a: the saver (by hand only), the status bar's percent, and Battery usage
    SectionHeader { text: "Saving"; }
    ListRow {
        value-bright: true;
        title: "Battery saver";
        checked: SetState.found == "battery.saver";
        subtitle: "Dims the screen";
        has-icon: true;
        icon: @image-url("@neoui/icons/sys/battery_saver.svg");
        has-switch: true;
        switch-on <=> SetState.battery-saver;
        switch-toggled(v) => { SetState.act("battery.saver", v ? "1" : "0"); }
    }

    ListRow {

        value-bright: true;
        title: "Show percentage";
        checked: SetState.found == "battery.percent";
        subtitle: "In the status bar";
        has-switch: true;
        switch-on <=> SetState.show-percent;
        switch-toggled(v) => { SetState.act("battery.show_percent", v ? "1" : "0"); }
    }

    ListRow {

        value-bright: true;
        title: "Battery usage";
        checked: SetState.found == "battery.usage";
        subtitle: SetState.screen-on != "" ? "Screen-on time: " + SetState.screen-on : "Level and time on battery";
        chevron: true;
        divider: false;
        clicked => { SetState.act("open", "19"); }
    }
    }
}

// Battery usage (set2-battery-usage): the charge cycle (D5, the shell's INFO 9; SE3a's INFO 5 history on an older
// shell) in the board's card, then its screen-on time. No per-app shares: they need D16's calibrated energy model.
export component BatteryUsagePage inherits NeoList {
    VerticalLayout {
        alignment: start;
        VerticalLayout {
            padding-left: 12 * Theme.dp;
            padding-right: 12 * Theme.dp;
            padding-top: 12 * Theme.dp;
            Rectangle {
                border-radius: 14 * Theme.dp;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.card-border;
                VerticalLayout {
                    padding-left: 14 * Theme.dp;
                    padding-right: 14 * Theme.dp;
                    padding-top: 12 * Theme.dp;
                    padding-bottom: 12 * Theme.dp;
                    spacing: 4 * Theme.dp;
                    Text {
                        text: SetState.usage-known ? SetState.usage-title : "Battery usage";
                        font-size: Theme.font-status;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if SetState.usage-known: HorizontalLayout {
                        alignment: start;
                        spacing: 4 * Theme.dp;
                        for t in [SetState.usage-from, "→", SetState.usage-to]: Text {
                            text: t;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: bottom;
                        }
                        Text {
                            text: "· " + SetState.usage-span;
                            font-size: 15 * Theme.dp;
                            color: Theme.text-secondary;
                            vertical-alignment: bottom;
                        }
                    }
                    if SetState.usage-known: Text {
                        text: SetState.usage-on-battery;
                        font-size: Theme.font-status;
                        color: Theme.text-dim;
                    }
                    if SetState.usage-known && SetState.usage-gaps != "": Text {
                        text: SetState.usage-gaps;
                        font-size: Theme.font-status;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if !SetState.usage-known: Text {
                        text: "No data yet. The record starts with the first readings after the phone starts.";
                        font-size: Theme.font-status;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { height: 8 * Theme.dp; }
        ListRow {
            title: "Screen-on time";
            checked: SetState.found == "battery.screen_on";
            subtitle: SetState.screen-on != "" ? SetState.screen-on : "Not recorded yet";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/brightness.svg");
            icon-tint: #ffffff;
            tile: #e2a92a;
            divider: false;
        }

        SectionHeader { text: "By app"; }
        Note { text: "Not yet (D16): shares per app need a calibrated energy model."; }
    }
}

// A profile (set2-profile): its ring, ringtone, volume, vibration and message tone (Offline sounds like General);
// added ones can be renamed and deleted. A tone picked in its sheet plays once (set2-ringtone, SE2b).
export component ProfilePage inherits NeoList {
    property <ProfileRow> p: SetState.profile-current;
    property <bool> offline: p.id == 4;
    property <bool> added: p.id >= 5;
    VerticalLayout {
        alignment: start;
        if p.id != SetState.active-profile: HorizontalLayout {
            padding: Theme.margin;
            Button {
                text: "Use " + p.name;
                clicked => { SetState.act("profile-choose", p.id); }
            }
        }
        if offline: Note { text: "Offline turns the mobile network, Wi-Fi and Bluetooth off, and sounds like General. Leaving it turns them back on."; }
        if !offline: SectionHeader { text: "Calls"; }
        if !offline && p.ring: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/tone.svg");
            icon-tint: Theme.text-secondary;
            title: "Ringtone";
            checked: SetState.found == "profile.tone";
            value: p.tone-name;
            chevron: true;
            clicked => { SetState.act("open", "23"); }
        }
        if !offline && p.ring && p.ringtone == 3: Note { text: "Calls vibrate only, so Vibrate stays on."; }
        if !offline: Note { text: "A tone you pick plays once, at the media volume; calls ring at the ring volume."; }
        // Silent never rings (muting chooses it)
        if !offline && p.id != 1: ListRow {
            value-bright: true;
            title: "Ring";
            checked: SetState.found == "profile.ring";
            subtitle: p.ring ? "The ringtone sounds" : "Silent: no ringing";
            has-switch: true;
            switch-on: p.ring;
            switch-toggled(v) => { SetState.act("profile-set", (v ? "1" : "0") + "," + p.volume + "," + (p.vibrate ? "1" : "0")); }
        }
        if !offline && p.ring: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/volume.svg");
            icon-tint: Theme.text-secondary;
            title: "Ring volume";
            checked: SetState.found == "profile.volume";
            value: p.volume;
            subtitle: "0 to 10";
            divider: false;
        }
        // the volume as a slider too (set2-profile): a step of it sets the ring volume
        if !offline && p.ring: HorizontalLayout {
            padding-left: Theme.margin + 4 * Theme.dp;
            padding-right: Theme.margin + 4 * Theme.dp;
            spacing: 12 * Theme.dp;
            height: 44 * Theme.dp;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 20 * Theme.dp;
                    height: self.width;
                    source: @image-url("@neoui/icons/sys/silent.svg");
                    colorize: Theme.text-dim;
                }
            }
            VerticalLayout {
                alignment: center;
                Slider {
                    controlled: true;
                    step: 0.1;
                    label: "Ring volume";
                    value: p.volume / 10;
                    moved(v) => {
                        if round(v * 10) != p.volume {
                            SetState.act("profile-set", "1," + round(v * 10) + "," + (p.vibrate ? "1" : "0"));
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Image {
                    width: 20 * Theme.dp;
                    height: self.width;
                    source: @image-url("@neoui/icons/sys/volume.svg");
                    colorize: Theme.text-dim;
                }
            }
        }
        if !offline && p.ring: Pair {
            Button {
                text: "Quieter";
                primary: false;
                clicked => { SetState.act("profile-set", "1," + max(0, p.volume - 1) + "," + (p.vibrate ? "1" : "0")); }
            }

            Button {
                text: "Louder";
                primary: false;
                clicked => { SetState.act("profile-set", "1," + min(10, p.volume + 1) + "," + (p.vibrate ? "1" : "0")); }
            }
        }
        if !offline: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/vibrate.svg");
            icon-tint: Theme.text-secondary;
            title: "Vibrate";
            checked: SetState.found == "profile.vibrate";
            has-switch: true;
            switch-on: p.vibrate;
            switch-toggled(v) => { SetState.act("profile-set", (p.ring ? "1" : "0") + "," + p.volume + "," + (v ? "1" : "0")); }
        }
        if !offline: SectionHeader { text: "Messages & touch"; }
        // D6: what a new message really does (MODEMD's buzzes and the tone's first 0.8 s); the sheet picks the tone
        if !offline: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/message.svg");
            icon-tint: Theme.text-secondary;
            title: "Message tone";
            checked: SetState.found == "profile.message";
            subtitle: SetState.message-summary;
            chevron: true;
            clicked => { SetState.sheet = "message-tone"; }
        }
        // D6: dial keys sound out of a call (in-call DTMF doesn't depend on it); a pulse per control a touch works
        if !offline: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/keypad.svg");
            icon-tint: Theme.text-secondary;
            title: "Keypad tones";
            checked: SetState.found == "profile.keypad";
            has-switch: true;
            switch-on: p.keypad;
            switch-toggled(v) => { SetState.act("profile-feedback", (v ? "1" : "0") + "," + (p.touch ? "1" : "0")); }
        }
        if !offline: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/vibrate.svg");
            icon-tint: Theme.text-secondary;
            title: "Vibrate on touch";
            checked: SetState.found == "profile.touch";
            has-switch: true;
            switch-on: p.touch;
            divider: false;
            switch-toggled(v) => { SetState.act("profile-feedback", (p.keypad ? "1" : "0") + "," + (v ? "1" : "0")); }
        }
        if added: HorizontalLayout {
            padding: Theme.margin;
            spacing: 12 * Theme.dp;
            Button {
                text: "Rename";
                primary: false;
                clicked => {
                    SetState.new-name = p.name;
                    SetState.sheet = "profile-rename";
                }
            }

            Button {
                text: "Delete";
                primary: false;
                clicked => { SetState.act("profile-delete", ""); }
            }
        }
    }
}

// A profile's sheet from the list: Activate, or its page.
export component ProfileSheet inherits Sheet {
    title-start: true;
    title: SetState.profile-current.name;
    VerticalLayout {
        padding-left: 20 * Theme.dp;
        padding-right: 20 * Theme.dp;
        spacing: 14 * Theme.dp;
        Text {
            text: SetState.profile-current.summary;
            font-size: Theme.font-label;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        if SetState.profile-current.id != SetState.active-profile: Button {
            text: "Activate";
            clicked => {
                SetState.act("profile-choose", SetState.profile-current.id);
                root.close();
            }
        }
        Button {
            text: "Change";
            primary: SetState.profile-current.id == SetState.active-profile;
            clicked => {
                SetState.act("open", "18");
                root.close();
            }
        }

        Button {
            text: "Cancel";
            primary: false;
            clicked => { root.close(); }
        }
    }
}

// Add profile / Rename: the name (at most 24 bytes).
export component ProfileNameSheet inherits Sheet {
    title-start: true;
    in property <length> kb;
    in property <bool> rename;
    title: rename ? "Rename profile" : "Add profile";
    VerticalLayout {
        padding-left: 20 * Theme.dp;
        padding-right: 20 * Theme.dp;
        spacing: 14 * Theme.dp;
        TextField {
            placeholder: "Name";
            autofocus: true;
            text <=> SetState.new-name;
        }

        HorizontalLayout {
            spacing: 12 * Theme.dp;
            Button {
                text: "Cancel";
                primary: false;
                clicked => { root.close(); }
            }

            Button {
                text: rename ? "Rename" : "Add";
                enabled: SetState.new-name != "";
                clicked => {
                    SetState.act(rename ? "profile-rename" : "profile-add", SetState.new-name);
                    root.close();
                }
            }
        }

        if root.kb > 0: Rectangle {
            height: root.kb;
        }
    }
}

// A ringtone's row (set2-ringtone): its radio, name and line, and ▶ (⏸ while it plays). A tap chooses it, ▶ only
// plays it; a long press asks for the sound's sheet (the user's sounds: Rename, Delete).
component ToneRow inherits Rectangle {
    in property <string> name;
    in property <string> line;
    in property <bool> chosen;
    in property <bool> playable: true;
    in property <bool> playing;
    in property <bool> paused;
    callback choose;
    callback play;
    callback pause;
    callback long-pressed;
    property <bool> long-fired;
    height: Theme.list-row-h + 8 * Theme.dp;
    background: t.pressed ? Theme.pressed : transparent;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-label: root.name;
    accessible-action-default => { root.choose(); }
    t := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.long-fired = false;
            }
        }
        clicked => {
            if !root.long-fired {
                root.choose();
            }
        }
    }

    Timer {
        interval: 500ms;
        running: t.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.long-pressed();
        }
    }

    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin;
        spacing: 16 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2 * Theme.dp;
                border-color: root.chosen ? Theme.accent : Theme.text-dim;
                if root.chosen: Rectangle {
                    width: 10 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }
            }
        }

        // D6: the tone that plays says how far ("Playing · 0:01"); None says what it does
        VerticalLayout {
            alignment: center;
            spacing: 2 * Theme.dp;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 500;
                overflow: elide;
            }

            if root.line != "": Text {
                text: root.line;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        if root.playable: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: play.pressed ? Theme.pressed : root.playing ? Theme.accent : #2a2e35;
                accessible-role: button;
                accessible-label: (root.playing && !root.paused ? "Pause " : "Play ") + root.name;
                accessible-action-default => {
                    if root.playing {
                        root.pause();
                    } else {
                        root.play();
                    }
                }
                Image {
                    width: 18 * Theme.dp;
                    height: self.width;
                    source: root.playing && !root.paused ? @image-url("@neoui/icons/sys/pause.svg") : @image-url("@neoui/icons/sys/play.svg");
                    colorize: white;
                }
                play := TouchArea {
                    clicked => {
                        if root.playing {
                            root.pause();
                        } else {
                            root.play();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: Theme.margin + 4 * Theme.dp + 22 * Theme.dp + 16 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
}

// A profile's ringtone (set2-ringtone): the built-in tones and the user's own sounds (SE2c-1), the chosen one's radio
// on; a tap chooses it (and plays it once), ▶ only plays it, ⏸ pauses it. Leaving the page stops a preview.
export component RingtonePage inherits NeoList {
    property <ProfileRow> p: SetState.profile-current;
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Built in"; }
        for name[i] in SetState.ring-tones: ToneRow {
            name: name;
            line: i == SetState.preview-tone ? SetState.preview-text : i == SetState.ring-tones.length - 1 ? "Vibrate only" : "";
            chosen: i == p.ringtone;
            // the last tone is silence (vibrate only): nothing to play
            playable: i < SetState.ring-tones.length - 1;
            playing: i == SetState.preview-tone;
            paused: SetState.preview-paused;
            choose => { SetState.act("profile-tone", "r," + i); }
            play => { SetState.act("tone-preview", i); }
            pause => { SetState.act("tone-pause", ""); }
        }
        SectionHeader { text: "Your sounds"; }
        for t in SetState.your-tones: ToneRow {
            name: t.name;
            line: t.id == SetState.preview-tone ? SetState.preview-text : "";
            chosen: t.id == p.ringtone;
            playing: t.id == SetState.preview-tone;
            paused: SetState.preview-paused;
            choose => { SetState.act("profile-tone", "r," + t.id); }
            play => { SetState.act("tone-preview", t.id); }
            pause => { SetState.act("tone-pause", ""); }
            long-pressed => {
                SetState.your-current = t;
                SetState.sheet = "your-tone";
            }
        }
        if !SetState.your-tones-full: ListRow {
            value-bright: true;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/folder.svg");
            icon-tint: Theme.accent;
            title: "Add from Files";
            subtitle: "WAV from C: or E:";
            chevron: true;
            divider: false;
            clicked => { SetState.act("tone-add", ""); }
        }
        if SetState.import-note != "": Note { text: SetState.import-note; }
        Note { text: "▶ plays a tone at the profile's ring volume (the media volume applies too); leaving the page stops it. A tap chooses it; hold one of your sounds to rename or delete it. Your sounds ring for 2 s, then again."; }
    }
}

// One of the user's sounds (a long press on Ringtone): Rename, or Delete (the profiles using it go back to the
// built-in ringtone).
export component YourToneSheet inherits Sheet {
    title-start: true;
    in property <length> kb;
    property <bool> renaming;
    title: SetState.your-current.name;
    VerticalLayout {
        padding-left: 20 * Theme.dp;
        padding-right: 20 * Theme.dp;
        spacing: 14 * Theme.dp;
        if renaming: TextField {
            placeholder: "Name";
            autofocus: true;
            text <=> SetState.new-name;
        }
        if !renaming: Text {
            text: "Deleting it puts the profiles that use it back on the built-in ringtone.";
            font-size: Theme.font-label;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 12 * Theme.dp;
            Button {
                text: "Cancel";
                primary: false;
                clicked => { root.close(); }
            }

            if !renaming: Button {
                text: "Rename";
                primary: false;
                clicked => {
                    SetState.new-name = SetState.your-current.name;
                    root.renaming = true;
                }
            }
            if !renaming: Button {
                text: "Delete";
                clicked => {
                    SetState.act("tone-delete", "");
                    root.close();
                }
            }
            if renaming: Button {
                text: "Rename";
                enabled: SetState.new-name != "";
                clicked => {
                    SetState.act("tone-rename", SetState.new-name);
                    root.close();
                }
            }
        }

        if root.kb > 0: Rectangle {
            height: root.kb;
        }
    }
}
