// SPDX-License-Identifier: GPL-3.0-only
// About phone → Licences (set2-about's row): which licence covers which part, by SPDX id. The texts are at the
// URLs (spdx.org), not in the ROM. Not searchable rows (settings_app::rows leaves this page out).
import { Theme, NeoList, SectionHeader, ListRow } from "@neoui/kit.slint";
import { Note } from "../parts.slint";

export component LicencesPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Software"; }
        ListRow {
            value-bright: true;
            title: "NeoSymbian";
            subtitle: "Apache-2.0 · the kernel port, the Rust crates and tools; GPL-3.0-only where they link Slint";
        }

        ListRow {

            value-bright: true;
            title: "Symbian^3 (2010)";
            subtitle: "EPL-1.0; files NeoSymbian changed: EPL-2.0 · the kernel and user side";
        }

        ListRow {

            value-bright: true;
            title: "Slint";
            subtitle: "GPL-3.0-only · the UI toolkit, and the UI server and apps that link it";
        }

        SectionHeader { text: "Fonts"; }
        ListRow {
            value-bright: true;
            title: "NeoSans";
            subtitle: "OFL-1.1 · Inter and Noto Sans Armenian, merged";
        }

        ListRow {

            value-bright: true;
            title: "DejaVu Sans";
            subtitle: "Bitstream-Vera";
        }

        ListRow {

            value-bright: true;
            title: "Ubuntu Mono";
            subtitle: "Ubuntu-font-1.0 · the terminal";
            divider: false;
        }

        Note { text: "Each licence's text: spdx.org/licenses/<id>.html (Ubuntu Font Licence: ubuntu.com/legal/font-licence)."; }
    }
}
