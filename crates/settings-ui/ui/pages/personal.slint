// SPDX-License-Identifier: GPL-3.0-only
// Personal: Date & time (set2-datetime; the city sheet of set2-timezone, the format sheet of set2-dateformat),
// Language & keyboard (set2-language; the display language is English only, D7) and Privacy (set2-privacy: Clear
// clipboard, the clipboard toast and the local log, D8; app permissions come later).
import { Theme, NeoList, SectionHeader, ListRow, Sheet, TextField, SearchField } from "@neoui/kit.slint";
import { Note } from "../parts.slint";
import { SetState, ZoneRow } from "../state.slint";

export component DateTimePage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Network time"; }
        ListRow {
            value-bright: true;
            title: "Automatic time";
            checked: SetState.found == "time.auto";
            subtitle: "Last set: " + SetState.synced;
            has-switch: true;
            switch-on <=> SetState.time-auto;
            switch-toggled(v) => { SetState.act("time.auto", v ? "1" : "0"); }
        }

        ListRow {

            value-bright: true;
            title: "Automatic time zone";
            checked: SetState.found == "time.auto_zone";
            subtitle: "From the mobile network";
            has-switch: true;
            switch-on <=> SetState.time-auto-zone;
            switch-toggled(v) => { SetState.act("time.auto_zone", v ? "1" : "0"); }
        }

        ListRow {

            value-bright: true;
            title: "Time zone";
            checked: SetState.found == "time.zone";
            subtitle: SetState.zone;
            value: SetState.time-auto-zone ? "Network" : "";
            chevron: !SetState.time-auto-zone;
            divider: false;
            clicked => {
                if !SetState.time-auto-zone {
                    SetState.city-query = "";
                    SetState.act("city-query", "");
                    SetState.act("open", "24");
                }
            }
        }

        SectionHeader { text: "Format"; }
        ListRow {
            value-bright: true;
            title: "24-hour time";
            checked: SetState.found == "time.24h";
            has-switch: true;
            switch-on <=> SetState.clock-24h;
            switch-toggled(v) => { SetState.act("clock.24h", v ? "1" : "0"); }
        }

        ListRow {

            value-bright: true;
            title: "Seconds in the status bar";
            checked: SetState.found == "time.seconds";
            subtitle: "Uses more battery";
            has-switch: true;
            switch-on <=> SetState.status-seconds;
            switch-toggled(v) => { SetState.act("status.seconds", v ? "1" : "0"); }
        }

        ListRow {

            value-bright: true;
            title: "Date in the shade";
            checked: SetState.found == "time.shade_date";
            has-switch: true;
            switch-on <=> SetState.shade-date;
            switch-toggled(v) => { SetState.act("shade.date", v ? "1" : "0"); }
        }

        ListRow {

            value-bright: true;
            title: "Date format";
            checked: SetState.found == "time.format";
            value: SetState.date-text;
            chevron: true;
            divider: false;
            clicked => { SetState.sheet = "date-format"; }
        }
    }
}

// Time zone (set2-timezone): search the cities, a tap picks one (its summer-time rule comes with it); the phone's
// city is marked.
export component TimeZonePage inherits Rectangle {
    // the shell's keyboard over the surface's bottom: the list ends above it
    in property <length> kb;
    property <string> query: SetState.city-query;
    changed query => {
        SetState.act("city-query", self.query);
    }
    VerticalLayout {
        alignment: start;
        HorizontalLayout {
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            padding-top: 8 * Theme.dp;
            SearchField {
                placeholder: "Search cities";
                text <=> SetState.city-query;
            }
        }

        HorizontalLayout {
            padding-left: Theme.margin + 4 * Theme.dp;
            padding-right: Theme.margin + 4 * Theme.dp;
            padding-top: 6 * Theme.dp;
            padding-bottom: 4 * Theme.dp;
            Text {
                text: "Automatic time zone is off. A city brings its rule, summer time too.";
                color: Theme.text-secondary;
                font-size: Theme.font-status;
                wrap: word-wrap;
            }
        }

        NeoList {
            height: root.height - 104 * Theme.dp - root.kb;
            VerticalLayout {
                alignment: start;
                for city[i] in SetState.cities: Rectangle {
                    height: Theme.list-row-h;
                    background: t.pressed ? Theme.pressed : city.current ? Theme.selected : transparent;
                    accessible-role: button;
                    accessible-label: city.name + ", " + city.offset;
                    accessible-description: city.current ? "Current" : "";
                    accessible-action-default => {
                        SetState.act("zone-pick", i);
                        SetState.act("back", "");
                    }
                    t := TouchArea {
                        clicked => {
                            SetState.act("zone-pick", i);
                            SetState.act("back", "");
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.margin + 4 * Theme.dp;
                        padding-right: Theme.margin + 4 * Theme.dp;
                        spacing: 12 * Theme.dp;
                        Text {
                            text: city.name;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: city.offset;
                            color: Theme.text-secondary;
                            font-size: Theme.font-value;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            width: 22 * Theme.dp;
                            if city.current: Image {
                                width: 20 * Theme.dp;
                                height: self.width;
                                source: @image-url("@neoui/icons/sys/check.svg");
                                colorize: Theme.accent;
                            }
                        }
                    }

                    Rectangle {
                        x: Theme.margin + 4 * Theme.dp;
                        y: parent.height - self.height;
                        width: parent.width - self.x;
                        height: max(1px, Theme.dp / 2);
                        background: Theme.hairline;
                    }
                }
                if SetState.cities.length == 0: Note { text: "No city by that name."; }
            }
        }
    }
}

export component KeyboardPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Keyboards"; }
        for name[i] in SetState.keyboard-names: ListRow {
            value-bright: true;
            title: name;
            subtitle: SetState.keyboard-hints[i];
            has-switch: true;
            switch-on: SetState.keyboards[i];
            checked: SetState.found == "kb." + i;
            // the app keeps the last language on (it reloads the switch when it refuses)
            switch-toggled(on) => { SetState.act("keyboard", (on ? "+" : "-") + i); }
        }

        SectionHeader { text: "Typing"; }
        ListRow {
            value-bright: true;
            title: "Current language";
            checked: SetState.found == "kb.current";
            value: SetState.keyboard-names.length > SetState.keyboard ? SetState.keyboard-names[SetState.keyboard] : "";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/language.svg");
            clicked => { SetState.act("keyboard-next", ""); }
        }

        ListRow {

            value-bright: true;
            title: "Same height for all languages";
            checked: SetState.found == "kb.same_height";
            subtitle: "Shorter ones get a row of digits";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/keypad.svg");
            has-switch: true;
            switch-on <=> SetState.same-height;
            switch-toggled(v) => { SetState.act("keyboard.same_height", v ? "1" : "0"); }
        }

        ListRow {

            value-bright: true;
            title: "Keypress vibration";
            checked: SetState.found == "kb.vibrate";
            subtitle: "A short pulse on each key";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/vibrate.svg");
            has-switch: true;
            switch-on <=> SetState.key-vibrate;
            switch-toggled(v) => { SetState.act("keyboard.vibrate", v ? "1" : "0"); }
            divider: false;
        }

        // D7: the menus' language, apart from the keyboards; English only until translations ship (no picker yet)
        SectionHeader { text: "Language"; }
        ListRow {
            value-bright: true;
            title: "Display language";
            checked: SetState.found == "kb.display_language";
            subtitle: "English · more languages later";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/world.svg");
            divider: false;
        }
    }
}

export component PrivacyPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Clipboard"; }
        ListRow {
            value-bright: true;
            title: "Clear clipboard";
            checked: SetState.found == "privacy.clip";
            subtitle: "Holds up to 2048 B";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/copy.svg");
            clicked => { SetState.act("clip-clear", ""); }
        }

        // D8: the shell's toast after an app reads it (privacy.clip_notice)
        ListRow {
            value-bright: true;
            title: "Show when an app reads it";
            checked: SetState.found == "privacy.clip_notice";
            subtitle: "Toast on CLIP_GET";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/bell.svg");
            has-switch: true;
            switch-on <=> SetState.clip-notice;
            switch-toggled(v) => { SetState.act("privacy.clip_notice", v ? "1" : "0"); }
            divider: false;
        }

        // D8: what the phone logs stays on it: Dev tools' console shows it, and saves it only when asked
        SectionHeader { text: "Diagnostics"; }
        ListRow {
            value-bright: true;
            title: "Usage & diagnostics";
            checked: SetState.found == "privacy.diagnostics";
            subtitle: "Nothing is sent";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/chart.svg");
            chevron: true;
            divider: false;
            clicked => { SetState.act("devtools", "console"); }
        }

        Note { text: "Apps in the ROM get every capability; apps on C: only those they declare. A list by app comes later. No automatic diagnostics upload: Dev tools shows the log and saves it only when you ask."; }
    }
}
