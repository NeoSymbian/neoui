// Apps (set2-apps: every ROM and old app, SE1d), Old apps' key pads (pad-settings*:
// every choice LEGACY reads, the B button too), Developer options (set2-developer) and About phone (set2-about).
import { Theme, NeoList, SectionHeader, ListRow, Card, Sheet, Button } from "@neoui/kit.slint";
import { Note } from "../parts.slint";
import { SetState } from "../state.slint";

// Apps (set2-apps, SE1d): every ROM app and every old app, each opening a sheet (Open, its own settings). Data sizes
// wait for Storage (SE3, D4).
export component AppsPage inherits NeoList {
    // an app's icon by its screen key, from the one-colour system set the rows tint (old apps share one)
    pure function app-icon(key: string, old: bool) -> image {
        if old { return @image-url("@neoui/icons/sys/keypad.svg"); }
        if key == "clock" { return @image-url("@neoui/icons/sys/clock.svg"); }
        if key == "terminal" { return @image-url("@neoui/icons/sys/keyboard.svg"); }
        if key == "files" { return @image-url("@neoui/icons/sys/folder.svg"); }
        if key == "devtools" { return @image-url("@neoui/icons/sys/usb.svg"); }
        if key == "phone" { return @image-url("@neoui/icons/sys/call.svg"); }
        if key == "contacts" { return @image-url("@neoui/icons/sys/contacts.svg"); }
        if key == "messages" { return @image-url("@neoui/icons/sys/message.svg"); }
        if key == "browser" { return @image-url("@neoui/icons/sys/world.svg"); }
        return @image-url("@neoui/icons/sys/apps.svg");
    }

    VerticalLayout {
        alignment: start;
        SectionHeader { text: SetState.apps.length + " apps"; }
        for a in SetState.apps: ListRow {
            title: a.name;
            checked: SetState.found == "apps." + a.key;
            subtitle: a.settings ? "ROM · has its own settings" : "ROM";
            has-icon: true;
            icon: root.app-icon(a.key, false);
            chevron: true;
            clicked => {
                SetState.app-current = a;
                SetState.sheet = "app";
            }
        }

        SectionHeader { text: "Old apps"; }
        for a in SetState.old-apps: ListRow {
            title: a.name;
            subtitle: "S60 app";
            has-icon: true;
            icon: root.app-icon(a.key, true);
            chevron: true;
            clicked => {
                SetState.app-current = a;
                SetState.sheet = "app";
            }
        }
        if SetState.old-total > SetState.old-apps.length: Note {
            text: SetState.old-apps.length + " of " + SetState.old-total + " old apps: the rest didn't fit in the Old apps grid either.";
        }
        if SetState.old-ok && SetState.old-apps.length == 0: Note {
            text: "Old apps are listed once Old apps has been opened since the phone started.";
        }
        // a button, not a row: search can't lead to it once old apps are listed
        if SetState.old-ok && SetState.old-apps.length == 0: HorizontalLayout {
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            padding-bottom: 8 * Theme.dp;
            Button {
                text: "Open Old apps";
                primary: false;
                clicked => { SetState.act("app-open", "legacy"); }
            }
        }
        if !SetState.old-ok: Note { text: "This UI server can't list old apps."; }
        ListRow {
            title: "Key pads for old apps";
            checked: SetState.found == "apps.oldapps";
            subtitle: "Pads, buttons and vibration for S60 apps";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/keyboard.svg");
            chevron: true;
            divider: false;
            clicked => { SetState.act("open", "14"); }
        }
    }
}

// An app's sheet: Open, and its own settings when it has them.
export component AppSheet inherits Sheet {
    title: SetState.app-current.name;
    VerticalLayout {
        padding-left: 20 * Theme.dp;
        padding-right: 20 * Theme.dp;
        spacing: 14 * Theme.dp;
        Text {
            text: SetState.app-current.old ? "An S60 app, run by the Old apps bridge." : "In the phone's ROM.";
            font-size: Theme.font-label;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        Button {
            text: "Open";
            clicked => {
                SetState.act(SetState.app-current.old ? "old-open" : "app-open", SetState.app-current.key);
                root.close();
            }
        }

        if SetState.app-current.settings: Button {
            text: "App settings";
            primary: false;
            clicked => {
                SetState.act("app", SetState.app-current.key);
                root.close();
            }
        }
        Button {
            text: "Cancel";
            primary: false;
            clicked => { root.close(); }
        }
    }
}

export component OldAppsPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Vibration"; }
        ListRow {
            title: "Key vibration";
            checked: SetState.found == "pads.vibrate";
            has-switch: true;
            switch-on <=> SetState.pad-vibrate;
            switch-toggled(v) => { SetState.act("legacy.pad.vibrate", v ? "1" : "0"); }
        }

        ListRow {
            title: "Vibration strength";
            checked: SetState.found == "pads.strength";
            subtitle: SetState.pad-strengths.length > SetState.pad-strength ? SetState.pad-strengths[SetState.pad-strength] : "";
            chevron: true;
            clicked => { SetState.sheet = "pad-strength"; }
        }

        SectionHeader { text: "Pads"; }
        ListRow {
            title: "Default pad for new apps";
            checked: SetState.found == "pads.default";
            subtitle: SetState.pad-default == 0 ? "Auto · games get Gamepad" : SetState.pad-defaults.length > SetState.pad-default ? SetState.pad-defaults[SetState.pad-default] : "";
            chevron: true;
            clicked => { SetState.sheet = "pad-default"; }
        }

        ListRow {
            title: "Gamepad directions";
            checked: SetState.found == "pads.dirs";
            subtitle: SetState.pad-dirs-names.length > SetState.pad-dirs ? SetState.pad-dirs-names[SetState.pad-dirs] : "";
            chevron: true;
            clicked => { SetState.sheet = "pad-dirs"; }
        }

        ListRow {
            title: "Gamepad A button";
            checked: SetState.found == "pads.a";
            subtitle: SetState.pad-a-names.length > SetState.pad-a ? SetState.pad-a-names[SetState.pad-a] : "";
            chevron: true;
            clicked => { SetState.sheet = "pad-a"; }
        }

        ListRow {
            title: "Gamepad B button";
            checked: SetState.found == "pads.b";
            subtitle: SetState.pad-b-names.length > SetState.pad-b ? SetState.pad-b-names[SetState.pad-b] : "";
            chevron: true;
            clicked => { SetState.sheet = "pad-b"; }
        }

        ListRow {
            title: "Left-handed gamepad";
            checked: SetState.found == "pads.lefty";
            subtitle: "Swaps the d-pad and the buttons";
            has-switch: true;
            switch-on <=> SetState.pad-lefty;
            switch-toggled(v) => { SetState.act("legacy.pad.lefty", v ? "1" : "0"); }
        }

        ListRow {
            title: "Open games in the console";
            checked: SetState.found == "pads.console";
            subtitle: "Landscape: d-pad left, buttons right";
            has-switch: true;
            switch-on <=> SetState.pad-console;
            switch-toggled(v) => { SetState.act("legacy.pad.console", v ? "1" : "0"); }
        }

        Rectangle {
            height: Theme.list-row-h;
            background: reset.pressed ? Theme.pressed : transparent;
            Text {
                x: Theme.margin + 4 * Theme.dp;
                text: "Reset remembered pads";
                color: Theme.danger;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }

            reset := TouchArea {
                clicked => { SetState.act("pad-reset", ""); }
            }
        }
    }
}

export component DeveloperPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Debugging"; }
        ListRow {
            title: "USB debugging";
            checked: SetState.found == "dev.usb";
            subtitle: SetState.usb-debugging ? "Shell on the second USB port (phone.py sh)" : "Off";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/usb.svg");
            has-switch: true;
            switch-on <=> SetState.usb-debugging;
            switch-toggled(v) => { SetState.act("developer.usb_debugging", v ? "1" : "0"); }
        }

        SectionHeader { text: "Logs"; }
        ListRow {
            title: "Kernel log";
            checked: SetState.found == "dev.log";
            subtitle: "Live, in Dev tools › Console";
            chevron: true;
            clicked => { SetState.act("devtools", "console"); }
        }

        ListRow {
            title: "Save logs";
            checked: SetState.found == "dev.save";
            subtitle: "To E:\\logs (C:\\logs without E:), in Dev tools › Tools";
            chevron: true;
            clicked => { SetState.act("devtools", "tools"); }
        }

        SectionHeader { text: "Input"; }
        ListRow {
            title: "Show touches";
            checked: SetState.found == "dev.touches";
            subtitle: "A dot under each finger";
            has-switch: true;
            switch-on <=> SetState.show-touches;
            switch-toggled(v) => { SetState.act("developer.show_touches", v ? "1" : "0"); }
            divider: false;
        }

        SectionHeader { text: "Tools"; }
        ListRow {
            title: "Open Dev tools";
            checked: SetState.found == "dev.tools";
            subtitle: "Devices, the kernel log, processes, saving logs";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/options.svg");
            chevron: true;
            divider: false;
            clicked => { SetState.act("app-open", "devtools"); }
        }
    }
}

export component AboutPage inherits NeoList {
    VerticalLayout {
        padding: Theme.margin;
        spacing: 12 * Theme.dp;
        alignment: start;
        Card {
            height: 132 * Theme.dp;
            VerticalLayout {
                padding: Theme.card-pad;
                spacing: 4 * Theme.dp;
                alignment: center;
                Text {
                    text: "NeoSymbian";
                    color: Theme.text;
                    font-size: Theme.font-title * 1.3;
                    font-weight: 700;
                }

                Text {
                    text: "Developer preview · neoui";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Text {
                    text: "EKA2 on AArch64 (ILP32) · 2010 user side";
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
            }
        }

        for kv in [["Model", "Pixel 3a XL (bonito)"], ["Kernel", "EKA2, AArch64 ILP32"], ["User side", "Symbian^3 (2010), ARMv8-A"], ["UI", "neoui (Rust + Slint)"]]: HorizontalLayout {
            height: 36 * Theme.dp;
            padding-left: 4 * Theme.dp;
            padding-right: 4 * Theme.dp;
            Text {
                text: kv[0];
                color: Theme.text-dim;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: kv[1];
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Build";
            color: Theme.text-dim;
            font-size: Theme.font-label;
        }

        for line in (SetState.build.length > 0 ? SetState.build : ["—"]): Text {
            text: line;
            color: Theme.text;
            font-size: Theme.font-label;
            wrap: word-wrap;
        }

        ListRow {
            title: "Licences";
            checked: SetState.found == "about.licences";
            subtitle: "Apache-2.0 · EPL · GPL-3.0 (Slint) · fonts";
            chevron: true;
            divider: false;
            clicked => { SetState.act("open", "16"); }
        }
    }
}
