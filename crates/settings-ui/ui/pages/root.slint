// The root, List variant (set2-root-list, S01): Connections · Device · Personal · Apps · System, colour tiles, live
// values (D1: row i shows SetState.summaries[i], the projection of rows::ROOT_LIST[i], the same value search finds);
// Wi-Fi and Bluetooth carry their switch (S02). Notifications, Storage and Lock screen come with their stages
// (SE3-SE6), so they are not drawn yet.
import { Theme, NeoList, SectionHeader, ListRow } from "@neoui/kit.slint";
import { SettingRow } from "../parts.slint";
import { SetState, SearchHit } from "../state.slint";

export component RootPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Connections"; }
        SettingRow {
            title: "Wi-Fi";
            value: SetState.summaries[0];
            icon: @image-url("@neoui/icons/sys/wifi.svg");
            tint: #2f80ed;
            has-switch: true;
            switch-on <=> SetState.wifi;
            switch-toggled(v) => { SetState.act("radio.wifi", v ? "1" : "0"); }
            clicked => { SetState.act("open", "1"); }
        }

        SettingRow {
            title: "Mobile network";
            value: SetState.summaries[1];
            icon: @image-url("@neoui/icons/sys/signal.svg");
            tint: #22b46a;
            clicked => { SetState.act("open", "2"); }
        }

        SettingRow {
            title: "Bluetooth";
            value: SetState.summaries[2];
            icon: @image-url("@neoui/icons/sys/bluetooth.svg");
            tint: #2f80ed;
            has-switch: true;
            switch-on <=> SetState.bluetooth;
            switch-toggled(v) => { SetState.act("radio.bt", v ? "1" : "0"); }
            clicked => { SetState.act("open", "3"); }
        }

        SettingRow {
            title: "Airplane mode";
            icon: @image-url("@neoui/icons/sys/plane.svg");
            tint: #f08c2e;
            has-switch: true;
            divider: false;
            switch-on <=> SetState.airplane;
            switch-toggled(v) => { SetState.act("radio.airplane", v ? "1" : "0"); }
            clicked => { SetState.act("open", "4"); }
        }

        SectionHeader { text: "Device"; }
        SettingRow {
            title: "Display";
            value: SetState.summaries[4];
            icon: @image-url("@neoui/icons/sys/brightness.svg");
            tint: #e2a92a;
            clicked => { SetState.act("open", "5"); }
        }

        SettingRow {
            title: "Home & navigation";
            value: SetState.summaries[5];
            icon: @image-url("@neoui/icons/sys/home.svg");
            tint: #3d8bfd;
            clicked => { SetState.act("open", "6"); }
        }

        SettingRow {
            title: "Sounds & profiles";
            value: SetState.summaries[6];
            icon: @image-url("@neoui/icons/sys/volume.svg");
            tint: #e5484d;
            clicked => { SetState.act("open", "7"); }
        }

        // TP4: Panel & notifications (tp-settings), its line from the policy (Do not disturb, the apps allowed)
        SettingRow {
            title: "Notifications";
            value: SetState.summaries[7];
            icon: @image-url("@neoui/icons/sys/bell.svg");
            tint: #e2467c;
            clicked => { SetState.act("open", "27"); }
        }

        SettingRow {
            title: "Battery";
            value: SetState.summaries[8];
            icon: @image-url("@neoui/icons/sys/battery_saver.svg");
            tint: #14a37f;
            clicked => { SetState.act("open", "8"); }
        }

        SettingRow {
            title: "Storage";
            value: SetState.summaries[9];
            icon: @image-url("@neoui/icons/sys/phone_storage.svg");
            tint: #8656e8;
            clicked => { SetState.act("open", "20"); }
        }

        SectionHeader { text: "Personal"; }
        SettingRow {
            title: "Lock screen & security";
            value: SetState.summaries[10];
            icon: @image-url("@neoui/icons/sys/lock.svg");
            tint: #2bb0a0;
            clicked => { SetState.act("open", "34"); }
        }

        SettingRow {
            title: "Date & time";
            value: SetState.summaries[11];
            icon: @image-url("@neoui/icons/sys/stopwatch.svg");
            tint: #3d8bfd;
            clicked => { SetState.act("open", "9"); }
        }

        SettingRow {
            title: "Language & keyboard";
            value: SetState.summaries[12];
            icon: @image-url("@neoui/icons/sys/language.svg");
            tint: #1fa9c4;
            clicked => { SetState.act("open", "10"); }
        }

        SettingRow {
            title: "Privacy";
            icon: @image-url("@neoui/icons/sys/privacy.svg");
            tint: #5b6472;
            clicked => { SetState.act("open", "15"); }
        }

        SectionHeader { text: "Apps"; }
        SettingRow {
            title: "Apps";
            value: SetState.summaries[14];
            icon: @image-url("@neoui/icons/sys/apps.svg");
            tint: #8656e8;
            clicked => { SetState.act("open", "13"); }
        }

        SectionHeader { text: "System"; }
        SettingRow {
            title: "Developer options";
            value: SetState.summaries[15];
            icon: @image-url("@neoui/icons/sys/usb.svg");
            tint: #5b6472;
            clicked => { SetState.act("open", "11"); }
        }

        SettingRow {
            title: "About phone";
            icon: @image-url("@neoui/icons/sys/info.svg");
            tint: #5b6472;
            clicked => { SetState.act("open", "12"); }
        }
    }
}

// one tile of the Nokia grid: a big coloured icon, its label under it
component GridTile inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> tint;
    in property <int> page;
    // D1: the summary of the root row it stands for (rows::ROOT_GRID), read out only
    in property <string> summary;
    // three equal columns whatever the labels' widths
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: 104 * Theme.dp;
    // an empty label keeps a short row's columns (the grid's last row): drawn as nothing
    visible: root.label != "";
    background: t.pressed ? Theme.pressed : transparent;
    border-radius: 12 * Theme.dp;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.summary;
    accessible-action-default => { SetState.act("open", root.page); }
    t := TouchArea {
        clicked => { SetState.act("open", root.page); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 8 * Theme.dp;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56 * Theme.dp;
                height: self.width;
                border-radius: 14 * Theme.dp;
                background: root.tint;
                Image {
                    width: 30 * Theme.dp;
                    height: self.width;
                    source: root.icon;
                    colorize: white;
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-label;
            horizontal-alignment: center;
        }
    }
}

// The root, Nokia grid variant (set2-root-grid, S01): the categories in 3 columns; the pages are the list's. Only
// categories with a page today, in the board's order (Security comes with SE6); Mobile
// network is under Connectivity, as the board groups it.
export component RootGridPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        padding: 12 * Theme.dp;
        spacing: 4 * Theme.dp;
        for r in [
            [{ l: "Connectivity", i: @image-url("@neoui/icons/sys/wifi.svg"), c: #2f80ed, p: 4, s: -1 },
             { l: "Display", i: @image-url("@neoui/icons/sys/brightness.svg"), c: #e2a92a, p: 5, s: 4 },
             { l: "Sounds", i: @image-url("@neoui/icons/sys/volume.svg"), c: #e5484d, p: 7, s: 6 }],
            [{ l: "Navigation", i: @image-url("@neoui/icons/sys/home.svg"), c: #3d8bfd, p: 6, s: 5 },
             { l: "Notifications", i: @image-url("@neoui/icons/sys/bell.svg"), c: #e2467c, p: 27, s: 7 },
             { l: "Battery", i: @image-url("@neoui/icons/sys/battery_saver.svg"), c: #14a37f, p: 8, s: 8 }],
            [{ l: "Storage", i: @image-url("@neoui/icons/sys/phone_storage.svg"), c: #8656e8, p: 20, s: 9 },
             { l: "Privacy", i: @image-url("@neoui/icons/sys/privacy.svg"), c: #5b6472, p: 15, s: -1 },
             { l: "Time", i: @image-url("@neoui/icons/sys/stopwatch.svg"), c: #3d8bfd, p: 9, s: 11 }],
            [{ l: "Language", i: @image-url("@neoui/icons/sys/language.svg"), c: #1fa9c4, p: 10, s: 12 },
             { l: "Apps", i: @image-url("@neoui/icons/sys/apps.svg"), c: #8656e8, p: 13, s: 14 },
             { l: "Developer", i: @image-url("@neoui/icons/sys/usb.svg"), c: #5b6472, p: 11, s: 15 }],
            [{ l: "About", i: @image-url("@neoui/icons/sys/info.svg"), c: #5b6472, p: 12, s: -1 }, { l: "", i: @image-url("@neoui/icons/sys/info.svg"), c: #5b6472, p: 0, s: -1 }, { l: "", i: @image-url("@neoui/icons/sys/info.svg"), c: #5b6472, p: 0, s: -1 }],
        ]: HorizontalLayout {
            spacing: 4 * Theme.dp;
            for t in r: GridTile {
                label: t.l;
                icon: t.i;
                tint: t.c;
                page: t.p;
                summary: t.s >= 0 ? SetState.summaries[t.s] : "";
            }
        }
    }
}

// A search result's page, as a tile (set2-search): the colour and glyph of the root row that leads there.
component PageTile inherits Rectangle {
    in property <int> page;
    width: Theme.row-tile;
    height: self.width;
    border-radius: 8 * Theme.dp;
    background: page == 1 || page == 3 || page == 4 || page == 17 ? #2f80ed
        : page == 2 ? #22b46a
        : page == 5 ? #e2a92a
        : page == 6 || page == 9 ? #3d8bfd
        : page == 7 || page == 18 ? #e5484d
        : page == 8 || page == 19 ? #14a37f
        : page == 10 ? #1fa9c4
        : page == 13 || page == 14 || page == 20 || page == 21 ? #8656e8
        : #5b6472;
    Image {
        width: 20 * Theme.dp;
        height: self.width;
        colorize: white;
        source: page == 1 || page == 4 || page == 17 ? @image-url("@neoui/icons/sys/wifi.svg")
            : page == 2 ? @image-url("@neoui/icons/sys/signal.svg")
            : page == 3 ? @image-url("@neoui/icons/sys/bluetooth.svg")
            : page == 5 ? @image-url("@neoui/icons/sys/brightness.svg")
            : page == 6 ? @image-url("@neoui/icons/sys/home.svg")
            : page == 7 || page == 18 ? @image-url("@neoui/icons/sys/volume.svg")
            : page == 8 || page == 19 ? @image-url("@neoui/icons/sys/battery_saver.svg")
            : page == 9 ? @image-url("@neoui/icons/sys/stopwatch.svg")
            : page == 10 ? @image-url("@neoui/icons/sys/language.svg")
            : page == 11 ? @image-url("@neoui/icons/sys/usb.svg")
            : page == 13 || page == 14 || page == 21 ? @image-url("@neoui/icons/sys/apps.svg")
            : page == 15 ? @image-url("@neoui/icons/sys/privacy.svg")
            : page == 20 ? @image-url("@neoui/icons/sys/phone_storage.svg")
            : @image-url("@neoui/icons/sys/info.svg");
    }
}

// One result (set2-search): the page's tile; "Page › " then the title with the match in the accent; the value under it.
component ResultRow inherits Rectangle {
    in property <SearchHit> hit;
    // the result Back came back to (D1)
    in property <bool> selected;
    callback clicked;
    // the line's pieces measured, not drawn (whether the highlighted line fits)
    m-path := Text { visible: false; text: hit.path; font-size: Theme.font-value; }
    m-arrow := Text { visible: false; text: "›"; font-size: Theme.font-value; }
    m-pre := Text { visible: false; text: hit.pre; font-size: Theme.font-body; font-weight: 500; }
    m-mark := Text { visible: false; text: hit.mark; font-size: Theme.font-body; font-weight: 500; }
    m-post := Text { visible: false; text: hit.post; font-size: Theme.font-body; font-weight: 500; }
    height: Theme.list-row-double-h;
    background: t.pressed ? Theme.pressed : selected ? Theme.selected : transparent;
    accessible-role: button;
    accessible-label: hit.path + ", " + hit.title;
    accessible-description: hit.value;
    accessible-action-default => { root.clicked(); }
    t := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            PageTile { page: hit.page; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            // the title with its match highlighted, when the whole line fits the text column (the row less its
            // padding, tile, chevron and spacing); a longer one shows path and title plainly, each eliding
            property <length> space: Theme.font-body * 0.28;
            property <length> column: 360 * Theme.dp - 2 * Theme.margin - 4 * Theme.dp - Theme.row-tile - 20 * Theme.dp - 24 * Theme.dp;
            property <bool> fits: m-path.preferred-width + m-arrow.preferred-width + m-pre.preferred-width + m-mark.preferred-width + m-post.preferred-width + 4 * self.space <= self.column;
            if fits: HorizontalLayout {
                Text {
                    text: hit.path;
                    color: Theme.text-dim;
                    font-size: Theme.font-value;
                    vertical-alignment: bottom;
                }
                Rectangle { width: space; }
                Text {
                    text: "›";
                    color: Theme.text-dim;
                    font-size: Theme.font-value;
                    vertical-alignment: bottom;
                }
                Rectangle { width: space; }
                Text {
                    text: hit.pre;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }
                Rectangle { width: hit.gap-before ? space : 0; }
                Text {
                    text: hit.mark;
                    color: Theme.accent;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }
                Rectangle { width: hit.gap-after ? space : 0; }
                Text {
                    text: hit.post;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    horizontal-stretch: 1;
                }
            }
            if !fits: HorizontalLayout {
                spacing: space;
                Text {
                    text: hit.path;
                    color: Theme.text-dim;
                    font-size: Theme.font-value;
                    vertical-alignment: bottom;
                    overflow: elide;
                    max-width: 100 * Theme.dp;
                }
                Text {
                    text: "›";
                    color: Theme.text-dim;
                    font-size: Theme.font-value;
                    vertical-alignment: bottom;
                }
                Text {
                    text: hit.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            if hit.value != "": Text {
                text: hit.value;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                width: 20 * Theme.dp;
                height: self.width;
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                colorize: Theme.text-dim;
            }
        }
    }

    Rectangle {
        x: Theme.margin + 4 * Theme.dp + Theme.row-tile + 12 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
}

// Search (set2-search): every row whose title, other names or page matches, with where it is and its value; a tap
// opens its page. Its scroll is kept in SetState while a result's page is open (D1: Back comes back to it).
export component SearchPage inherits NeoList {
    content-y <=> SetState.search-scroll;
    VerticalLayout {
        alignment: start;
        if SetState.results.length > 0: SectionHeader {
            text: SetState.results.length == 1 ? "1 result" : SetState.results.length + " results";
        }
        for hit in SetState.results: ResultRow {
            hit: hit;
            selected: hit.token == SetState.search-selected;
            clicked => { SetState.act("found", hit.token); }
        }
        if SetState.results.length == 0: Text {
            x: Theme.margin;
            height: 64 * Theme.dp;
            vertical-alignment: center;
            text: "Type to search every setting.";
            color: Theme.text-secondary;
            font-size: Theme.font-body;
        }
    }
}
