// The root, List variant (set2-root-list, S01): Connections · Device · Personal · Apps · System, colour tiles, live
// values; Wi-Fi and Bluetooth carry their switch (S02). Notifications, Storage and Lock screen come with their stages
// (SE3-SE6), so they are not drawn yet.
import { Theme, NeoList, SectionHeader, ListRow } from "@neoui/kit.slint";
import { SettingRow } from "../parts.slint";
import { SetState, SearchHit } from "../state.slint";

export component RootPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Connections"; }
        SettingRow {
            title: "Wi-Fi";
            value: !SetState.wifi ? "Off" : SetState.wifi-link.connected ? SetState.wifi-link.name : "Not connected";
            icon: @image-url("@neoui/icons/sys/wifi.svg");
            tint: #2f80ed;
            has-switch: true;
            switch-on <=> SetState.wifi;
            switch-toggled(v) => { SetState.act("radio.wifi", v ? "1" : "0"); }
            clicked => { SetState.act("open", "1"); }
        }

        SettingRow {
            title: "Mobile network";
            value: SetState.airplane ? "Off" : SetState.rat == "" ? "No service" : SetState.rat;
            icon: @image-url("@neoui/icons/sys/signal.svg");
            tint: #22b46a;
            clicked => { SetState.act("open", "2"); }
        }

        SettingRow {
            title: "Bluetooth";
            value: SetState.bluetooth ? "On" : "Off";
            icon: @image-url("@neoui/icons/sys/bluetooth.svg");
            tint: #2f80ed;
            has-switch: true;
            switch-on <=> SetState.bluetooth;
            switch-toggled(v) => { SetState.act("radio.bt", v ? "1" : "0"); }
            clicked => { SetState.act("open", "3"); }
        }

        SettingRow {
            title: "Airplane mode";
            icon: @image-url("@neoui/icons/sys/plane.svg");
            tint: #f08c2e;
            has-switch: true;
            divider: false;
            switch-on <=> SetState.airplane;
            switch-toggled(v) => { SetState.act("radio.airplane", v ? "1" : "0"); }
            clicked => { SetState.act("open", "4"); }
        }

        SectionHeader { text: "Device"; }
        SettingRow {
            title: "Display";
            value: SetState.dark ? "Dark" : "Light";
            icon: @image-url("@neoui/icons/sys/brightness.svg");
            tint: #e2a92a;
            clicked => { SetState.act("open", "5"); }
        }

        SettingRow {
            title: "Home & navigation";
            value: SetState.nav-modes.length > SetState.nav-mode ? SetState.nav-modes[SetState.nav-mode] : "";
            icon: @image-url("@neoui/icons/sys/home.svg");
            tint: #3d8bfd;
            clicked => { SetState.act("open", "6"); }
        }

        SettingRow {
            title: "Sounds & profiles";
            value: SetState.active-profile-name;
            icon: @image-url("@neoui/icons/sys/volume.svg");
            tint: #e5484d;
            clicked => { SetState.act("open", "7"); }
        }

        SettingRow {
            title: "Battery";
            value: SetState.battery-text;
            icon: @image-url("@neoui/icons/sys/battery_saver.svg");
            tint: #14a37f;
            clicked => { SetState.act("open", "8"); }
        }

        SettingRow {
            title: "Storage";
            value: SetState.storage-free;
            icon: @image-url("@neoui/icons/sys/phone_storage.svg");
            tint: #8656e8;
            clicked => { SetState.act("open", "20"); }
        }

        SectionHeader { text: "Personal"; }
        SettingRow {
            title: "Date & time";
            value: SetState.time-auto ? "Automatic" : "Manual";
            icon: @image-url("@neoui/icons/sys/stopwatch.svg");
            tint: #3d8bfd;
            clicked => { SetState.act("open", "9"); }
        }

        SettingRow {
            title: "Language & keyboard";
            value: SetState.keyboard-names.length > SetState.keyboard ? SetState.keyboard-names[SetState.keyboard] : "";
            icon: @image-url("@neoui/icons/sys/language.svg");
            tint: #1fa9c4;
            clicked => { SetState.act("open", "10"); }
        }

        SettingRow {
            title: "Privacy";
            icon: @image-url("@neoui/icons/sys/privacy.svg");
            tint: #5b6472;
            clicked => { SetState.act("open", "15"); }
        }

        SectionHeader { text: "Apps"; }
        SettingRow {
            title: "Apps";
            value: "Phone, old apps";
            icon: @image-url("@neoui/icons/sys/apps.svg");
            tint: #8656e8;
            clicked => { SetState.act("open", "13"); }
        }

        SectionHeader { text: "System"; }
        SettingRow {
            title: "Developer options";
            value: SetState.usb-debugging ? "USB debugging" : SetState.show-touches ? "Show touches" : "Off";
            icon: @image-url("@neoui/icons/sys/usb.svg");
            tint: #5b6472;
            clicked => { SetState.act("open", "11"); }
        }

        SettingRow {
            title: "About phone";
            icon: @image-url("@neoui/icons/sys/info.svg");
            tint: #5b6472;
            clicked => { SetState.act("open", "12"); }
        }
    }
}

// one tile of the Nokia grid: a big coloured icon, its label under it
component GridTile inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> tint;
    in property <int> page;
    // three equal columns whatever the labels' widths
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: 104 * Theme.dp;
    background: t.pressed ? Theme.pressed : transparent;
    border-radius: 12 * Theme.dp;
    t := TouchArea {
        clicked => { SetState.act("open", root.page); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 8 * Theme.dp;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56 * Theme.dp;
                height: self.width;
                border-radius: 14 * Theme.dp;
                background: root.tint;
                Image {
                    width: 30 * Theme.dp;
                    height: self.width;
                    source: root.icon;
                    colorize: white;
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-label;
            horizontal-alignment: center;
        }
    }
}

// The root, Nokia grid variant (set2-root-grid, S01): the categories in 3 columns; the pages are the list's. Only
// categories with a page today, in the board's order (Notifications and Security come with TP4 and SE6); Mobile
// network is under Connectivity, as the board groups it.
export component RootGridPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        padding: 12 * Theme.dp;
        spacing: 4 * Theme.dp;
        for r in [
            [{ l: "Connectivity", i: @image-url("@neoui/icons/sys/wifi.svg"), c: #2f80ed, p: 4 },
             { l: "Display", i: @image-url("@neoui/icons/sys/brightness.svg"), c: #e2a92a, p: 5 },
             { l: "Sounds", i: @image-url("@neoui/icons/sys/volume.svg"), c: #e5484d, p: 7 }],
            [{ l: "Navigation", i: @image-url("@neoui/icons/sys/home.svg"), c: #3d8bfd, p: 6 },
             { l: "Battery", i: @image-url("@neoui/icons/sys/battery_saver.svg"), c: #14a37f, p: 8 },
             { l: "Storage", i: @image-url("@neoui/icons/sys/phone_storage.svg"), c: #8656e8, p: 20 }],
            [{ l: "Privacy", i: @image-url("@neoui/icons/sys/privacy.svg"), c: #5b6472, p: 15 },
             { l: "Time", i: @image-url("@neoui/icons/sys/stopwatch.svg"), c: #3d8bfd, p: 9 },
             { l: "Language", i: @image-url("@neoui/icons/sys/language.svg"), c: #1fa9c4, p: 10 }],
            [{ l: "Apps", i: @image-url("@neoui/icons/sys/apps.svg"), c: #8656e8, p: 13 },
             { l: "Developer", i: @image-url("@neoui/icons/sys/usb.svg"), c: #5b6472, p: 11 },
             { l: "About", i: @image-url("@neoui/icons/sys/info.svg"), c: #5b6472, p: 12 }],
        ]: HorizontalLayout {
            spacing: 4 * Theme.dp;
            for t in r: GridTile {
                label: t.l;
                icon: t.i;
                tint: t.c;
                page: t.p;
            }
        }
    }
}

// A search result's page, as a tile (set2-search): the colour and glyph of the root row that leads there.
component PageTile inherits Rectangle {
    in property <int> page;
    width: Theme.row-tile;
    height: self.width;
    border-radius: 8 * Theme.dp;
    background: page == 1 || page == 3 || page == 4 || page == 17 ? #2f80ed
        : page == 2 ? #22b46a
        : page == 5 ? #e2a92a
        : page == 6 || page == 9 ? #3d8bfd
        : page == 7 || page == 18 ? #e5484d
        : page == 8 || page == 19 ? #14a37f
        : page == 10 ? #1fa9c4
        : page == 13 || page == 14 || page == 20 || page == 21 ? #8656e8
        : #5b6472;
    Image {
        width: 20 * Theme.dp;
        height: self.width;
        colorize: white;
        source: page == 1 || page == 4 || page == 17 ? @image-url("@neoui/icons/sys/wifi.svg")
            : page == 2 ? @image-url("@neoui/icons/sys/signal.svg")
            : page == 3 ? @image-url("@neoui/icons/sys/bluetooth.svg")
            : page == 5 ? @image-url("@neoui/icons/sys/brightness.svg")
            : page == 6 ? @image-url("@neoui/icons/sys/home.svg")
            : page == 7 || page == 18 ? @image-url("@neoui/icons/sys/volume.svg")
            : page == 8 || page == 19 ? @image-url("@neoui/icons/sys/battery_saver.svg")
            : page == 9 ? @image-url("@neoui/icons/sys/stopwatch.svg")
            : page == 10 ? @image-url("@neoui/icons/sys/language.svg")
            : page == 11 ? @image-url("@neoui/icons/sys/usb.svg")
            : page == 13 || page == 14 || page == 21 ? @image-url("@neoui/icons/sys/apps.svg")
            : page == 15 ? @image-url("@neoui/icons/sys/privacy.svg")
            : page == 20 ? @image-url("@neoui/icons/sys/phone_storage.svg")
            : @image-url("@neoui/icons/sys/info.svg");
    }
}

// One result (set2-search): the page's tile; "Page › " then the title with the match in the accent; the value under it.
component ResultRow inherits Rectangle {
    in property <SearchHit> hit;
    callback clicked;
    height: Theme.list-row-double-h;
    background: t.pressed ? Theme.pressed : transparent;
    accessible-role: button;
    accessible-label: hit.path + ", " + hit.title;
    accessible-description: hit.value;
    accessible-action-default => { root.clicked(); }
    t := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            PageTile { page: hit.page; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            HorizontalLayout {
                // the pieces are separate texts, so the spaces between them are drawn as gaps
                property <length> space: Theme.font-body * 0.28;
                Text {
                    text: hit.path;
                    color: Theme.text-dim;
                    font-size: Theme.font-value;
                    vertical-alignment: bottom;
                }
                Rectangle { width: parent.space; }
                Text {
                    text: "›";
                    color: Theme.text-dim;
                    font-size: Theme.font-value;
                    vertical-alignment: bottom;
                }
                Rectangle { width: parent.space; }
                Text {
                    text: hit.pre;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }
                Rectangle { width: hit.gap-before ? parent.space : 0; }
                Text {
                    text: hit.mark;
                    color: Theme.accent;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }
                Rectangle { width: hit.gap-after ? parent.space : 0; }
                Text {
                    text: hit.post;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            if hit.value != "": Text {
                text: hit.value;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                width: 20 * Theme.dp;
                height: self.width;
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                colorize: Theme.text-dim;
            }
        }
    }

    Rectangle {
        x: Theme.margin + 4 * Theme.dp + Theme.row-tile + 12 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
}

// Search (set2-search): every row whose title, other names or page matches, with where it is and its value; a tap
// opens its page.
export component SearchPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        if SetState.results.length > 0: SectionHeader {
            text: SetState.results.length == 1 ? "1 result" : SetState.results.length + " results";
        }
        for hit in SetState.results: ResultRow {
            hit: hit;
            clicked => { SetState.act("found", hit.id); }
        }
        if SetState.results.length == 0: Text {
            x: Theme.margin;
            height: 64 * Theme.dp;
            vertical-alignment: center;
            text: "Type to search every setting.";
            color: Theme.text-secondary;
            font-size: Theme.font-body;
        }
    }
}
