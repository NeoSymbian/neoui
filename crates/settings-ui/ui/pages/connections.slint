// Connectivity / Airplane mode (set2-airplane), Mobile network (set2-mobile) and Bluetooth (set2-bluetooth). Values
// are what MODEMD reports: no "4G" or data usage it doesn't measure (D4). Rows whose stage hasn't landed (D13, D14)
// say "Not yet" and do nothing.
import { Theme, NeoList, SectionHeader, ListRow } from "@neoui/kit.slint";
import { Note } from "../parts.slint";
import { SetState } from "../state.slint";

export component ConnectivityPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Wireless"; }
        ListRow {
            value-bright: true;
            title: "Wi-Fi";
            checked: SetState.found == "conn.wifi";
            subtitle: !SetState.wifi ? "Off" : SetState.wifi-link.connected ? "Connected to " + SetState.wifi-link.name : SetState.wifi-status;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/wifi.svg");
            has-switch: true;
            switch-on <=> SetState.wifi;
            switch-toggled(v) => { SetState.act("radio.wifi", v ? "1" : "0"); }
            clicked => { SetState.act("open", "1"); }
        }

        ListRow {

            value-bright: true;
            title: "Bluetooth";
            checked: SetState.found == "conn.bt";
            subtitle: SetState.bluetooth ? "On · no driver yet" : "Off";
            
            clicked => { SetState.act("open", "3"); }
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/bluetooth.svg");
            has-switch: true;
            switch-on <=> SetState.bluetooth;
            switch-toggled(v) => { SetState.act("radio.bt", v ? "1" : "0"); }
        }

        SectionHeader { text: "Mobile"; }
        ListRow {
            value-bright: true;
            title: "Mobile data";
            checked: SetState.found == "conn.data";
            subtitle: !SetState.mobile-data ? "Off" : SetState.rat == "" ? "No service" : SetState.rat;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/data.svg");
            has-switch: true;
            switch-on <=> SetState.mobile-data;
            switch-toggled(v) => { SetState.act("radio.data", v ? "1" : "0"); }
            // the grid's Connectivity is the way to Mobile network (set2-root-grid)
            clicked => { SetState.act("open", "2"); }
        }

        ListRow {
            value-bright: true;
            title: "Airplane mode";
            checked: SetState.found == "conn.airplane";
            subtitle: SetState.airplane ? (SetState.radio-online ? "Turning radio off…" : "Radio off") : (SetState.radio-online ? "Radio on" : "Waiting for radio");
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/plane.svg");
            has-switch: true;
            switch-on <=> SetState.airplane;
            switch-toggled(v) => { SetState.act("radio.airplane", v ? "1" : "0"); }
            divider: false;
        }

        Note { text: "Wi-Fi and Bluetooth can be turned back on while airplane mode stays on."; }
    }
}

export component MobilePage inherits NeoList {
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "SIM"; }
        ListRow {
            value-bright: true;
            title: "SIM card & operator";
            checked: SetState.found == "mobile.sim";
            subtitle: (SetState.operator == "" ? "No operator" : SetState.operator) + " · " + SetState.sim;
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/signal.svg");
        }

        // D11: the SIM PIN as MODEMD reports it
        ListRow {
            value-bright: true;
            title: "SIM card lock";
            checked: SetState.found == "mobile.sim_lock";
            subtitle: SetState.sim-lock-text;
            chevron: true;
            clicked => { SetState.act("open", "30"); }
        }

        SectionHeader { text: "Data"; }
        ListRow {
            value-bright: true;
            title: "Mobile data";
            checked: SetState.found == "mobile.data";
            subtitle: SetState.airplane ? "Airplane mode" : SetState.rat == "" ? "No service" : SetState.rat + (SetState.roaming ? " · roaming" : "");
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/data.svg");
            has-switch: true;
            switch-on <=> SetState.mobile-data;
            switch-toggled(v) => { SetState.act("radio.data", v ? "1" : "0"); }
        }

        // D13: these need the data bearer (C10); drawn, but they do nothing yet
        ListRow {
            value-bright: true;
            title: "Network mode";
            checked: SetState.found == "mobile.mode";
            subtitle: "Not yet (D13)";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/signal.svg");
        }

        ListRow {
            value-bright: true;
            title: "Roaming";
            checked: SetState.found == "mobile.roaming";
            subtitle: "Not yet (D13)";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/world.svg");
        }

        ListRow {
            value-bright: true;
            title: "Access point names";
            checked: SetState.found == "mobile.apn";
            subtitle: "Not yet (D13)";
        }

        ListRow {
            value-bright: true;
            title: "Data usage";
            checked: SetState.found == "mobile.usage";
            subtitle: "Not yet (D13)";
            divider: false;
        }
    }
}

export component BluetoothPage inherits NeoList {
    VerticalLayout {
        alignment: start;
        ListRow {
            value-bright: true;
            title: "Bluetooth";
            checked: SetState.found == "bt.switch";
            subtitle: SetState.bluetooth ? "On" : "Off";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/bluetooth.svg");
            has-switch: true;
            switch-on <=> SetState.bluetooth;
            switch-toggled(v) => { SetState.act("radio.bt", v ? "1" : "0"); }
        }

        // D14: no driver yet
        ListRow {
            value-bright: true;
            title: "Visible to nearby devices";
            checked: SetState.found == "bt.visible";
            subtitle: "Not yet (D14)";
        }

        ListRow {
            value-bright: true;
            title: "Paired devices";
            checked: SetState.found == "bt.paired";
            subtitle: "Not yet (D14)";
            divider: false;
        }

        Note { text: "No driver yet: the switch is saved and takes effect once Bluetooth works (B3). Pairing and devices come then."; }
    }
}
