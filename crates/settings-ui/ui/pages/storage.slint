// Storage (set2-storage, SE3b): the drives at once, then C: and E: by kind from a scan that only lists folders. Share
// E: over USB waits for FS6, app data by owner for SE4, "Open in Files" at a drive for Files' own page.
import { Theme, NeoList, SectionHeader, ListRow, Button, Glyph } from "@neoui/kit.slint";
import { SetState, DriveRow, PartRow } from "../state.slint";

// A drive (set2-storage): its tile by letter, the title with the used size at the right, a bar when the drive has a
// size, then what lives there. No chevron: a drive's own page waits for FS6.
component DriveItem inherits Rectangle {
    in property <DriveRow> d;
    // D3: the drive's Apps, Files and Other (C:'s, once counted) in the by-kind colours; empty: one used fill
    in property <[PartRow]> parts;
    in property <bool> divider: true;
    property <string> letter: d.title;
    // by the whole "X:" (a "Drives" error row is no D:); any other drive gets a neutral folder, Z: the lock
    property <bool> is-e: letter.starts-with("E:");
    property <bool> is-c: letter.starts-with("C:");
    property <bool> is-d: letter.starts-with("D:");
    property <bool> is-z: letter.starts-with("Z:");
    property <color> tint: is-e ? #e2a92a : is-c ? #2f80ed : is-d ? #1aa37a : #5b616b;
    accessible-role: text;
    accessible-label: d.title + ", " + d.used + (d.note == "" ? "" : ", " + d.note);
    height: 76 * Theme.dp;
    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin + 4 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.row-tile;
                height: self.width;
                border-radius: 8 * Theme.dp;
                background: root.tint;
                Glyph {
                    source: is-e ? @image-url("@neoui/icons/sys/sdcard.svg") : is-c ? @image-url("@neoui/icons/sys/phone_storage.svg") : is-d ? @image-url("@neoui/icons/sys/flash.svg") : is-z ? @image-url("@neoui/icons/sys/lock.svg") : @image-url("@neoui/icons/sys/folder.svg");
                    accessible-role: none;
                    size: 18 * Theme.dp;
                    colorize: white;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 5 * Theme.dp;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8 * Theme.dp;
                Text {
                    text: d.title;
                    accessible-role: none;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: d.used;
                    accessible-role: none;
                    color: Theme.text-secondary;
                    font-size: Theme.font-value;
                }
            }
            // a drive without a known size (D:, Z:) gets no bar
            if d.fill >= 0: track := Rectangle {
                height: 4 * Theme.dp;
                border-radius: 2 * Theme.dp;
                background: #2a2e35;
                clip: true;
                if parts.length == 0: Rectangle {
                    x: 0;
                    width: parent.width * min(1, d.fill);
                    border-radius: 2 * Theme.dp;
                    background: Theme.accent;
                }
                for p[i] in parts: Rectangle {
                    x: p.start * track.width;
                    width: p.share * track.width;
                    background: [#8656e8, #3d8bfd, #7d838c][i];
                }
            }
            if d.note != "": Text {
                text: d.note;
                accessible-role: none;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }
    }
    if divider: Rectangle {
        x: Theme.margin + 4 * Theme.dp + Theme.row-tile + 14 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
}

export component StoragePage inherits NeoList {
    // the bar's colours: Apps, Files, Other, Free (set2-storage's)
    property <[color]> part-colours: [#8656e8, #3d8bfd, #7d838c, #2a2e35];
    VerticalLayout {
        alignment: start;
        SectionHeader { text: "Drives"; }
        for d[i] in SetState.drives: DriveItem {
            d: d;
            parts: d.title.starts-with("C:") ? SetState.storage-c-parts : [];
            divider: i < SetState.drives.length - 1;
        }

        SectionHeader { text: "USB"; }
        ListRow {
            title: "Share E: over USB";
            checked: SetState.found == "storage.usb";
            subtitle: "Not yet (FS6) · E: would unmount here";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/usb.svg");
            divider: false;
        }

        SectionHeader { text: "C: and E: by kind"; }
        VerticalLayout {
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            spacing: 10 * Theme.dp;
            if SetState.storage-counted || SetState.storage-counting: bar := Rectangle {
                height: 14 * Theme.dp;
                border-radius: 7 * Theme.dp;
                background: #2a2e35;
                clip: true;
                for p[i] in SetState.storage-parts: Rectangle {
                    x: p.start * bar.width;
                    width: p.share * bar.width;
                    background: part-colours[i];
                }
            }
            for p[i] in SetState.storage-parts: HorizontalLayout {
                spacing: 10 * Theme.dp;
                Rectangle {
                    width: 10 * Theme.dp;
                    height: 10 * Theme.dp;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5 * Theme.dp;
                    background: part-colours[i];
                }
                Text {
                    text: p.name;
                    font-size: Theme.font-label;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
                Text {
                    text: p.size;
                    font-size: Theme.font-label;
                    color: Theme.text-secondary;
                }
            }
        }

        VerticalLayout {
            padding: Theme.margin;
            spacing: 10 * Theme.dp;
            Text {
                text: SetState.storage-status;
                font-size: Theme.font-status;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            if SetState.storage-unreadable != "": Text {
                text: SetState.storage-unreadable;
                font-size: Theme.font-status;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            Button {
                text: SetState.storage-counting ? "Counting…" : "Recount";
                primary: false;
                enabled: !SetState.storage-counting;
                clicked => { SetState.act("storage-recount", ""); }
            }
        }

        if SetState.storage-counted: VerticalLayout {
            padding-top: 6 * Theme.dp;
            for k[i] in SetState.storage-kinds: ListRow {
                value-bright: true;
                title: k.name;
                value: k.size;
                checked: SetState.found == "storage.kinds" && i == 0;
                divider: i < SetState.storage-kinds.length - 1;
            }
        }

        ListRow {

            value-bright: true;
            title: "Open Files";
            checked: SetState.found == "storage.files";
            subtitle: "Browse C:, E: and the rest";
            has-icon: true;
            icon: @image-url("@neoui/icons/sys/folder.svg");
            chevron: true;
            divider: false;
            clicked => { SetState.act("app-open", "files"); }
        }
    }
}
