// SPDX-License-Identifier: GPL-3.0-only
// What the Settings app shows and what its pages ask for (`act`). The device crate (symbian/apps/settings) fills the
// `in` properties from the settings store, WIFID, MODEMD, the HAL and the shell's SETTINGS_INFO, and answers `act`.

// one scanned Wi-Fi network (neoui-proto wifi::Network): name, "Secured · 5 GHz · -46 dBm", 0..4 bars
export struct WifiNet { name: string, detail: string, bars: int, secured: bool, band: string, signal: string, channel: int, bssid: string }
// the current link (neoui-proto wifi::LinkView, with the shell's IP rows)
export struct WifiDetail { label: string, value: string }
// a search result (set2-search): the row's title, where it is ("Date & time"), its live value, the page it opens
// a search result: the row, its title split around the match (pre, mark, post; a space before/after the match) for the
// highlight, the page it is on,
// its value now, and the page it opens
export struct SearchHit { id: string, title: string, pre: string, mark: string, post: string, gap-before: bool, gap-after: bool, path: string, value: string, page: int }
// a network WIFID remembers (Saved networks): its name, "Connected · Secured" / "Secured · not in range"
// a city on Time zone (set2-timezone): its name, its offset now ("UTC+04:00"), whether it is the phone's zone
export struct ZoneRow { name: string, offset: string, current: bool }
export struct WifiSaved { name: string, detail: string, connected: bool }
// an app on the Apps page: a ROM app by its screen key, or an old app (old: true) by its id in hex
// a sound profile (neoui-proto sound_profile): its row's summary and what the profile page edits
export struct ProfileRow { id: int, name: string, summary: string, ring: bool, volume: int, vibrate: bool, ringtone: int, message-tone: int }
// a drive on the Storage page (SE3b): "E: Mass memory", "12.4 of 41.8 GB", what it holds, how full (0..1, -1 unknown)
export struct DriveRow { title: string, used: string, note: string, fill: float }
// a part of the Storage bar or a kind: its name, size text, and for a bar part where it starts and its share (0..1)
export struct PartRow { name: string, size: string, start: float, share: float }
export struct AppRow { key: string, name: string, old: bool, settings: bool }
export struct WifiLink { shown: bool, connected: bool, name: string, subtitle: string, bars: int, band: string, details: [WifiDetail], sign-in: bool }

export global SetState {
    // the page (neoui-proto settings_app::Page ids: 0 root, 1 Wi-Fi, 2 Mobile, 3 Bluetooth, 4 Connectivity, 5 Display,
    // 6 Home & navigation, 7 Sounds, 8 Battery, 9 Date & time, 10 Language & keyboard, 11 Developer, 12 About,
    // 13 Apps, 14 Old apps, 15 Privacy) and its title; the app sets both
    in property <int> page;
    in property <string> title: "Settings";
    // the root as the Nokia grid (settings.root_grid, S01) or the list
    in property <bool> root-grid;
    // the root header's search: open, and what it found
    in-out property <bool> searching;
    in property <[SearchHit]> results;
    in-out property <string> query;
    // the row a search result opened (settings_app::rows id): it shows selected until the page changes
    in property <string> found;

    // the settings the pages show, as stored (the app reloads them on AppEvent::Settings)
    in-out property <bool> wifi;
    in-out property <bool> bluetooth;
    in-out property <bool> mobile-data;
    in-out property <bool> airplane;
    in-out property <bool> silent;
    in-out property <bool> vibrate;
    in property <int> ring-volume;
    in property <int> media-volume;
    in property <int> media-route;
    in property <int> mic;
    in-out property <bool> dark;
    in-out property <float> brightness;  // 0..1 (display.brightness / 255)
    in property <int> timeout;  // display.timeout, seconds (0 = never)
    in property <int> nav-mode;
    in-out property <bool> time-auto;
    in-out property <bool> time-auto-zone;
    in-out property <bool> clock-24h;
    in-out property <bool> status-seconds;
    in-out property <bool> shade-date;
    in-out property <bool> usb-debugging;
    // SE3a: a ring under each finger (developer.show_touches), a pulse per key (keyboard.vibrate)
    in-out property <bool> show-touches;
    in-out property <bool> key-vibrate;
    in property <[bool]> keyboards;  // English, Armenian, Russian on
    in property <int> keyboard;  // the current one
    in-out property <bool> same-height;
    in-out property <bool> pad-vibrate;
    in property <int> pad-strength;
    in property <int> pad-default;
    in property <int> pad-dirs;
    in property <int> pad-a;
    in property <int> pad-b;
    in-out property <bool> pad-lefty;
    in-out property <bool> pad-console;

    // texts the app makes (choices, values)
    in property <string> timeout-text;
    in property <[string]> timeouts;
    in property <int> timeout-index;
    in property <string> date-text;
    in property <[string]> date-formats;
    in property <int> date-format;
    in property <string> zone;
    in property <string> synced;
    in property <[ZoneRow]> cities;  // Time zone's cities, filtered by its search
    in property <[string]> nav-modes;
    in property <[string]> nav-hints;
    in property <[string]> media-routes;
    in property <[string]> mics;
    in property <[string]> keyboard-names;
    in property <[string]> keyboard-hints;
    in property <[string]> pad-strengths;
    in property <[string]> pad-defaults;
    in property <[string]> pad-dirs-names;
    in property <[string]> pad-a-names;
    in property <[string]> pad-b-names;

    // Wi-Fi (WIFID), its link and the shell's IP rows
    in property <string> wifi-status: "Searching…";
    in property <[WifiNet]> wifi-networks;
    in property <int> wifi-hidden;
    in property <bool> wifi-scanning;
    in property <WifiLink> wifi-link;
    in property <string> wifi-message;
    // the join sheet's network: 0 nothing going, 1 joining it, 2 connected to it (Connect waits while 1 or 2)
    in property <int> wifi-join;
    // the networks WIFID remembers, newest first; false: WIFID has no list (older than NeoWifi 1.1)
    in property <[WifiSaved]> wifi-saved;
    in property <bool> wifi-saved-ok;

    // Apps: the ROM apps (neoui-proto apps), the old apps the legacy bridge registered (INFO_APPS: none until it has
    // run; old-total counts any it had no room for), and the app the sheet is about; false: a shell older than 1.14
    in property <[AppRow]> apps;
    in property <[AppRow]> old-apps;
    in property <int> old-total;
    in property <bool> old-ok: true;
    in-out property <AppRow> app-current;
    // its page (SE4a): running now, whether it can be stopped (not Phone, Messages: they run all the time), and what
    // its Clear data deletes ("" = no Clear data row: the app can't clear its own data yet)
    in property <bool> app-running;
    in property <bool> app-stoppable;
    in property <string> app-clear;

    // Sounds & profiles (SE2a): every profile, the active one, the one a sheet or the profile page is about, and the
    // name typed for Add / Rename
    in property <[ProfileRow]> profiles;
    in property <int> active-profile;
    in property <string> active-profile-name: "General";
    // what the active profile does (set2-sounds' card)
    in property <string> active-profile-summary;
    in-out property <ProfileRow> profile-current;
    in-out property <string> new-name;
    // (SE2b) the tones' names, by id (sound_profile::tone)
    in property <[string]> ring-tones;
    in property <[string]> message-tones;

    // the modem (MODEMD): operator, SIM, technology ("LTE", "3G", "2G", "" = no service), radio on
    in property <string> operator;
    in property <string> sim;
    in property <string> rat;
    in property <bool> roaming;
    in property <bool> radio-online;
    in property <string> phone-feedback;

    // the battery (HAL now, the shell's 24-hour history)
    in property <string> battery-text: "--%";
    in property <string> battery-state: "Unknown";
    in property <string> battery-usb: "unknown";
    in property <string> battery-voltage: "unknown";
    in property <[float]> battery-history;
    in property <string> battery-storage;
    // SE3a: Battery saver, the status bar's percent, and Battery usage (the shell's INFO_BATTERY_USAGE as text)
    in-out property <bool> battery-saver;
    in-out property <bool> show-percent: true;
    in property <bool> usage-known;
    in property <string> usage-title;
    in property <string> usage-levels;
    in property <string> usage-on-battery;
    in property <string> usage-gaps;
    // SE3b: Storage. The drives at once; the scan's parts (Apps, Files, Other, Free: sizes and their bar), the kinds,
    // its state ("Counting… 120 folders", "Last counted 06:50") and the folders it couldn't read
    in property <[DriveRow]> drives;
    in property <[PartRow]> storage-parts;
    in property <[PartRow]> storage-kinds;
    in property <bool> storage-counting;
    in property <bool> storage-counted;
    in property <string> storage-status;
    in property <string> storage-unreadable;
    in property <string> storage-free;
    // D3: C:'s own Apps, Files and Other from its last whole count (shares of its size); empty: the plain used bar
    in property <[PartRow]> storage-c-parts;

    // About phone: the kernel's, the ROM's and neoui's build lines; Sounds: the test's progress
    in property <[string]> build;
    in property <string> sound-feedback;

    // D2: the kernel console drawn over the screen (HAL 0x4e03, as read back; hidden when the kernel can't say), and
    // the booted A/B slot ("a", "b"; "" = no reading, no row)
    in property <bool> console-ok;
    in-out property <bool> console-shown;
    in property <string> slot;

    // the open sheet: "" none, "timeout", "date-format", "zone", "pad-strength", "pad-default", "pad-dirs", "pad-a",
    // "pad-b", "wifi-join", "wifi-details"; the network the join sheet is for, and what is typed in it
    in-out property <string> sheet;
    in-out property <WifiNet> wifi-current;
    in-out property <string> password;
    in-out property <string> city-query;

    // What the pages ask for:
    // - a setting's key and its new value: "radio.wifi" "1", "display.brightness" "160", "time.zone" "Yerevan" …;
    // - "open" + a page id; "back";
    // - "wifi-refresh", "wifi-connect" (wifi-current, password), "wifi-disconnect", "wifi-forget", "wifi-sign-in";
    //   "wifi-saved-forget" + a saved network's row (the app asks to confirm first);
    // - "profile-choose" + an id; "profile-set" + "ring,volume,vibrate" (0/1, 0..10, 0/1) for profile-current;
    //   "profile-tone" + "r,<id>" (ringtone) or "m,<id>" (message tone) for profile-current, previewed;
    //   "profile-add" / "profile-rename" (new-name); "profile-delete" (the app asks to confirm first);
    // - "app-open" + a ROM app's key; "old-open" + an old app's id (hex); "app" + an app's key (its own settings);
    //   "app-detail" + a ROM app's key (its page); "app-stop", "app-clear" for app-current (the app asks first);
    //   "reset" + "network" | "settings" (the app asks first; the phone restarts);
    // - "sound" + "test" | "record"; "keyboard" + an index to turn on or off ("+0"/"-0"); "keyboard-next";
    // - "city-query" + the search text; "pad-reset" (QUERY first); "clip-clear";
    // - "app" + "phone" | "messages" | "devtools" (another app's settings); "devtools" + a page ("console", "tools");
    // - "console" + "1" | "0" (the kernel console over the screen, D2);
    // - "search" + the query; "root-grid" + "1" | "0".
    callback act(string, string);
}
