// The Settings app's own rows: the root's tile rows (set2-root-list: a coloured tile, the title, a live value or a
// switch, S02) and the notes under a section.
import { Theme, Switch } from "@neoui/kit.slint";

component Tile inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    width: Theme.row-tile;
    height: self.width;
    border-radius: 8 * Theme.dp;
    background: tint;
    Image {
        width: 20 * Theme.dp;
        height: self.width;
        source: icon;
        colorize: white;
    }
}

// A root row: the tile, the title, then a value and › or a switch (S02: the switch toggles, the rest of the row opens
// the page). A row with a switch shows its value under the title, set off from the switch by a short rule.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <image> icon;
    in property <color> tint;
    in property <bool> has-switch;
    in-out property <bool> switch-on;
    in property <bool> divider: true;
    callback clicked;
    callback switch-toggled(bool);
    property <bool> value-under: root.has-switch && root.value != "";
    height: root.value-under ? Theme.list-row-double-h : Theme.list-row-h;
    background: t.pressed ? Theme.pressed : transparent;
    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Tile {
                icon: root.icon;
                tint: root.tint;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 500;
                overflow: elide;
            }

            if root.value-under: Text {
                text: root.value;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        if !root.value-under: Text {
            text: root.value;
            color: Theme.text-secondary;
            font-size: Theme.font-value;
            vertical-alignment: center;
        }

        if !root.has-switch: VerticalLayout {
            alignment: center;
            Image {
                width: 18 * Theme.dp;
                height: self.width;
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                colorize: Theme.text-dim;
            }
        }
        if root.has-switch: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(1px, Theme.dp / 2);
                height: 32 * Theme.dp;
                background: Theme.hairline;
            }
        }
        if root.has-switch: VerticalLayout {
            alignment: center;
            Switch {
                on <=> root.switch-on;
                label: root.title;
                toggled(v) => {
                    root.switch-toggled(v);
                }
            }
        }
    }

    if root.divider: Rectangle {
        x: Theme.margin + 4 * Theme.dp + Theme.row-tile + 12 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
}

// A line of explanation under a section (set2-airplane, set2-bluetooth).
export component Note inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.margin + 4 * Theme.dp;
    padding-right: Theme.margin + 4 * Theme.dp;
    padding-top: 10 * Theme.dp;
    padding-bottom: 10 * Theme.dp;
    Text {
        text: root.text;
        color: Theme.text-secondary;
        font-size: Theme.font-label;
        wrap: word-wrap;
    }
}

// Two buttons side by side (Quieter / Louder, Test sound / Record and play back).
export component Pair inherits HorizontalLayout {
    padding-left: Theme.margin;
    padding-right: Theme.margin;
    padding-top: 4 * Theme.dp;
    padding-bottom: 8 * Theme.dp;
    spacing: 12 * Theme.dp;
    @children
}

// One of a few choices on the page itself (set2-navigation's modes): title, what it does, a radio on the right.
export component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> on;
    // a search result opened this row
    in property <bool> found;
    callback clicked;
    height: max(Theme.list-row-double-h, lay.preferred-height);
    background: t.pressed ? Theme.pressed : found ? Theme.selected : transparent;
    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    lay := HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin + 4 * Theme.dp;
        padding-top: 10 * Theme.dp;
        padding-bottom: 10 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3 * Theme.dp;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-body;
            }

            Text {
                text: root.subtitle;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2 * Theme.dp;
                border-color: root.on ? Theme.accent : Theme.text-dim;
                if root.on: Rectangle {
                    width: 10 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }
            }
        }
    }
}

// A navigation mode's little phone (set2-navigation): the screen, and where that mode's keys or edges are.
component ModeSketch inherits Rectangle {
    // 0 Buttons, 1 Gestures, 2 N9 gestures
    in property <int> mode;
    width: 40 * Theme.dp;
    height: 70 * Theme.dp;
    border-radius: 9 * Theme.dp;
    border-width: 2 * Theme.dp;
    border-color: #3a3f48;
    background: #05070b;
    clip: true;
    Rectangle {
        x: 4 * Theme.dp;
        y: 5 * Theme.dp;
        width: parent.width - 8 * Theme.dp;
        height: 2 * Theme.dp;
        border-radius: 1 * Theme.dp;
        background: #ffffff26;
    }
    Rectangle {
        x: 4 * Theme.dp;
        y: 10 * Theme.dp;
        width: parent.width - 8 * Theme.dp;
        height: 7 * Theme.dp;
        border-radius: 2 * Theme.dp;
        background: #ffffff1a;
    }
    // Buttons: the key row ← ⌂ ▢
    if mode == 0: Rectangle {
        y: parent.height - self.height - 2 * Theme.dp;
        height: 9 * Theme.dp;
        background: #ffffff14;
        HorizontalLayout {
            alignment: space-around;
            padding-left: 4 * Theme.dp;
            padding-right: 4 * Theme.dp;
            for k in 3: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 4 * Theme.dp;
                    height: self.width;
                    border-radius: k == 1 ? 2 * Theme.dp : 1 * Theme.dp;
                    background: #ffffffaa;
                }
            }
        }
    }
    // Gestures and N9: the handle, and the edges that act (blue Back; N9's right edge is Open apps)
    if mode != 0: Rectangle {
        x: 12 * Theme.dp;
        y: parent.height - 5 * Theme.dp;
        width: parent.width - 24 * Theme.dp;
        height: 2 * Theme.dp;
        border-radius: 1 * Theme.dp;
        background: #ffffffaa;
    }
    if mode != 0: Rectangle {
        x: 0;
        y: 20 * Theme.dp;
        width: 3 * Theme.dp;
        height: parent.height - 32 * Theme.dp;
        background: Theme.accent;
    }
    if mode != 0: Rectangle {
        x: parent.width - self.width;
        y: 20 * Theme.dp;
        width: 3 * Theme.dp;
        height: parent.height - 32 * Theme.dp;
        background: mode == 2 ? #f08c2e : Theme.accent;
    }
}

// A navigation mode as the board draws it (set2-navigation): a card with its sketch, name (and DEFAULT), what it does
// and a radio; the chosen one outlined in the accent.
export component ModeCard inherits Rectangle {
    in property <int> mode;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> on;
    in property <bool> is-default;
    // a search result opened this row
    in property <bool> found;
    callback clicked;
    height: max(86 * Theme.dp, lay.preferred-height);
    border-radius: 14 * Theme.dp;
    background: t.pressed || found ? Theme.pressed : Theme.card;
    border-width: max(1px, Theme.dp / 2);
    border-color: on ? Theme.accent : Theme.card-border;
    accessible-role: radio-button;
    accessible-checked: on;
    accessible-label: title;
    accessible-description: subtitle;
    accessible-action-default => { root.clicked(); }
    t := TouchArea {
        clicked => { root.clicked(); }
    }

    lay := HorizontalLayout {
        padding-left: 12 * Theme.dp;
        padding-right: 12 * Theme.dp;
        padding-top: 8 * Theme.dp;
        padding-bottom: 8 * Theme.dp;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            ModeSketch { mode: root.mode; }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3 * Theme.dp;
            HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                }
                if root.is-default: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18 * Theme.dp;
                        width: chip.preferred-width + 12 * Theme.dp;
                        border-radius: 6 * Theme.dp;
                        background: #3d8bfd1f;
                        chip := Text {
                            text: "DEFAULT";
                            color: Theme.accent;
                            font-size: 11 * Theme.dp;
                            font-weight: 600;
                        }
                    }
                }
            }

            Text {
                text: root.subtitle;
                color: Theme.text-secondary;
                font-size: Theme.font-status;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2 * Theme.dp;
                border-color: root.on ? Theme.accent : Theme.text-dim;
                if root.on: Rectangle {
                    width: 10 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }
            }
        }
    }
}

// The active sound profile (set2-sounds): its tile, name and summary in a card, and ✎ to change it.
export component ActiveCard inherits Rectangle {
    in property <string> name;
    in property <string> summary;
    callback edit;
    height: max(76 * Theme.dp, lay.preferred-height);
    border-radius: 14 * Theme.dp;
    background: Theme.card;
    border-width: max(1px, Theme.dp / 2);
    border-color: Theme.accent;
    lay := HorizontalLayout {
        padding-left: 14 * Theme.dp;
        padding-right: 14 * Theme.dp;
        padding-top: 12 * Theme.dp;
        padding-bottom: 12 * Theme.dp;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40 * Theme.dp;
                height: self.width;
                border-radius: 10 * Theme.dp;
                background: #e5484d;
                Image {
                    width: 24 * Theme.dp;
                    height: self.width;
                    source: @image-url("@neoui/icons/sys/options.svg");
                    colorize: white;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3 * Theme.dp;
            Text {
                text: "ACTIVE PROFILE";
                color: Theme.text-dim;
                font-size: 12 * Theme.dp;
                font-weight: 600;
                letter-spacing: 0.6 * Theme.dp;
            }
            Text {
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.summary;
                color: Theme.text-secondary;
                font-size: Theme.font-status;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: e.pressed ? Theme.pressed : #2a2e35;
                accessible-role: button;
                accessible-label: "Change " + root.name;
                accessible-action-default => { root.edit(); }
                Image {
                    width: 20 * Theme.dp;
                    height: self.width;
                    source: @image-url("@neoui/icons/sys/edit.svg");
                    colorize: white;
                }
                e := TouchArea {
                    clicked => { root.edit(); }
                }
            }
        }
    }
}
