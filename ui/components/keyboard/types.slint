// SPDX-License-Identifier: Apache-2.0
// One keyboard layout (one language) of the system keyboard: plain data, drawn by keyboard.slint.

// `rows` are the letter rows, top first, one string per key (what it types; shift types its upper case). "⇧" and
// "⌫" are shift and backspace: they may only start or end a row and share the width the letters leave. A row
// without them is centred. Every layout gets the same bottom row (symbols, globe, comma, space, stop, Enter).
export struct Layout {
    // ISO 639-1 code
    code: string,
    // shown in Settings (in English: the Settings font has no Armenian)
    name: string,
    // Settings' second line: the arrangement
    hint: string,
    // the font the keys are drawn in; it must have every letter (Inter has no Armenian)
    font: string,
    // the row width in key widths
    cols: float,
    rows: [[string]],
    // the symbols key's way back to letters ("ABC")
    abc: string,
    // the bottom row's punctuation
    comma: string,
    stop: string,
}

// What a pad key does: types its text, Backspace (8), Done (Enter, 13), or switches to the letter keyboard.
export enum KeyKind { char, backspace, done, switch }

// One key of a pad. `text` is what a char key types (empty: its label); `hint` is a small second line (a phone
// pad's letters).
export struct PadKey {
    label: string,
    hint: string,
    text: string,
    kind: KeyKind,
}

// A pad keyboard (proto::KEYBOARD modes 3 and up, listed in layouts.slint's `Pads`): plain data, drawn by
// keyboard.slint. `rows` are top first; the keys of a row share its width equally.
export struct Pad {
    name: string,
    rows: [[PadKey]],
}
