// SPDX-License-Identifier: Apache-2.0
// The system on-screen keyboard (NeoSymbian R6c; docs/neoui-shell.md, "Keyboard"): the UI server shows it over the
// bottom of an app that asks for it and sends what it types to that app as key events. The languages are data
// (layouts/, chosen in layouts.slint); this draws whichever is current, with a symbols layer, one-shot shift, a
// globe key when more than one language is on, and in terminal mode a row of Esc, Tab and arrows on top.
//
// Geometry, counted from the keyboard's bottom edge (crates/neoui-render/tests/keyboard.rs and symbian/taps.sh use
// it): row k (0 = the bottom row) is centred 27 + 48 k dp above the bottom, keys are 42 dp high. The bottom row is
// 10 units wide: symbols 0-1.5, globe 1.5-2.5, comma 2.5-3.5 (1.5 without a globe), space to 7.5, stop, Enter 8.5-10.
// The pads (modes 3 and up: number, phone; data in pads/) use the same rows, each row's keys sharing its width.
// Held keys (W1): Backspace and the arrows type at once, then again after 400 ms and about 15 times a second; a
// letter with alternates (a layout's `alts`) held 400 ms shows them over it (popup.slint), the finger slides to one
// and lets go to type it. The terminal row's Ctrl makes the next letter its control code. With `keyboard.suggest`
// the top band offers words for the one being typed (suggest.slint; the keyboard follows the word from its own keys).
import { Theme } from "../../theme.slint";
import { SystemSettings } from "../../system-settings.slint";
import { Layout, Pad, PadKey, KeyKind } from "types.slint";
import { Layouts, Pads } from "layouts.slint";
import { Common } from "layouts/common.slint";
import { KeyboardFocus } from "focus.slint";
import { AltPopup } from "popup.slint";
import { SuggestStrip } from "suggest.slint";

component Key inherits Rectangle {
    in property <string> label;
    // a small second line under the label (a phone pad's letters)
    in property <string> hint;
    in property <string> font: "NeoSans";
    // a function key: drawn darker
    in property <bool> special;
    in property <bool> lit;
    in property <image> icon;
    // types on the press, then repeats while held (Backspace, the arrows)
    in property <bool> repeat;
    // a long press offers alternates: `held` after 400 ms, then `slid` (the finger's x in the key) and `let-go`
    in property <bool> holdable;
    callback pressed-key;
    callback held(length);
    callback slid(length);
    // the long press ended: `pick` false when the touch was cancelled
    callback let-go(bool);
    // a repeating key let go after typing `n` times more
    callback repeated(int);
    property <bool> fired;
    property <int> reps;
    border-radius: Theme.radius-small;
    background: touch.pressed || lit ? #4a5160 : special ? #2a2e35 : #3a3f48;
    if label != "": Text {
        text: label;
        color: Theme.text;
        font-family: font;
        font-size: (label.character-count > 1 ? 14 : 19) * Theme.dp;
        horizontal-alignment: center;
        vertical-alignment: center;
        // with a hint the label sits higher and the hint under it
        y: hint == "" ? (parent.height - self.height) / 2 : 2 * Theme.dp;
    }
    if hint != "": Text {
        y: parent.height - 15 * Theme.dp;
        height: 12 * Theme.dp;
        text: hint;
        color: Theme.text-secondary;
        font-size: 9 * Theme.dp;
        horizontal-alignment: center;
    }
    if label == "": Image {
        width: 20 * Theme.dp;
        height: self.width;
        source: icon;
        colorize: Theme.text;
    }
    Timer {
        interval: root.reps > 0 ? 66ms : 400ms;
        running: root.repeat && touch.pressed;
        triggered => {
            root.reps += 1;
            root.pressed-key();
        }
    }

    Timer {
        interval: 400ms;
        running: root.holdable && touch.pressed && !root.fired;
        triggered => {
            root.fired = true;
            root.held(touch.mouse-x);
        }
    }

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.fired = false;
                root.reps = 0;
                if root.repeat {
                    root.pressed-key();
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if root.fired {
                    root.let-go(e.kind == PointerEventKind.up);
                }
                if root.reps > 0 {
                    root.repeated(root.reps);
                }
            }
        }
        moved => {
            if root.fired {
                root.slid(self.mouse-x);
            }
        }
        clicked => {
            if !root.repeat && !root.fired {
                root.pressed-key();
            }
        }
    }
}

// One row of keys `cols` wide: letters centred, or a shift / backspace at either end taking the width left over.
component KeyRow inherits Rectangle {
    in property <[string]> keys;
    in property <float> cols;
    in property <string> font;
    in property <bool> shift;
    // the layout's long-press alternates (none on the symbols layer)
    in property <[string]> alts;
    callback key(string);
    // a long press on key `k` (at `x`, `w` wide in the row) with the finger at `at` in the row: offer `items`
    callback held(string, [string], length, length, length);
    callback slid(length);
    callback let-go(bool);
    callback repeated(int);
    property <bool> lead: keys.length > 0 && (keys[0] == "⇧" || keys[0] == "⌫");
    property <bool> tail: keys.length > 1 && (keys[keys.length - 1] == "⇧" || keys[keys.length - 1] == "⌫");
    property <int> ends: (lead ? 1 : 0) + (tail ? 1 : 0);
    property <float> edge: ends == 0 ? 0 : (cols - (keys.length - ends)) / ends;
    property <float> start: ends == 0 ? (cols - keys.length) / 2 : (lead ? edge - 1 : 0);
    property <length> unit: self.width / cols;
    for k[i] in keys: Key {
        property <bool> end: (i == 0 && lead) || (i == keys.length - 1 && tail);
        x: (end ? (i == 0 ? 0 : cols - edge) : start + i) * unit + 3 * Theme.dp;
        width: (end ? edge : 1) * unit - 6 * Theme.dp;
        height: parent.height;
        label: shift && !end ? k.to-uppercase() : k;
        font: end ? "NeoSans" : root.font;
        special: end;
        lit: k == "⇧" && root.shift;
        repeat: k == "⌫";
        property <[string]> offer: end ? [] : Layouts.alternates(root.alts, k);
        holdable: self.offer.length > 0;
        pressed-key => {
            root.key(k);
        }
        held(at) => {
            root.held(k, self.offer, self.x, self.width, self.x + at);
        }
        slid(at) => {
            root.slid(self.x + at);
        }
        let-go(pick) => {
            root.let-go(pick);
        }
        repeated(n) => {
            root.repeated(n);
        }
    }
}

export component Keyboard inherits Rectangle {
    // proto::KEYBOARD's modes: 1 text, 2 terminal (the Esc / Tab / arrows row on top), 3 and up a pad (`Pads`:
    // 3 number, 4 phone); an unknown one is text
    in property <int> mode: 1;
    // what a key typed: a character, Backspace "\u{8}", Enter "\u{d}", or (terminal row) Escape, Tab, an arrow; the
    // edit bar's chords as Control "\u{11}" then the letter (neoapp turns the pair into Ctrl+letter)
    callback typed(string);
    // the edit bar on the top band, Select all · Copy · Paste (an app's text field: Slint's fields take the chords)
    in property <bool> edit-bar;
    property <bool> symbols;
    property <bool> shift;
    // the terminal row's Ctrl: the next letter is its control code
    property <bool> ctrl;
    // the word being typed with these keys, for suggestions (a touch elsewhere or another field ends it)
    property <string> word;
    // shortcut: an app's password field still gets suggestions (the protocol doesn't say which fields are secret); the
    // list is fixed, so nothing typed is kept, but the strip shows the start of the word: add a KEYBOARD flag
    property <bool> secret: KeyboardFocus.open && KeyboardFocus.secret;
    property <[string]> words: SystemSettings.keyboard-suggest && mode == 1 && !pad-on && !secret && word != "" ? Layouts.suggest(layout.code, word) : [];
    // a long press's alternates: what it offers, the one picked, where (the popup's left, the row's top) and how wide
    property <[string]> pop;
    property <int> pop-at;
    property <length> pop-x;
    property <length> pop-y;
    property <length> pop-cell;
    property <int> seq: KeyboardFocus.seq;
    property <int> outside: KeyboardFocus.outside;
    changed seq => {
        word = "";
    }
    changed outside => {
        word = "";
    }
    property <Layout> layout: Layouts.all[Layouts.current];
    // all languages as tall as the tallest one on: a shorter one gets the digit row on top
    property <bool> digits: SystemSettings.keyboard-same-height && layout.rows.length < Layouts.tallest;
    property <int> rows: layout.rows.length + (digits ? 1 : 0);
    property <length> pitch: 48 * Theme.dp;
    // the top band with the hide key (docs neoui-shell/navigation.md: the keyboard covers the strip and puts itself away)
    property <length> bar: 30 * Theme.dp;
    // out: the height in each mode, for the UI server to tell apps (it changes with the language and settings)
    out property <length> text-h: bar + 6 * Theme.dp + (rows + 1) * pitch;
    out property <length> term-h: text-h + pitch;
    out property <length> number-h: pad-h(Pads.all[0]);
    out property <length> phone-h: pad-h(Pads.all[1]);
    // a pad's switch key showed the letters (its symbols key goes back)
    // shortcut: the height then is the text keyboard's while the server still has the pad's; no pad has a switch key
    property <bool> letters;
    property <bool> pad-on: mode >= 3 && mode < 3 + Pads.all.length && !letters;
    property <[[PadKey]]> pad: pad-on ? Pads.all[mode - 3].rows : [];
    height: mode == 2 ? term-h : pad-on ? bar + 6 * Theme.dp + pad.length * pitch : text-h;
    changed mode => {
        letters = false;
        ctrl = false;
        word = "";
    }
    background: #16181c;
    init => {
        KeyboardFocus.text-h = self.text-h;
    }
    changed text-h => {
        KeyboardFocus.text-h = self.text-h;
    }

    pure function pad-h(p: Pad) -> length {
        bar + 6 * Theme.dp + p.rows.length * pitch
    }

    // the language changed: start in its letters, lower case
    changed layout => {
        symbols = false;
        shift = false;
        word = "";
    }

    // types `t` and follows the word it makes
    function emit(t: string) {
        typed(t);
        word = Layouts.word-after(word, t);
    }

    function press(k: string) {
        if k == "⇧" {
            shift = !shift;
            return;
        }
        if ctrl && mode == 2 {
            ctrl = false;
            if Layouts.control(k) != "" {
                emit(Layouts.control(k));
                KeyboardFocus.logged("ctrl");
                shift = false;
                return;
            }
        }
        emit(k == "⌫" ? "\u{8}" : shift ? k.to-uppercase() : k);
        shift = false;
    }

    // a long press on a key `w` wide at `x` of a row whose top is `y`: the popup starts over it and stays on the
    // keyboard; `at` is the finger
    function open-pop(items: [string], x: length, y: length, w: length, at: length) {
        pop = items;
        pop-cell = w;
        pop-x = max(0px, min(x, root.width - items.length * w - 6 * Theme.dp));
        pop-y = max(0px, y - 50 * Theme.dp);
        slide-pop(at);
    }

    function slide-pop(at: length) {
        pop-at = max(0, min(pop.length - 1, floor((at - pop-x - 3 * Theme.dp) / pop-cell)));
    }

    function close-pop(pick: bool) {
        if pick && pop.length > 0 {
            emit(shift ? pop[pop-at].to-uppercase() : pop[pop-at]);
            KeyboardFocus.logged("alternate " + (pop-at + 1) + " of " + pop.length);
            shift = false;
        }
        pop = [];
    }

    function pad-press(k: PadKey) {
        if k.kind == KeyKind.backspace {
            typed("\u{8}");
        } else if k.kind == KeyKind.done {
            typed("\u{d}");
        } else if k.kind == KeyKind.switch {
            letters = true;
        } else {
            typed(k.text != "" ? k.text : k.label);
        }
    }

    function log-repeats(n: int) {
        KeyboardFocus.logged("repeat " + n);
    }

    // a swipe down on the top band puts the keyboard away too (Navigation v2 D20); on the band only, so the keys
    // keep their taps without the swipe handler's delay
    edit := HorizontalLayout {
        x: 4 * Theme.dp;
        y: 0;
        height: bar;
        width: root.edit-bar && words.length == 0 ? self.preferred-width : 0;
        visible: root.edit-bar && words.length == 0;
        for item[i] in ["Select all", "Copy", "Paste"]: Rectangle {
            width: label.preferred-width + 20 * Theme.dp;
            background: t.pressed ? Theme.pressed : transparent;
            border-radius: Theme.radius-small;
            label := Text {
                text: item;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
            }

            t := TouchArea {
                clicked => {
                    root.typed("\u{11}" + (i == 0 ? "a" : i == 1 ? "c" : "v"));
                }
            }
        }
    }

    SwipeGestureHandler {
        x: edit.width + edit.x;
        y: 0;
        width: root.width - 64 * Theme.dp - self.x;
        height: bar;
        handle-swipe-down: true;
        swiped => {
            if self.current-position.y - self.pressed-position.y > 24 * Theme.dp {
                KeyboardFocus.dismissed = true;
            }
        }
    }

    // the suggestions take the band left of the hide key (and the edit bar's place)
    if words.length > 0: SuggestStrip {
        x: 4 * Theme.dp;
        y: 0;
        width: root.width - 64 * Theme.dp - self.x;
        height: bar;
        words: root.words;
        font: layout.font;
        picked(w) => {
            root.typed(Layouts.replacement(root.word, w));
            KeyboardFocus.logged("suggestion");
            root.word = "";
            root.shift = false;
        }
    }

    // the hide key, at the right of the top band
    Rectangle {
        x: root.width - self.width;
        y: 0;
        width: 64 * Theme.dp;
        height: bar;
        background: hide.pressed ? Theme.pressed : transparent;
        Image {
            source: @image-url("../../icons/sys/chevron_down.svg");
            width: 22 * Theme.dp;
            height: self.width;
            colorize: Theme.text-secondary;
        }

        hide := TouchArea {
            clicked => {
                KeyboardFocus.dismissed = true;
            }
        }
    }

    // the top y of row k, counted up from the bottom row (0)
    pure function row-y(k: int) -> length {
        root.height - (k + 1) * pitch
    }

    if mode == 2: Rectangle {
        y: row-y(rows + 1);
        height: 42 * Theme.dp;
        for t[i] in Common.terminal: Key {
            x: i * root.width / Common.terminal.length + 3 * Theme.dp;
            width: root.width / Common.terminal.length - 6 * Theme.dp;
            label: t.label;
            special: true;
            repeat: t.repeat;
            lit: t.text == "" && root.ctrl;
            pressed-key => {
                if t.text == "" {
                    root.ctrl = !root.ctrl;
                } else {
                    root.typed(t.text);
                }
            }
            repeated(n) => {
                root.log-repeats(n);
            }
        }
    }

    for row[r] in pad: Rectangle {
        y: row-y(pad.length - 1 - r);
        height: 42 * Theme.dp;
        for k[i] in row: Key {
            x: i * root.width / row.length + 3 * Theme.dp;
            width: root.width / row.length - 6 * Theme.dp;
            label: k.kind == KeyKind.backspace ? "" : k.label;
            hint: k.hint;
            icon: @image-url("../../icons/sys/backspace.svg");
            special: k.kind != KeyKind.char;
            repeat: k.kind == KeyKind.backspace;
            pressed-key => {
                root.pad-press(k);
            }
            repeated(n) => {
                root.log-repeats(n);
            }
        }
    }

    if digits && !symbols && !pad-on: KeyRow {
        y: row-y(rows);
        height: 42 * Theme.dp;
        keys: Common.digits;
        cols: 10;
        font: "NeoSans";
        key(k) => { root.press(k); }
    }

    for row[r] in pad-on ? [] : symbols ? Common.symbols : layout.rows: KeyRow {
        y: row-y((symbols ? Common.symbols.length : layout.rows.length) - r);
        height: 42 * Theme.dp;
        keys: row;
        cols: symbols ? 10 : layout.cols;
        font: symbols ? "NeoSans" : layout.font;
        shift: root.shift && !symbols;
        alts: symbols ? [] : layout.alts;
        key(k) => { root.press(k); }
        held(k, items, x, w, at) => { root.open-pop(items, x, self.y, w, at); }
        slid(at) => { root.slide-pop(at); }
        let-go(pick) => { root.close-pop(pick); }
        repeated(n) => { root.log-repeats(n); }
    }

    // the bottom row, the same in every language
    if !pad-on: Rectangle {
        y: row-y(0);
        height: 42 * Theme.dp;
        property <length> unit: root.width / 10;
        property <float> globe: Layouts.many ? 1 : 0;
        Key {
            x: 3 * Theme.dp;
            width: 1.5 * unit - 6 * Theme.dp;
            label: letters ? "123" : symbols ? layout.abc : "?123";
            font: layout.font;
            special: true;
            pressed-key => {
                if root.letters {
                    root.letters = false;
                } else {
                    root.symbols = !root.symbols;
                }
                root.shift = false;
            }
        }
        if Layouts.many: Key {
            x: 1.5 * unit + 3 * Theme.dp;
            width: unit - 6 * Theme.dp;
            icon: @image-url("../../icons/sys/language.svg");
            special: true;
            pressed-key => {
                Layouts.next();
            }
        }
        Key {
            x: (1.5 + globe) * unit + 3 * Theme.dp;
            width: unit - 6 * Theme.dp;
            label: layout.comma;
            font: layout.font;
            pressed-key => { root.press(layout.comma); }
        }
        Key {
            x: (2.5 + globe) * unit + 3 * Theme.dp;
            width: (5 - globe) * unit - 6 * Theme.dp;
            label: "space";
            pressed-key => { root.press(" "); }
        }
        Key {
            x: 7.5 * unit + 3 * Theme.dp;
            width: unit - 6 * Theme.dp;
            label: layout.stop;
            font: layout.font;
            pressed-key => { root.press(layout.stop); }
        }
        Key {
            x: 8.5 * unit + 3 * Theme.dp;
            width: 1.5 * unit - 6 * Theme.dp;
            label: "⏎";
            special: true;
            pressed-key => {
                root.emit("\u{d}");
                root.shift = false;
            }
        }
    }

    // over every row: a long press's alternates
    if pop.length > 0: AltPopup {
        x: root.pop-x;
        y: root.pop-y;
        items: root.pop;
        upper: root.shift;
        picked: root.pop-at;
        cell: root.pop-cell;
        font: layout.font;
    }
}
