// The rows every language shares: the symbols layer (what ESHELL paths and commands need), the digit row that
// pads shorter layouts when all have the same height, and the terminal row (keyboard mode 2, with Ctrl since W1).

export global Common {
    out property <[[string]]> symbols: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["-", "/", "\\", ":", ";", "(", ")", "*", "\"", "'"],
        ["_", "+", "=", "&", "@", "%", "<", ">", "#", "⌫"],
    ];
    out property <[string]> digits: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
    // label, what it types and whether it repeats while held: Escape, Ctrl (no text: the next key's control code),
    // Tab, and Symbian's arrow key codes (EKeyLeftArrow 0xF807 ... Down 0xF80A)
    out property <[{ label: string, text: string, repeat: bool }]> terminal: [
        { label: "Esc", text: "\u{1b}", repeat: false },
        { label: "Ctrl", text: "", repeat: false },
        { label: "Tab", text: "\u{9}", repeat: false },
        { label: "←", text: "\u{f807}", repeat: true },
        { label: "↑", text: "\u{f809}", repeat: true },
        { label: "↓", text: "\u{f80a}", repeat: true },
        { label: "→", text: "\u{f808}", repeat: true },
    ];
}
