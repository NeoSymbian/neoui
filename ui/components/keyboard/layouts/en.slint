// English: US QWERTY.
import { Layout } from "../types.slint";

export global En {
    out property <Layout> layout: {
        code: "en",
        name: "English",
        hint: "QWERTY",
        font: "Inter",
        cols: 10,
        rows: [
            ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
            ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
            ["⇧", "z", "x", "c", "v", "b", "n", "m", "⌫"],
        ],
        abc: "ABC",
        comma: ",",
        stop: ".",
    };
}
