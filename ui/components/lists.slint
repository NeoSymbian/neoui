// List building blocks: avatar, row, section header, switch (kit-lists).
import { Theme } from "../theme.slint";
import { Glyph } from "frame.slint";

export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint: Theme.accent;
    in property <length> size: Theme.avatar;
    width: size;
    height: size;
    border-radius: size / 2;
    // solid: the software renderer does not round a gradient's corners
    background: tint;
    Text {
        text: initials;
        color: white;
        font-size: size * 0.38;
        font-weight: 600;
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 46 * Theme.dp;
    height: 28 * Theme.dp;
    border-radius: self.height / 2;
    background: on ? Theme.accent : #3a3f47;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: on ? parent.width - self.width - 3 * Theme.dp : 3 * Theme.dp;
        width: parent.height - 6 * Theme.dp;
        height: self.width;
        border-radius: self.width / 2;
        background: white;
        animate x { duration: Theme.fast; easing: ease-out-quad; }
    }

    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

export component SectionHeader inherits Rectangle {
    in property <string> text;
    // a short state beside the section's own action, at the right ("Searching…")
    in property <string> action-text;
    // room kept free at the right for that action (an icon button the page draws)
    in property <length> action-room;
    height: Theme.section-h;
    if root.action-text != "": Text {
        x: parent.width - self.width - Theme.margin - 4 * Theme.dp - root.action-room;
        y: parent.height - self.height - 6 * Theme.dp;
        text: root.action-text;
        color: Theme.text-dim;
        font-size: Theme.font-status;
    }
    Text {
        x: Theme.margin + 4 * Theme.dp;
        y: parent.height - self.height - 6 * Theme.dp;
        text: root.text.to-uppercase();
        color: Theme.text-dim;
        font-size: Theme.font-status * 0.92;
        font-weight: 600;
        letter-spacing: 0.06 * Theme.font-status;
    }
}

// One row: leading glyph or avatar, one or two lines, trailing value / chevron / switch.
export component ListRow inherits Rectangle {
    in property <string> title;
    // the title's font ("" = the window's): "DejaVu Sans" for text a user typed in any keyboard language
    in property <string> title-font;
    in property <string> subtitle;
    in property <string> value;
    in property <image> icon;
    in property <bool> has-icon;
    in property <color> icon-tint: Theme.text;
    in property <string> avatar;  // initials; "" = no avatar
    in property <color> avatar-tint: Theme.accent;
    in property <bool> chevron;
    in property <bool> has-switch;
    in-out property <bool> switch-on;
    in property <bool> unread;
    in property <bool> divider: true;
    // a destructive action (Clear data, Stop app): the title in red
    in property <bool> danger;
    // the trailing value in the brighter secondary colour (Settings' values)
    in property <bool> value-bright;
    // the icon on a coloured rounded tile (Settings' drive and page rows); transparent = a bare glyph
    in property <color> tile: transparent;
    // a small pill button at the right (Forget); its tap is pill-clicked, not clicked
    in property <string> pill;
    in property <bool> pill-danger: true;
    callback pill-clicked;
    // room kept free at the right (a letter strip beside the list)
    in property <length> trailing-room;
    callback clicked;
    // the trailing switch was flipped by a tap (`switch-on` holds the new state)
    callback switch-toggled(bool);
    // selection mode (K03): every row shows a check circle; a tap toggles (the app's clicked handler decides)
    in property <bool> selecting;
    in property <bool> checked;
    // held 500 ms without moving: starts selection mode, or opens a long-press Menu (at the finger: long-x, long-y)
    callback long-pressed();
    out property <length> long-x: touch.pressed-x;
    out property <length> long-y: touch.pressed-y;
    property <bool> long-fired;
    height: subtitle == "" ? Theme.list-row-h : Theme.list-row-double-h;
    background: touch.pressed ? Theme.pressed : checked ? Theme.selected : transparent;
    touch := TouchArea {
        changed pressed => {
            if self.pressed {
                root.long-fired = false;
            }
        }
        clicked => {
            if !root.long-fired {
                root.clicked();
            }
        }
    }

    Timer {
        interval: 500ms;
        running: touch.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.long-pressed();
        }
    }

    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin + 4 * Theme.dp + root.trailing-room;
        spacing: 14 * Theme.dp;
        if selecting: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: checked ? Theme.accent : transparent;
                border-width: checked ? 0 : 2 * Theme.dp;
                border-color: Theme.text-dim;
                if checked: Glyph {
                    source: @image-url("../icons/sys/check.svg");
                    size: 16 * Theme.dp;
                    colorize: white;
                }
            }
        }
        if avatar != "": VerticalLayout {
            alignment: center;
            Avatar {
                initials: avatar;
                tint: avatar-tint;
            }
        }
        if has-icon && root.tile == transparent: VerticalLayout {
            alignment: center;
            Glyph {
                source: icon;
                colorize: icon-tint;
            }
        }
        if has-icon && root.tile != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.row-tile;
                height: self.width;
                border-radius: 8 * Theme.dp;
                background: root.tile;
                Glyph {
                    source: icon;
                    size: 18 * Theme.dp;
                    colorize: white;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            Text {
                text: title;
                font-family: title-font;
                color: root.danger ? Theme.danger : Theme.text;
                font-size: Theme.font-body;
                font-weight: unread ? 700 : 500;
                overflow: elide;
            }

            if subtitle != "": Text {
                text: subtitle;
                color: unread ? Theme.text-secondary : Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        if value != "": VerticalLayout {
            alignment: center;
            Text {
                text: value;
                color: unread ? Theme.accent : root.value-bright ? Theme.text-secondary : Theme.text-dim;
                font-size: root.value-bright ? Theme.font-value : Theme.font-label;
                horizontal-alignment: right;
            }
        }
        if root.pill != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 36 * Theme.dp;
                width: pill-text.preferred-width + 28 * Theme.dp;
                border-radius: self.height / 2;
                background: pill-touch.pressed ? Theme.pressed : Theme.pill;
                pill-text := Text {
                    text: root.pill;
                    color: root.pill-danger ? Theme.danger : Theme.text;
                    font-size: Theme.font-value;
                    font-weight: 600;
                }
                pill-touch := TouchArea {
                    clicked => {
                        root.pill-clicked();
                    }
                }
            }
        }
        if unread: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.accent;
            }
        }
        if has-switch: VerticalLayout {
            alignment: center;
            Switch {
                on <=> root.switch-on;
                toggled(on) => {
                    root.switch-toggled(on);
                }
            }
        }
        if chevron: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/chevron_right.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
    }

    if divider: Rectangle {
        x: Theme.margin + 4 * Theme.dp + (selecting ? 38 * Theme.dp : 0) + (avatar != "" ? Theme.avatar + 14 * Theme.dp : (has-icon ? (root.tile != transparent ? Theme.row-tile : Theme.row-icon) + 14 * Theme.dp : 0));
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }
}
