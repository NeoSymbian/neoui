// The frame every screen shares: status bar, bottom toolbar, title bar.
import { Theme } from "../theme.slint";

export component Glyph inherits Image {
    in property <length> size: Theme.row-icon;
    width: size;
    height: size;
    colorize: Theme.text;
}

export component StatusBar inherits Rectangle {
    in property <string> title;
    in property <int> battery-percent: -1;
    in property <string> battery-text: "--%";
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    in property <bool> shade-open;
    in property <string> time: "10:24";
    // the modem (telephony C5): bars 0..4, -1 = no modem (the plain signal icon); the operator shows where the title
    // is empty (home), the radio technology ("LTE", "3G", "2G") before the bars
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    // Wi-Fi bars 0..4 while connected, -1 = not connected (no icon)
    in property <int> wifi-bars: -1;
    callback tapped;
    height: Theme.status-h;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        spacing: 6 * Theme.dp;
        Text {
            text: title != "" ? title : operator;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
        if bars >= 0 && rat != "": Text {
            text: rat;
            color: Theme.text;
            font-size: Theme.font-status * 0.8;
            font-weight: 600;
            vertical-alignment: center;
        }
        if bars >= 0: HorizontalLayout {
            spacing: 1.5 * Theme.dp;
            alignment: center;
            for i in 4: VerticalLayout {
                alignment: end;
                Rectangle {
                    width: 3 * Theme.dp;
                    height: Theme.status-icon * (i + 1) / 4;
                    border-radius: 1 * Theme.dp;
                    background: i < bars ? Theme.text : Theme.text-dim;
                    opacity: i < bars ? 1 : 0.4;
                }
            }
        }
        if bars < 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/signal.svg");
                size: Theme.status-icon;
            }
        }
        if wifi-bars >= 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/wifi.svg");
                size: Theme.status-icon;
                colorize: wifi-bars >= 2 ? Theme.text : Theme.text-secondary;
            }
        }
        if battery-connected: VerticalLayout {
            alignment: center;
            Glyph { source: @image-url("../icons/sys/plug.svg"); size: 10 * Theme.dp; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22 * Theme.dp;
                height: 11 * Theme.dp;
                border-width: 1 * Theme.dp;
                border-color: battery-percent < 0 ? Theme.text-dim : Theme.text;
                border-radius: 2 * Theme.dp;
                background: transparent;
                Rectangle {
                    x: 2 * Theme.dp; y: 2 * Theme.dp;
                    width: max(0, min(100, battery-percent)) / 100 * 18 * Theme.dp;
                    height: 7 * Theme.dp;
                    background: battery-charging || battery-full ? #22b46a : Theme.text;
                    opacity: battery-charging || battery-full ? 0.4 : 1;
                }
                if battery-charging || battery-full: Glyph {
                    source: battery-charging ? @image-url("../icons/sys/charging.svg") : @image-url("../icons/sys/check.svg");
                    x: 5 * Theme.dp; y: -0.5 * Theme.dp;
                    size: 12 * Theme.dp;
                }
            }
        }
        Text {
            text: battery-text;
            color: battery-charging || battery-full ? #22b46a : Theme.text;
            font-size: Theme.font-status * 0.8;
            vertical-alignment: center;
        }
        Text {
            text: time;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.tapped();
        }
    }
}

export component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: Theme.toolbar-button-w;
    height: Theme.toolbar-h;
    background: touch.pressed && enabled ? Theme.pressed : transparent;
    opacity: enabled ? 1 : 0;
    Glyph {
        source: icon;
        size: Theme.toolbar-icon;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Back on the left, an optional action in the middle, Options on the right (Belle's toolbar).
export component Toolbar inherits Rectangle {
    in property <image> action-icon;
    in property <bool> has-action;
    callback back;
    callback action;
    callback options;
    height: Theme.toolbar-h;
    background: @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
    Rectangle {
        y: 0;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }

    HorizontalLayout {
        alignment: space-between;
        ToolbarButton {
            icon: @image-url("../icons/sys/back.svg");
            clicked => {
                root.back();
            }
        }

        ToolbarButton {
            icon: action-icon;
            enabled: has-action;
            clicked => {
                root.action();
            }
        }

        ToolbarButton {
            icon: @image-url("../icons/sys/options.svg");
            clicked => {
                root.options();
            }
        }
    }
}

// A screen's heading: large title, optional subtitle.
export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: Theme.title-h;
    VerticalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin;
        alignment: center;
        Text {
            text: title;
            color: Theme.text;
            font-size: Theme.font-title * 1.15;
            font-weight: 700;
            overflow: elide;
        }

        if subtitle != "": Text {
            text: subtitle;
            color: Theme.text-dim;
            font-size: Theme.font-label;
            overflow: elide;
        }
    }
}
