// The frame every screen shares (Navigation v2): the status bar, and the bottom: the key row (Buttons) or the gesture
// band (Gestures, N9). The app's header and footer are the kit's (header.slint, footer.slint).
import { Theme } from "../theme.slint";

export component Glyph inherits Image {
    in property <length> size: Theme.row-icon;
    width: size;
    height: size;
    colorize: Theme.text;
}

// The status bar (rule 01): the clock at the left, the network's name where v1 had the title (the operator, "No SIM",
// "SOS only", "Airplane mode"...), then the radio technology and its bars (R when roaming), unread messages, Wi-Fi
// and the battery. No title (D16): the app's header names the page.
export component StatusBar inherits Rectangle {
    in property <int> battery-percent: -1;
    in property <string> battery-text: "--%";
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    in property <bool> shade-open;
    in property <string> time: "10:24";
    // the modem (telephony C5): bars 0..4, -1 = no modem (the plain signal icon); the network's name; the radio
    // technology ("LTE", "3G", "2G") right before the bars
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    in property <bool> roaming;
    // Wi-Fi bars 0..4 while connected, -1 = not connected (no icon); its band ("2.4", "5") as a small label
    in property <int> wifi-bars: -1;
    in property <string> wifi-band;
    in property <bool> unread;
    callback tapped;
    // a swipe down on the bar (the shade opens)
    callback pulled;
    height: Theme.status-h;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        spacing: 6 * Theme.dp;
        Text {
            text: time;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: operator;
            color: Theme.text-secondary;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
        // the radio technology and its bars as one cluster: fixed widths, so the title takes all the spare room
        if bars >= 0: HorizontalLayout {
            spacing: 3 * Theme.dp;
            horizontal-stretch: 0;
            if rat != "": Text {
                text: rat;
                color: Theme.text;
                font-size: Theme.font-status * 0.8;
                font-weight: 600;
                vertical-alignment: center;
            }
            if roaming: Text {
                text: "R";
                color: Theme.warn;
                font-size: Theme.font-status * 0.8;
                font-weight: 700;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    width: 16.5 * Theme.dp;
                    height: Theme.status-icon;
                    spacing: 1.5 * Theme.dp;
                    for i in 4: VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: 3 * Theme.dp;
                            height: Theme.status-icon * (i + 1) / 4;
                            border-radius: 1 * Theme.dp;
                            background: i < bars ? Theme.text : Theme.text-dim;
                            opacity: i < bars ? 1 : 0.4;
                        }
                    }
                }
            }
        }
        if bars < 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/signal.svg");
                size: Theme.status-icon;
            }
        }
        // unread messages (C9): an envelope until they are read
        if unread: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/message.svg");
                size: Theme.status-icon;
                colorize: Theme.text;
            }
        }
        if wifi-bars >= 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.status-icon + (wifi-band != "" ? 5 * Theme.dp : 0);
                height: Theme.status-icon;
                Glyph {
                    x: 0;
                    y: 0;
                    source: @image-url("../icons/sys/wifi.svg");
                    size: Theme.status-icon;
                    colorize: wifi-bars >= 2 ? Theme.text : Theme.text-secondary;
                }
                if wifi-band != "": Text {
                    x: parent.width - self.width;
                    y: parent.height - self.height + 2 * Theme.dp;
                    text: wifi-band;
                    color: Theme.text;
                    font-size: 7 * Theme.dp;
                    font-weight: 700;
                }
            }
        }
        // the battery as one widget: the fill's colour is the level (red, orange, green), and inside it the percent on
        // battery, a bolt when plugged in (dim while the charger idles), or a check when full on USB
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                Rectangle {
                    width: 28 * Theme.dp;
                    height: 13 * Theme.dp;
                    border-width: 1 * Theme.dp;
                    border-color: battery-percent < 0 ? Theme.text-dim : Theme.text-secondary;
                    border-radius: 3 * Theme.dp;
                    clip: true;
                    if battery-percent >= 0: Rectangle {
                        x: 0;
                        y: 0;
                        width: min(100, battery-percent) / 100 * parent.width;
                        height: parent.height;
                        background: battery-percent <= Theme.battery-low ? Theme.danger
                            : battery-percent <= Theme.battery-mid ? Theme.warn : Theme.ok;
                    }
                    // plugged in: a bolt, bright while charging, dim while the charger idles
                    if (battery-charging || battery-connected) && !battery-full: Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/sys/charging.svg");
                        size: 11 * Theme.dp;
                        colorize: battery-charging ? Theme.text : Theme.text-dim;
                    }
                    if battery-full && !battery-charging: Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/sys/check.svg");
                        size: 11 * Theme.dp;
                    }
                    if !battery-charging && !battery-connected && !battery-full: Text {
                        width: parent.width;
                        height: parent.height;
                        text: battery-percent < 0 ? "--" : "\{battery-percent}";
                        color: battery-percent < 0 ? Theme.text-dim : Theme.text;
                        font-size: 9 * Theme.dp;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 2 * Theme.dp;
                        height: 5 * Theme.dp;
                        border-radius: 1 * Theme.dp;
                        background: battery-percent < 0 ? Theme.text-dim : Theme.text-secondary;
                    }
                }
            }
        }
    }

    TouchArea {
        property <bool> was-pulled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.was-pulled = false;
            }
        }
        moved => {
            if !self.was-pulled && self.mouse-y - self.pressed-y > 24 * Theme.dp {
                self.was-pulled = true;
                root.pulled();
            }
        }
        clicked => {
            if !self.was-pulled {
                root.tapped();
            }
        }
    }
}

// One of the key row's keys: a 72 dp target, a 26 dp white glyph, dimmed when there is nowhere for it to go.
component Key inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> dim;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        width: 72 * Theme.dp;
        background: touch.pressed ? Theme.pressed : transparent;
        border-radius: Theme.radius;
    }

    Glyph {
        source: icon;
        size: Theme.toolbar-icon;
        opacity: dim ? Theme.disabled : 1;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Buttons mode's bottom (rule 06, D12): system keys only, ← ⌂ ▢ in thirds. ← dims on home; with the keyboard up it
// becomes ˅ and puts the keyboard away (rule 14). No edge gestures in this mode (D18).
export component KeyRow inherits Rectangle {
    in property <bool> can-back;
    in property <bool> keyboard;
    callback back;
    callback home;
    callback apps;
    height: Theme.key-row-h;
    background: @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
    Rectangle {
        y: 0;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }

    HorizontalLayout {
        Key {
            icon: root.keyboard ? @image-url("../icons/sys/chevron_down.svg") : @image-url("../icons/sys/back.svg");
            label: root.keyboard ? "Hide keyboard" : "Back";
            dim: !root.can-back && !root.keyboard;
            clicked => {
                root.back();
            }
        }

        Key {
            icon: @image-url("../icons/sys/home.svg");
            label: "Home";
            clicked => {
                root.home();
            }
        }

        Key {
            icon: @image-url("../icons/sys/tabs.svg");
            label: "Open apps";
            clicked => {
                root.apps();
            }
        }
    }
}

// Gestures and N9's bottom (D17): a 16 dp band with the handle; the gestures start at the screen's edges.
export component Band inherits Rectangle {
    height: Theme.band-h;
    background: Theme.bg;
    Rectangle {
        width: 108 * Theme.dp;
        height: 4 * Theme.dp;
        border-radius: 2 * Theme.dp;
        background: Theme.handle;
    }
}
