// The frame every screen shares: status bar, bottom toolbar, title bar.
import { Theme } from "../theme.slint";

export component Glyph inherits Image {
    in property <length> size: Theme.row-icon;
    width: size;
    height: size;
    colorize: Theme.text;
}

export component StatusBar inherits Rectangle {
    in property <string> title;
    in property <int> battery-percent: -1;
    in property <string> battery-text: "--%";
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    in property <bool> shade-open;
    in property <string> time: "10:24";
    // the modem (telephony C5): bars 0..4, -1 = no modem (the plain signal icon); the operator shows where the title
    // is empty (home), the radio technology ("LTE", "3G", "2G") right before the bars
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    // Wi-Fi bars 0..4 while connected, -1 = not connected (no icon); its band ("2.4", "5") as a small label
    in property <int> wifi-bars: -1;
    in property <string> wifi-band;
    in property <bool> unread;
    // sideways pages (Phone | Contacts): dots beside the title, `dot` of `dots` lit (docs gestures.md rule 11)
    in property <int> dots;
    in property <int> dot;
    callback tapped;
    // a swipe down on the bar (the shade opens)
    callback pulled;
    height: Theme.status-h;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        spacing: 6 * Theme.dp;
        Text {
            text: title != "" ? title : operator;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: dots > 1 ? 0 : 1;
            min-width: 0px;
            overflow: elide;
        }
        if dots > 1: HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 4 * Theme.dp;
            padding-left: 2 * Theme.dp;
            for i in dots: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 5 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: i == dot ? Theme.text : Theme.text-dim;
            }
        }
        // the radio technology and its bars as one cluster: fixed widths, so the title takes all the spare room
        if bars >= 0: HorizontalLayout {
            spacing: 3 * Theme.dp;
            horizontal-stretch: 0;
            if rat != "": Text {
                text: rat;
                color: Theme.text;
                font-size: Theme.font-status * 0.8;
                font-weight: 600;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    width: 16.5 * Theme.dp;
                    height: Theme.status-icon;
                    spacing: 1.5 * Theme.dp;
                    for i in 4: VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: 3 * Theme.dp;
                            height: Theme.status-icon * (i + 1) / 4;
                            border-radius: 1 * Theme.dp;
                            background: i < bars ? Theme.text : Theme.text-dim;
                            opacity: i < bars ? 1 : 0.4;
                        }
                    }
                }
            }
        }
        if bars < 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/signal.svg");
                size: Theme.status-icon;
            }
        }
        // unread messages (C9): an envelope until they are read
        if unread: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/message.svg");
                size: Theme.status-icon;
                colorize: Theme.text;
            }
        }
        if wifi-bars >= 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.status-icon + (wifi-band != "" ? 5 * Theme.dp : 0);
                height: Theme.status-icon;
                Glyph {
                    x: 0;
                    y: 0;
                    source: @image-url("../icons/sys/wifi.svg");
                    size: Theme.status-icon;
                    colorize: wifi-bars >= 2 ? Theme.text : Theme.text-secondary;
                }
                if wifi-band != "": Text {
                    x: parent.width - self.width;
                    y: parent.height - self.height + 2 * Theme.dp;
                    text: wifi-band;
                    color: Theme.text;
                    font-size: 7 * Theme.dp;
                    font-weight: 700;
                }
            }
        }
        // the battery as one widget: the fill's colour is the level (red, orange, green), and inside it the percent on
        // battery, a bolt when plugged in (dim while the charger idles), or a check when full on USB
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                Rectangle {
                    width: 28 * Theme.dp;
                    height: 13 * Theme.dp;
                    border-width: 1 * Theme.dp;
                    border-color: battery-percent < 0 ? Theme.text-dim : Theme.text-secondary;
                    border-radius: 3 * Theme.dp;
                    clip: true;
                    if battery-percent >= 0: Rectangle {
                        x: 0;
                        y: 0;
                        width: min(100, battery-percent) / 100 * parent.width;
                        height: parent.height;
                        background: battery-percent <= Theme.battery-low ? Theme.danger
                            : battery-percent <= Theme.battery-mid ? Theme.warn : Theme.ok;
                    }
                    // plugged in: a bolt, bright while charging, dim while the charger idles
                    if (battery-charging || battery-connected) && !battery-full: Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/sys/charging.svg");
                        size: 11 * Theme.dp;
                        colorize: battery-charging ? Theme.text : Theme.text-dim;
                    }
                    if battery-full && !battery-charging: Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/sys/check.svg");
                        size: 11 * Theme.dp;
                    }
                    if !battery-charging && !battery-connected && !battery-full: Text {
                        width: parent.width;
                        height: parent.height;
                        text: battery-percent < 0 ? "--" : "\{battery-percent}";
                        color: battery-percent < 0 ? Theme.text-dim : Theme.text;
                        font-size: 9 * Theme.dp;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 2 * Theme.dp;
                        height: 5 * Theme.dp;
                        border-radius: 1 * Theme.dp;
                        background: battery-percent < 0 ? Theme.text-dim : Theme.text-secondary;
                    }
                }
            }
        }
        Text {
            text: time;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    TouchArea {
        property <bool> was-pulled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.was-pulled = false;
            }
        }
        moved => {
            if !self.was-pulled && self.mouse-y - self.pressed-y > 24 * Theme.dp {
                self.was-pulled = true;
                root.pulled();
            }
        }
        clicked => {
            if !self.was-pulled {
                root.tapped();
            }
        }
    }
}

// One of the strip's system buttons (← ⌂ ▢) or its ⋮: an icon, dimmed when there is nowhere for it to go.
component StripButton inherits Rectangle {
    in property <image> icon;
    in property <bool> dim;
    callback clicked;
    width: 44 * Theme.dp;
    height: Theme.strip-h;
    background: touch.pressed ? Theme.pressed : transparent;
    Glyph {
        source: icon;
        size: Theme.toolbar-icon;
        opacity: dim ? 0.4 : 1;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The page's Cancel (a word) or its primary action (a green pill with an icon and a label).
component LabelButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> label;
    in property <bool> pill;
    callback clicked;
    width: min(150 * Theme.dp, row.preferred-width + (pill ? 36 : 20) * Theme.dp);
    height: Theme.strip-h;
    Rectangle {
        x: 4 * Theme.dp;
        width: parent.width - 8 * Theme.dp;
        height: 38 * Theme.dp;
        border-radius: self.height / 2;
        // solid: the software renderer draws a gradient without the rounded corners
        background: pill ? (touch.pressed ? Theme.ok.darker(20%) : Theme.ok) : touch.pressed ? Theme.pressed : transparent;
        row := HorizontalLayout {
            alignment: center;
            spacing: 6 * Theme.dp;
            if has-icon: Glyph {
                source: icon;
                size: 20 * Theme.dp;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: label;
                color: Theme.text;
                font-size: 14 * Theme.dp;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The page's group: Cancel, the primary action, ⋮ (only what the page has).
component PageGroup inherits HorizontalLayout {
    in property <bool> cancel;
    in property <bool> has-primary;
    in property <image> primary-icon;
    in property <bool> primary-has-icon;
    in property <string> primary-label;
    in property <bool> has-options;
    callback cancelled;
    callback primary;
    callback options;
    if cancel: LabelButton {
        label: "Cancel";
        clicked => {
            root.cancelled();
        }
    }
    if has-primary: LabelButton {
        icon: primary-icon;
        has-icon: primary-has-icon;
        label: primary-label;
        pill: true;
        clicked => {
            root.primary();
        }
    }
    if has-options: StripButton {
        icon: @image-url("../icons/sys/more.svg");
        clicked => {
            root.options();
        }
    }
}

component Divider inherits Rectangle {
    width: max(1px, Theme.dp / 2);
    Rectangle {
        height: 26 * Theme.dp;
        background: Theme.hairline;
    }
}

// The bottom strip, drawn by the shell for every page (docs gestures.md, Five places): the system group ← ⌂ ▢ and
// the page's group Cancel (primary) ⋮. Classic arranges them: 0 system left, 1 system right, 2 split (← ⌂ at the
// left end, ▢ at the right). Gestures leaves the system group to the screen edges and spreads the page's group over
// the whole strip.
export component Strip inherits Rectangle {
    in property <bool> gestures;
    in property <int> arrangement;
    // ← goes up a page (else, dimmed, back to where the user came from)
    in property <bool> can-back;
    in property <bool> cancel;
    in property <bool> has-primary;
    in property <image> primary-icon;
    in property <bool> primary-has-icon: true;
    in property <string> primary-label;
    in property <bool> has-options;
    callback back;
    callback home;
    callback apps;
    callback cancelled;
    callback primary;
    callback options;
    height: Theme.strip-h;
    // Gestures with nothing of the page's: no bar at all, just the screen's black
    property <bool> blank: gestures && !cancel && !has-primary && !has-options;
    background: blank ? Theme.bg : @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
    if !blank: Rectangle {
        y: 0;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding-left: 4 * Theme.dp;
        padding-right: 4 * Theme.dp;
        if !gestures && arrangement != 1: StripButton {
            icon: @image-url("../icons/sys/back.svg");
            dim: !can-back;
            clicked => {
                root.back();
            }
        }
        if !gestures && arrangement != 1: StripButton {
            icon: @image-url("../icons/sys/home.svg");
            clicked => {
                root.home();
            }
        }
        if !gestures && arrangement == 0: StripButton {
            icon: @image-url("../icons/sys/tabs.svg");
            clicked => {
                root.apps();
            }
        }
        if !gestures && arrangement != 1: Divider { }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: gestures ? space-around : arrangement == 0 ? end : arrangement == 1 ? start : center;
            PageGroup {
                spacing: gestures ? 24 * Theme.dp : 2 * Theme.dp;
                cancel: root.cancel;
                has-primary: root.has-primary;
                primary-icon: root.primary-icon;
                primary-has-icon: root.primary-has-icon;
                primary-label: root.primary-label;
                has-options: root.has-options;
                cancelled => {
                    root.cancelled();
                }
                primary => {
                    root.primary();
                }
                options => {
                    root.options();
                }
            }
        }

        if !gestures && arrangement != 0: Divider { }
        if !gestures && arrangement == 1: StripButton {
            icon: @image-url("../icons/sys/back.svg");
            dim: !can-back;
            clicked => {
                root.back();
            }
        }
        if !gestures && arrangement == 1: StripButton {
            icon: @image-url("../icons/sys/home.svg");
            clicked => {
                root.home();
            }
        }
        if !gestures && arrangement != 0: StripButton {
            icon: @image-url("../icons/sys/tabs.svg");
            clicked => {
                root.apps();
            }
        }
    }
}
