// The frame every screen shares: status bar, bottom toolbar, title bar.
import { Theme } from "../theme.slint";

export component Glyph inherits Image {
    in property <length> size: Theme.row-icon;
    width: size;
    height: size;
    colorize: Theme.text;
}

export component StatusBar inherits Rectangle {
    in property <string> title;
    in property <int> battery-percent: -1;
    in property <string> battery-text: "--%";
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    in property <bool> shade-open;
    in property <string> time: "10:24";
    // the modem (telephony C5): bars 0..4, -1 = no modem (the plain signal icon); the operator shows where the title
    // is empty (home), the radio technology ("LTE", "3G", "2G") right before the bars
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    // Wi-Fi bars 0..4 while connected, -1 = not connected (no icon); its band ("2.4", "5") as a small label
    in property <int> wifi-bars: -1;
    in property <string> wifi-band;
    callback tapped;
    // a swipe down on the bar (the shade opens)
    callback pulled;
    height: Theme.status-h;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        spacing: 6 * Theme.dp;
        Text {
            text: title != "" ? title : operator;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
        // the radio technology and its bars as one cluster: fixed widths, so the title takes all the spare room
        if bars >= 0: HorizontalLayout {
            spacing: 3 * Theme.dp;
            horizontal-stretch: 0;
            if rat != "": Text {
                text: rat;
                color: Theme.text;
                font-size: Theme.font-status * 0.8;
                font-weight: 600;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    width: 16.5 * Theme.dp;
                    height: Theme.status-icon;
                    spacing: 1.5 * Theme.dp;
                    for i in 4: VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: 3 * Theme.dp;
                            height: Theme.status-icon * (i + 1) / 4;
                            border-radius: 1 * Theme.dp;
                            background: i < bars ? Theme.text : Theme.text-dim;
                            opacity: i < bars ? 1 : 0.4;
                        }
                    }
                }
            }
        }
        if bars < 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/signal.svg");
                size: Theme.status-icon;
            }
        }
        if wifi-bars >= 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.status-icon + (wifi-band != "" ? 5 * Theme.dp : 0);
                height: Theme.status-icon;
                Glyph {
                    x: 0;
                    y: 0;
                    source: @image-url("../icons/sys/wifi.svg");
                    size: Theme.status-icon;
                    colorize: wifi-bars >= 2 ? Theme.text : Theme.text-secondary;
                }
                if wifi-band != "": Text {
                    x: parent.width - self.width;
                    y: parent.height - self.height + 2 * Theme.dp;
                    text: wifi-band;
                    color: Theme.text;
                    font-size: 7 * Theme.dp;
                    font-weight: 700;
                }
            }
        }
        // the battery as one widget: the fill's colour is the level (red, orange, green), and inside it the percent on
        // battery, a bolt when plugged in (dim while the charger idles), or a check when full on USB
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                Rectangle {
                    width: 28 * Theme.dp;
                    height: 13 * Theme.dp;
                    border-width: 1 * Theme.dp;
                    border-color: battery-percent < 0 ? Theme.text-dim : Theme.text-secondary;
                    border-radius: 3 * Theme.dp;
                    clip: true;
                    if battery-percent >= 0: Rectangle {
                        x: 0;
                        y: 0;
                        width: min(100, battery-percent) / 100 * parent.width;
                        height: parent.height;
                        background: battery-percent <= Theme.battery-low ? Theme.danger
                            : battery-percent <= Theme.battery-mid ? Theme.warn : Theme.ok;
                    }
                    // plugged in: a bolt, bright while charging, dim while the charger idles
                    if (battery-charging || battery-connected) && !battery-full: Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/sys/charging.svg");
                        size: 11 * Theme.dp;
                        colorize: battery-charging ? Theme.text : Theme.text-dim;
                    }
                    if battery-full && !battery-charging: Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/sys/check.svg");
                        size: 11 * Theme.dp;
                    }
                    if !battery-charging && !battery-connected && !battery-full: Text {
                        width: parent.width;
                        height: parent.height;
                        text: battery-percent < 0 ? "--" : "\{battery-percent}";
                        color: battery-percent < 0 ? Theme.text-dim : Theme.text;
                        font-size: 9 * Theme.dp;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 2 * Theme.dp;
                        height: 5 * Theme.dp;
                        border-radius: 1 * Theme.dp;
                        background: battery-percent < 0 ? Theme.text-dim : Theme.text-secondary;
                    }
                }
            }
        }
        Text {
            text: time;
            color: Theme.text;
            font-size: Theme.font-status;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    TouchArea {
        property <bool> was-pulled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.was-pulled = false;
            }
        }
        moved => {
            if !self.was-pulled && self.mouse-y - self.pressed-y > 24 * Theme.dp {
                self.was-pulled = true;
                root.pulled();
            }
        }
        clicked => {
            if !self.was-pulled {
                root.tapped();
            }
        }
    }
}

export component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: Theme.toolbar-button-w;
    height: Theme.toolbar-h;
    background: touch.pressed && enabled ? Theme.pressed : transparent;
    opacity: enabled ? 1 : 0;
    Glyph {
        source: icon;
        size: Theme.toolbar-icon;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A toolbar button with a label beside its icon, optionally a green pill (Call).
component LabelButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> pill;
    in property <bool> enabled: true;
    callback clicked;
    width: Theme.toolbar-button-w;
    height: Theme.toolbar-h;
    opacity: enabled ? 1 : 0;
    Rectangle {
        width: min(parent.width - 8 * Theme.dp, row.preferred-width + 28 * Theme.dp);
        height: 40 * Theme.dp;
        border-radius: self.height / 2;
        background: pill ? (touch.pressed ? Theme.ok.darker(20%) : @linear-gradient(180deg, Theme.ok.brighter(15%) 0%, Theme.ok.darker(10%) 100%))
            : touch.pressed && enabled ? Theme.pressed : transparent;
        row := HorizontalLayout {
            alignment: center;
            spacing: 6 * Theme.dp;
            Glyph {
                source: icon;
                size: pill ? 20 * Theme.dp : 22 * Theme.dp;
                y: (parent.height - self.height) / 2;
            }

            if label != "": Text {
                text: label;
                color: Theme.text;
                font-size: 14 * Theme.dp;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Back on the left, an optional action in the middle, Options on the right (Belle's toolbar). An app can give the
// action a label and a green pill (the dialer's Call), turn Back into "Cancel" (an editor), or empty the toolbar (a
// full-screen call view).
export component Toolbar inherits Rectangle {
    in property <image> action-icon;
    in property <bool> has-action;
    in property <string> action-label;
    in property <bool> action-pill;
    in property <bool> back-cancel;
    in property <bool> empty;
    callback back;
    callback action;
    callback options;
    height: Theme.toolbar-h;
    background: empty ? Theme.bg : @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
    if !empty: Rectangle {
        y: 0;
        height: max(1px, Theme.dp / 2);
        background: Theme.hairline;
    }

    if !empty: HorizontalLayout {
        alignment: space-between;
        if !back-cancel: ToolbarButton {
            icon: @image-url("../icons/sys/back.svg");
            clicked => {
                root.back();
            }
        }
        if back-cancel: LabelButton {
            icon: @image-url("../icons/sys/close.svg");
            label: "Cancel";
            clicked => {
                root.back();
            }
        }

        if action-label == "" && !action-pill: ToolbarButton {
            icon: action-icon;
            enabled: has-action;
            clicked => {
                root.action();
            }
        }
        if action-label != "" || action-pill: LabelButton {
            icon: action-icon;
            label: action-label;
            pill: action-pill;
            enabled: has-action;
            clicked => {
                root.action();
            }
        }

        ToolbarButton {
            icon: @image-url("../icons/sys/options.svg");
            clicked => {
                root.options();
            }
        }
    }
}

// A screen's heading: large title, optional subtitle.
export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: Theme.title-h;
    VerticalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin;
        alignment: center;
        Text {
            text: title;
            color: Theme.text;
            font-size: Theme.font-title * 1.15;
            font-weight: 700;
            overflow: elide;
        }

        if subtitle != "": Text {
            text: subtitle;
            color: Theme.text-dim;
            font-size: Theme.font-label;
            overflow: elide;
        }
    }
}
