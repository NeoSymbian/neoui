// SPDX-License-Identifier: Apache-2.0
// (TP8, TP9) The lock screen (nt-lock), the PIN pad over it (nt-lock-pin), its emergency dialer, and SYSSTART's PIN
// dialog for Settings (set2-lock-pin, ACTION_LOCK_DIALOG). The UI server fills `Lock` (neoui-render `lock.rs`) and
// reads its callbacks: the digits go straight to it one key at a time, so Slint only ever knows how many there are.
import { Theme } from "../theme.slint";
import { Now } from "../now.slint";
import { Media } from "../media.slint";
import { SystemSettings } from "../system-settings.slint";
import { Glyph } from "frame.slint";
import { Art, Control } from "media.slint";

// one row of the lock screen's cards: "Messages · 2" over "Ava Lindqvist · content hidden", and when
export struct LockCard { key: string, head: string, line: string, time: string }

export global Lock {
    // the lock layer covers the screen (the status bar stays, with the operator's name in it)
    in property <bool> shown;
    // the PIN pad over it, and its emergency dialer
    in property <bool> pad;
    in-out property <bool> emergency;
    // the digits typed so far (only how many) and the pad's or the dialog's line ("Wrong PIN · 4 tries left")
    in property <int> digits;
    in property <string> message;
    // the cards the policy lets show, and how many more
    in property <[LockCard]> cards;
    in property <int> more;
    // the live activity (top-panel TP6's island; empty title: none)
    in property <string> activity-title;
    in property <string> activity-time;
    in property <color> activity-tint: #f5a524;
    // the PIN dialog for Settings (set2-lock-pin): shown, its title, its line under it, the step, ✓ allowed
    in property <bool> dialog;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <string> dialog-step;
    // a key: 0–9, 10 delete; the pad's or dialog's Done / ✓; Cancel / ✕
    callback key(int);
    callback submit();
    callback cancel();
    // swipe up (any edge in Gestures and N9), or a tap on a card: unlock (the pad comes up with a PIN)
    callback swiped();
    // the emergency dialer's Call: the server dials only an emergency number
    callback emergency-call(string);
}

component Dots inherits HorizontalLayout {
    in property <int> filled;
    in property <int> slots;
    in property <length> size: 10 * Theme.dp;
    alignment: center;
    spacing: 18 * Theme.dp;
    for i in root.slots: Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: i < root.filled ? #ffffff : transparent;
        border-width: i < root.filled ? 0 : 1.5 * Theme.dp;
        border-color: #ffffffb0;
    }
}

// the lock screen's round keys (nt-lock-pin)
component PadKey inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: 78 * Theme.dp;
    height: 52 * Theme.dp;
    border-radius: 26 * Theme.dp;
    background: ta.pressed ? #ffffff40 : #ffffff1c;
    Text {
        text: root.text;
        color: #ffffff;
        font-size: 24 * Theme.dp;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextKey inherits Rectangle {
    in property <string> text;
    in property <color> tint: #ffffff;
    callback clicked;
    width: 120 * Theme.dp;
    height: 44 * Theme.dp;
    Text {
        text: root.text;
        color: root.tint;
        font-size: 16 * Theme.dp;
        font-weight: 600;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// The PIN pad over the lock screen (nt-lock-pin): Delete, Emergency call, Cancel; or the emergency dialer
component LockPad inherits Rectangle {
    in property <string> feedback;
    property <string> number;
    property <length> step-x: 100 * Theme.dp;
    property <length> left: (self.width - 2 * step-x - 78 * Theme.dp) / 2;
    property <length> top: 213 * Theme.dp;
    background: #000000d8;
    changed visible => {
        root.number = "";
    }
    TouchArea { }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: 98 * Theme.dp;
        source: @image-url("../icons/sys/lock.svg");
        size: 26 * Theme.dp;
    }
    Text {
        y: 140 * Theme.dp;
        width: parent.width;
        horizontal-alignment: center;
        text: Lock.emergency ? "Emergency call" : "Enter PIN";
        color: #ffffff;
        font-size: 18 * Theme.dp;
        font-weight: 600;
    }
    if !Lock.emergency: Dots {
        y: 180 * Theme.dp;
        width: parent.width;
        height: 10 * Theme.dp;
        filled: Lock.digits;
        slots: max(4, Lock.digits);
    }
    if Lock.emergency: Text {
        y: 172 * Theme.dp;
        width: parent.width;
        horizontal-alignment: center;
        text: root.number;
        color: #ffffff;
        font-size: 24 * Theme.dp;
    }
    Text {
        y: 200 * Theme.dp;
        width: parent.width;
        horizontal-alignment: center;
        text: Lock.emergency ? root.feedback : Lock.message;
        color: #ff8a8a;
        font-size: 13 * Theme.dp;
    }
    for d[i] in [1, 2, 3, 4, 5, 6, 7, 8, 9]: PadKey {
        x: root.left + mod(i, 3) * root.step-x;
        y: root.top + floor(i / 3) * 70 * Theme.dp;
        text: d;
        clicked => {
            if Lock.emergency {
                root.number = root.number + d;
            } else {
                Lock.key(d);
            }
        }
    }
    PadKey {
        x: root.left + root.step-x;
        y: root.top + 3 * 70 * Theme.dp;
        text: "0";
        clicked => {
            if Lock.emergency {
                root.number = root.number + "0";
            } else {
                Lock.key(0);
            }
        }
    }
    TextKey {
        x: root.left + 2 * root.step-x - 21 * Theme.dp;
        y: root.top + 3 * 70 * Theme.dp + 4 * Theme.dp;
        text: Lock.emergency ? "Call" : "Delete";
        tint: Lock.emergency ? Theme.ok : #ffffff;
        clicked => {
            if Lock.emergency {
                Lock.emergency-call(root.number);
            } else {
                Lock.key(10);
            }
        }
    }
    TextKey {
        x: 32 * Theme.dp;
        y: root.top + 4 * 70 * Theme.dp - 12 * Theme.dp;
        text: Lock.emergency ? "Delete" : "Emergency call";
        tint: Lock.emergency ? #ffffff : #ff6b6b;
        clicked => {
            if Lock.emergency {
                root.number = "";
            } else {
                Lock.emergency = true;
            }
        }
    }
    TextKey {
        x: parent.width - self.width - 20 * Theme.dp;
        y: root.top + 4 * 70 * Theme.dp - 12 * Theme.dp;
        text: "Cancel";
        tint: #8ab4ff;
        clicked => {
            if Lock.emergency {
                Lock.emergency = false;
            } else {
                Lock.cancel();
            }
        }
    }
}

component Card inherits Rectangle {
    in property <LockCard> card;
    border-radius: 16 * Theme.dp;
    background: #14171bd0;
    border-width: 1px;
    border-color: #ffffff14;
    height: 52 * Theme.dp;
    HorizontalLayout {
        padding-left: 14 * Theme.dp;
        padding-right: 14 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Glyph {
                size: 18 * Theme.dp;
                source: root.card.key == "messages" ? @image-url("../icons/sys/message.svg")
                    : root.card.key == "phone" ? @image-url("../icons/sys/missed_call.svg")
                    : root.card.key == "calendar" || root.card.key == "dtsrv" ? @image-url("../icons/sys/clock.svg")
                    : root.card.key == "files" ? @image-url("../icons/sys/folder.svg")
                    : @image-url("../icons/sys/bell.svg");
                colorize: root.card.key == "messages" ? #3d8bfd
                    : root.card.key == "phone" ? #e5484d
                    : root.card.key == "calendar" || root.card.key == "dtsrv" ? #8b6cf0
                    : Theme.text-secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0;
            Text {
                text: root.card.head;
                color: Theme.text-dim;
                font-size: 12.5 * Theme.dp;
                overflow: elide;
            }
            Text {
                text: root.card.line;
                color: Theme.text;
                font-size: 14.5 * Theme.dp;
                font-weight: 600;
                overflow: elide;
            }
        }
        Text {
            text: root.card.time;
            color: Theme.text-dim;
            font-size: 12.5 * Theme.dp;
            vertical-alignment: center;
        }
    }
}

// The lock screen (nt-lock): the time and date, the activity, the media player, the cards, Swipe up to unlock
export component LockScreen inherits Rectangle {
    in property <string> feedback;
    property <bool> edges: SystemSettings.nav-mode != 0;
    property <length> edge: 24 * Theme.dp;
    visible: Lock.shown;
    background: @linear-gradient(180deg, #0e1a2e 0%, #070b12 60%, #05070a 100%);
    swipe := SwipeGestureHandler {
        handle-swipe-up: true;
        handle-swipe-left: root.edges;
        handle-swipe-right: root.edges;
        swiped => {
            // up from anywhere; sideways only in from a side edge (Gestures, N9)
            if self.current-position.y < self.pressed-position.y - 60 * Theme.dp
                || (self.pressed-position.x < root.edge && self.current-position.x > self.pressed-position.x + 60 * Theme.dp)
                || (self.pressed-position.x > root.width - root.edge && self.current-position.x < self.pressed-position.x - 60 * Theme.dp) {
                Lock.swiped();
            }
        }
        TouchArea { }
        col := VerticalLayout {
            y: 18 * Theme.dp;
            height: root.height - 18 * Theme.dp - 96 * Theme.dp;
            padding-left: 14 * Theme.dp;
            padding-right: 14 * Theme.dp;
            spacing: 12 * Theme.dp;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Glyph {
                    source: @image-url("../icons/sys/lock.svg");
                    size: 18 * Theme.dp;
                    colorize: Theme.text-secondary;
                }
            }
            Text {
                height: 84 * Theme.dp;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: (Now.hours < 10 && Now.h24 ? "0" : "") + Now.hours + ":" + (Now.minutes < 10 ? "0" : "") + Now.minutes;
                color: #e8edf5;
                font-size: 84 * Theme.dp;
                font-weight: 300;
            }
            Text {
                horizontal-alignment: center;
                text: Now.date;
                color: Theme.text-secondary;
                font-size: 16 * Theme.dp;
            }
            if Lock.activity-title != "": Rectangle {
                height: 68 * Theme.dp;
                border-radius: 20 * Theme.dp;
                background: #0b0d10;
                border-width: 1px;
                border-color: #ffffff18;
                HorizontalLayout {
                    padding-left: 14 * Theme.dp;
                    spacing: 14 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40 * Theme.dp;
                            height: 40 * Theme.dp;
                            border-radius: 20 * Theme.dp;
                            border-width: 4 * Theme.dp;
                            border-color: Lock.activity-tint;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Lock.activity-title;
                            color: Theme.text-dim;
                            font-size: 12.5 * Theme.dp;
                        }
                        Text {
                            text: Lock.activity-time;
                            color: Lock.activity-tint;
                            font-size: 24 * Theme.dp;
                        }
                    }
                }
            }
            if Media.live: Rectangle {
                height: 60 * Theme.dp;
                border-radius: 20 * Theme.dp;
                background: #0b0d10;
                border-width: 1px;
                border-color: #ffffff18;
                HorizontalLayout {
                    padding-left: 14 * Theme.dp;
                    padding-right: 10 * Theme.dp;
                    spacing: 12 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        Art {
                            size: 40 * Theme.dp;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0;
                        Text {
                            text: Media.title;
                            color: Theme.text;
                            font-size: 15 * Theme.dp;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: Media.artist;
                            color: Theme.text-dim;
                            font-size: 12.5 * Theme.dp;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 0;
                        VerticalLayout {
                            alignment: center;
                            Control {
                                size: 36 * Theme.dp;
                                icon: @image-url("../icons/sys/prev.svg");
                                opacity: Media.can-prev ? 1 : 0.35;
                                clicked => {
                                    if Media.can-prev { Media.command(4, 0); }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Control {
                                size: 36 * Theme.dp;
                                icon: Media.playing ? @image-url("../icons/sys/pause.svg") : @image-url("../icons/sys/play.svg");
                                opacity: Media.can-play ? 1 : 0.35;
                                clicked => {
                                    if Media.can-play { Media.command(Media.playing ? 2 : 1, 0); }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Control {
                                size: 36 * Theme.dp;
                                icon: @image-url("../icons/sys/next.svg");
                                opacity: Media.can-next ? 1 : 0.35;
                                clicked => {
                                    if Media.can-next { Media.command(3, 0); }
                                }
                            }
                        }
                    }
                }
            }
            for c in Lock.cards: Card {
                card: c;
                TouchArea {
                    clicked => { Lock.swiped(); }
                }
            }
            if Lock.more > 0: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: more.preferred-width + 24 * Theme.dp;
                    height: 26 * Theme.dp;
                    border-radius: 13 * Theme.dp;
                    background: #1e2228;
                    more := Text {
                        text: "+" + Lock.more + " more";
                        color: Theme.text-secondary;
                        font-size: 13 * Theme.dp;
                    }
                }
            }
        }
        Text {
            y: root.height - 66 * Theme.dp;
            width: root.width;
            horizontal-alignment: center;
            text: "Swipe up to unlock";
            color: Theme.text-secondary;
            font-size: 14 * Theme.dp;
        }
    }
    LockPad {
        visible: Lock.pad;
        width: root.width;
        height: root.height;
        feedback: root.feedback;
    }
}

// the number keys of SYSSTART's PIN dialog (set2-lock-pin): the system number keyboard's look
component DialogKey inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    callback clicked;
    height: 44 * Theme.dp;
    border-radius: 6 * Theme.dp;
    background: ta.pressed ? #5a606a : #3a3f47;
    if !root.has-icon: Text {
        text: root.text;
        color: #ffffff;
        font-size: root.text == "Done" ? 15 * Theme.dp : 20 * Theme.dp;
    }
    if root.has-icon: Glyph {
        source: root.icon;
        size: 22 * Theme.dp;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// SYSSTART's PIN dialog for Settings (set2-lock-pin): enrol (twice), change (current, then twice), remove (current)
export component LockDialog inherits Rectangle {
    property <length> kb-h: 36 * Theme.dp + 4 * 48 * Theme.dp + 16 * Theme.dp;
    visible: Lock.dialog;
    background: Theme.bg;
    TouchArea { }
    // the header: ✕, the title, ✓
    Rectangle {
        height: Theme.header-h;
        y: 0;
        border-width: 0;
        HorizontalLayout {
            padding-left: 8 * Theme.dp;
            padding-right: 8 * Theme.dp;
            spacing: 8 * Theme.dp;
            Rectangle {
                width: 40 * Theme.dp;
                Glyph {
                    source: @image-url("../icons/sys/close.svg");
                    size: 22 * Theme.dp;
                }
                TouchArea {
                    clicked => { Lock.cancel(); }
                }
            }
            Text {
                text: "Screen lock PIN";
                color: Theme.text;
                font-size: 19 * Theme.dp;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 40 * Theme.dp;
                Glyph {
                    source: @image-url("../icons/sys/check.svg");
                    size: 22 * Theme.dp;
                    colorize: Lock.digits >= 4 ? Theme.accent : Theme.text-dim;
                }
                TouchArea {
                    clicked => { Lock.submit(); }
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.hairline;
        }
    }
    VerticalLayout {
        y: Theme.header-h + 28 * Theme.dp;
        height: root.height - Theme.header-h - 28 * Theme.dp - root.kb-h;
        padding-left: 48 * Theme.dp;
        padding-right: 48 * Theme.dp;
        spacing: 14 * Theme.dp;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56 * Theme.dp;
                height: 56 * Theme.dp;
                border-radius: 14 * Theme.dp;
                background: #5a6270;
                Glyph {
                    source: @image-url("../icons/sys/lock.svg");
                    size: 26 * Theme.dp;
                }
            }
        }
        Text {
            text: Lock.dialog-title;
            horizontal-alignment: center;
            color: Theme.text;
            font-size: 19 * Theme.dp;
            font-weight: 600;
        }
        Text {
            text: Lock.dialog-text;
            horizontal-alignment: center;
            color: Theme.text-secondary;
            font-size: 13.5 * Theme.dp;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 8 * Theme.dp;
            Rectangle {
                width: 240 * Theme.dp;
                height: 52 * Theme.dp;
                border-radius: 8 * Theme.dp;
                background: #15181c;
                border-width: 1px;
                border-color: Theme.accent;
                Dots {
                    y: (parent.height - 14 * Theme.dp) / 2;
                    height: 14 * Theme.dp;
                    filled: Lock.digits;
                    slots: min(8, max(6, Lock.digits));
                    size: 14 * Theme.dp;
                    spacing: 14 * Theme.dp;
                }
            }
        }
        Text {
            text: Lock.message != "" ? Lock.message : Lock.dialog-step;
            horizontal-alignment: center;
            color: Lock.message != "" ? #ff8a8a : Theme.text-dim;
            font-size: 12.5 * Theme.dp;
            wrap: word-wrap;
        }
    }
    // the keys
    Rectangle {
        y: root.height - root.kb-h;
        height: root.kb-h;
        background: #1d2024;
        Glyph {
            x: parent.width - 44 * Theme.dp;
            y: 7 * Theme.dp;
            source: @image-url("../icons/sys/chevron_down.svg");
            size: 22 * Theme.dp;
            colorize: Theme.text-secondary;
        }
        for d[i] in [1, 2, 3, 4, 5, 6, 7, 8, 9]: DialogKey {
            x: 3 * Theme.dp + mod(i, 3) * (parent.width - 6 * Theme.dp) / 3;
            y: 36 * Theme.dp + floor(i / 3) * 48 * Theme.dp;
            width: (parent.width - 6 * Theme.dp) / 3 - 6 * Theme.dp;
            text: d;
            clicked => { Lock.key(d); }
        }
        DialogKey {
            x: 3 * Theme.dp;
            y: 36 * Theme.dp + 3 * 48 * Theme.dp;
            width: (parent.width - 6 * Theme.dp) / 3 - 6 * Theme.dp;
            has-icon: true;
            icon: @image-url("../icons/sys/backspace.svg");
            clicked => { Lock.key(10); }
        }
        DialogKey {
            x: 3 * Theme.dp + (parent.width - 6 * Theme.dp) / 3;
            y: 36 * Theme.dp + 3 * 48 * Theme.dp;
            width: (parent.width - 6 * Theme.dp) / 3 - 6 * Theme.dp;
            text: "0";
            clicked => { Lock.key(0); }
        }
        DialogKey {
            x: 3 * Theme.dp + 2 * (parent.width - 6 * Theme.dp) / 3;
            y: 36 * Theme.dp + 3 * 48 * Theme.dp;
            width: (parent.width - 6 * Theme.dp) / 3 - 6 * Theme.dp;
            text: "Done";
            clicked => { Lock.submit(); }
        }
    }
}
