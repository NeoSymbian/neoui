// The time as the shell shows it (the home clock widget and agenda card, and later the lock screen): set by the UI
// server whenever the minute, the date, the 24-hour setting or DTSRV's dtsrv.next change (neoui-render
// `Renderer::set_now`, `Renderer::set_next_event`).

export global Now {
    // the hour as shown: 0-23, or 1-12 on a 12-hour clock
    in property <int> hours: 10;
    in property <int> minutes: 24;
    in property <bool> h24: true;
    // "AM"/"PM" on a 12-hour clock, else empty
    in property <string> am-pm;
    // "Monday, 9 November"
    in property <string> date: "Friday, 6 November";
    // the next alarm, "Tue 07:30"; empty when none is on
    in property <string> next-alarm;
    // the next event (dtsrv.next): "Today 13:00", its title and its calendar's colour; empty when none (or no DTSRV)
    in property <string> next-event-time;
    in property <string> next-event-title;
    in property <color> next-event-colour;
    // the shade's date, in the chosen format (time.date_format)
    in property <string> date-text: "Friday, 6 November";
}
