// Sample data for the prototype. Every name and number is invented (555-01xx is the fictional range).

export struct Person { name: string, initials: string, tint: color, number: string, label: string, favourite: bool }
export struct Call { name: string, initials: string, tint: color, kind: string, when: string }
export struct Conversation { name: string, initials: string, tint: color, snippet: string, when: string, unread: bool }
export struct Message { text: string, mine: bool, when: string }
export struct FileItem { name: string, kind: string, detail: string }
// one scanned Wi-Fi network (neoui-proto wifi::Network): name, "Secured · 5 GHz · -46 dBm", 0..4 bars
export struct WifiNet { name: string, detail: string, bars: int, secured: bool, band: string, signal: string, channel: int, bssid: string }
export struct Song { title: string, artist: string, length: string }
export struct Event { time: string, title: string, place: string, tint: color }
export struct Alarm { time: string, label: string, on: bool }
export struct City { name: string, time: string, offset: string }

