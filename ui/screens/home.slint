// Home: widget pages you swipe between (Belle's home screens), page dots, and a dock.
import { Theme } from "../theme.slint";
import { Data } from "../data.slint";
import { Card, PageDots } from "../components/controls.slint";
import { ClockWidget } from "../components/widgets.slint";
import { Avatar } from "../components/lists.slint";
import { Glyph } from "../components/frame.slint";

component DockIcon inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> compact;
    callback clicked;
    width: 64 * Theme.dp;
    height: compact ? 50 * Theme.dp : 78 * Theme.dp;
    Image {
        y: 0;
        width: compact ? 46 * Theme.dp : 54 * Theme.dp;
        height: self.width;
        source: icon;
        opacity: t.pressed ? 0.7 : 1;
    }

    if !compact: Text {
        y: 60 * Theme.dp;
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.font-status * 0.92;
        horizontal-alignment: center;
        width: parent.width;
    }

    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component AgendaCard inherits Card {
    height: 30 * Theme.dp + 2 * 46 * Theme.dp + 2 * Theme.card-pad;
    VerticalLayout {
        padding: Theme.card-pad;
        spacing: 8 * Theme.dp;
        Text {
            text: "TODAY";
            color: Theme.text-dim;
            font-size: Theme.font-status * 0.9;
            font-weight: 600;
            letter-spacing: 0.06 * Theme.font-status;
        }

        for e[i] in Data.events: HorizontalLayout {
            visible: i >= 1 && i <= 2;
            height: i >= 1 && i <= 2 ? 40 * Theme.dp : 0;
            spacing: 12 * Theme.dp;
            Rectangle {
                width: 4 * Theme.dp;
                border-radius: 2 * Theme.dp;
                background: e.tint;
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: e.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                }

                Text {
                    text: e.time + " · " + e.place;
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
            }
        }
    }
}

component MusicCard inherits Card {
    height: 76 * Theme.dp;
    HorizontalLayout {
        padding: 12 * Theme.dp;
        spacing: 12 * Theme.dp;
        Rectangle {
            width: self.height;
            border-radius: Theme.radius-small;
            background: @linear-gradient(135deg, #e04e9b 0%, #8656e8 100%);
            Glyph {
                source: @image-url("../icons/sys/note.svg");
                size: 24 * Theme.dp;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: Data.songs[0].title;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: Data.songs[0].artist;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("../icons/sys/play.svg");
                size: 28 * Theme.dp;
            }
        }
    }
}

export component HomeScreen inherits Rectangle {
    callback open-app(string);
    // an app on one of its pages (app key, view: host::PAGES)
    callback open-view(string, string);
    in-out property <int> page: 0;
    property <length> pad: 16 * Theme.dp;
    property <length> page-w: self.width;
    property <length> drag;
    // landscape has 360 dp of height: a compact dock without labels
    property <bool> landscape: self.width > self.height;
    property <length> dock-h: landscape ? 64 * Theme.dp : Theme.dock-h;
    // the pages' band (the UI server slides it itself, smooth-ui S2c)
    out property <length> strip-h: self.height - dock-h - 24 * Theme.dp;
    background: @linear-gradient(180deg, #0c1424 0%, #05070b 55%, #000000 100%);
    clip: true;

    // Pages, side by side. A sideways swipe moves between them; taps still reach the widgets and cards on the
    // pages (a TouchArea over the strip used to take every touch). On the device the UI server slides the pages
    // itself (smooth-ui S2c) and cancels Slint's touch when it takes over.
    swipe := SwipeGestureHandler {
        y: 0;
        height: root.strip-h;
        handle-swipe-left: root.page < 2;
        handle-swipe-right: root.page > 0;
        moved => {
            if (!Theme.instant) {
                root.drag = (self.current-position.x - self.pressed-position.x) * 0.6;
            }
        }
        swiped => {
            if (self.current-position.x - self.pressed-position.x < -60 * Theme.dp && root.page < 2) {
                root.page += 1;
            } else if (self.current-position.x - self.pressed-position.x > 60 * Theme.dp && root.page > 0) {
                root.page -= 1;
            }
            root.drag = 0;
        }
        cancelled => {
            root.drag = 0;
        }

        Rectangle {
            x: -page * page-w + drag;
            animate x { duration: Theme.instant ? 0ms : Theme.page; easing: ease-out-quad; }
            width: 3 * page-w;
            height: root.strip-h;

            // Page 0: clock, agenda, favourites, music (landscape: two columns, below)
            if root.width <= root.height: Rectangle {
                x: 0;
                width: page-w;
                VerticalLayout {
                    padding: pad;
                    padding-top: 22 * Theme.dp;
                    spacing: 14 * Theme.dp;
                    alignment: start;
                    ClockWidget {
                        clicked => { root.open-app("clock"); }
                    }

                    Rectangle { height: 4 * Theme.dp; }

                    AgendaCard { }

                    Card {
                        height: 96 * Theme.dp;
                        HorizontalLayout {
                            padding: 12 * Theme.dp;
                            alignment: space-around;
                            for p in Data.people: VerticalLayout {
                                visible: p.favourite;
                                width: p.favourite ? 64 * Theme.dp : 0;
                                spacing: 6 * Theme.dp;
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Avatar {
                                        initials: p.initials;
                                        tint: p.tint;
                                        size: 48 * Theme.dp;
                                    }
                                }

                                Text {
                                    text: p.name;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-status * 0.92;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    MusicCard { }
                }
            }

            if root.width > root.height: Rectangle {
                x: 0;
                width: page-w;
                HorizontalLayout {
                    padding: pad;
                    spacing: 2 * pad;
                    VerticalLayout {
                        alignment: center;
                        ClockWidget {
                            clicked => { root.open-app("clock"); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 10 * Theme.dp;
                        horizontal-stretch: 1;
                        AgendaCard { }
                    }
                }
            }

            // Page 1: shortcuts
            Rectangle {
                x: page-w;
                width: page-w;
                for app[i] in [
                    { name: "Calendar", key: "calendar", icon: @image-url("../icons/apps/calendar.svg") },
                    { name: "Clock", key: "clock", icon: @image-url("../icons/apps/clock.svg") },
                    { name: "Photos", key: "photos", icon: @image-url("../icons/apps/photos.svg") },
                    { name: "Music", key: "music", icon: @image-url("../icons/apps/music.svg") },
                    { name: "Files", key: "files", icon: @image-url("../icons/apps/files.svg") },
                    { name: "Settings", key: "settings", icon: @image-url("../icons/apps/settings.svg") },
                    { name: "Contacts", key: "contacts", icon: @image-url("../icons/apps/contacts.svg") },
                    { name: "Terminal", key: "terminal", icon: @image-url("../icons/apps/terminal.svg") },
                ]: Rectangle {
                    x: pad + Math.mod(i, 4) * (page-w - 2 * pad) / 4;
                    y: 28 * Theme.dp + Math.floor(i / 4) * 104 * Theme.dp;
                    width: (page-w - 2 * pad) / 4;
                    height: 100 * Theme.dp;
                    Image {
                        y: 0;
                        width: 58 * Theme.dp;
                        height: self.width;
                        source: app.icon;
                    }

                    Text {
                        y: 66 * Theme.dp;
                        width: parent.width;
                        text: app.name;
                        color: Theme.text-secondary;
                        font-size: Theme.font-status * 0.95;
                        horizontal-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.open-app(app.key);
                        }
                    }
                }
            }

            // Page 2: world clocks
            Rectangle {
                x: 2 * page-w;
                width: page-w;
                VerticalLayout {
                    padding: pad;
                    padding-top: 28 * Theme.dp;
                    spacing: 12 * Theme.dp;
                    alignment: start;
                    for c in Data.cities: Card {
                        height: 64 * Theme.dp;
                        HorizontalLayout {
                            padding-left: Theme.card-pad;
                            padding-right: Theme.card-pad;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: c.name;
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                }

                                Text {
                                    text: c.offset;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-label;
                                }
                            }

                            Text {
                                text: c.time;
                                color: Theme.text;
                                font-size: Theme.font-title * 1.3;
                                font-weight: 300;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    PageDots {
        y: parent.height - dock-h - 20 * Theme.dp;
        height: 8 * Theme.dp;
        count: 3;
        current: page;
    }

    // Dock
    Rectangle {
        y: parent.height - dock-h;
        height: dock-h;
        background: #0d0f13e6;
        Rectangle {
            y: 0;
            height: max(1px, Theme.dp / 2);
            background: Theme.hairline;
        }

        HorizontalLayout {
            alignment: space-around;
            padding-top: (landscape ? 7 : 10) * Theme.dp;
            DockIcon {
                compact: landscape;
                icon: @image-url("../icons/apps/phone.svg");
                label: "Phone";
                clicked => { root.open-view("phone", "dial"); }
            }

            DockIcon {
                compact: landscape;
                icon: @image-url("../icons/apps/messages.svg");
                label: "Messages";
                clicked => { root.open-app("messages"); }
            }

            DockIcon {
                compact: landscape;
                icon: @image-url("../icons/apps/menu.svg");
                label: "Apps";
                clicked => { root.open-app("menu"); }
            }

            DockIcon {
                compact: landscape;
                icon: @image-url("../icons/apps/browser.svg");
                label: "Browser";
                clicked => { root.open-app("browser"); }
            }

            DockIcon {
                compact: landscape;
                icon: @image-url("../icons/apps/camera.svg");
                label: "Camera";
                clicked => { root.open-app("camera"); }
            }
        }
    }
}
