// SPDX-License-Identifier: Apache-2.0
// Home: widget pages you swipe between (Belle's home screens), page dots, and a dock; the pages and the dock are the
// saved layout (D10: neoui-proto `home::Layout`, packed on a 4 × 6 grid; HomeModel in home-edit.slint), edited in
// place (edit mode). With home.style Lanes (G5) the pages give way to three lanes: Events, Home (every page's items in
// one column) and Open apps.
import { Theme } from "../theme.slint";
import { SystemSettings } from "../system-settings.slint";
import { Data } from "../data.slint";
import { Now } from "../now.slint";
import { Card, PageDots } from "../components/controls.slint";
import { ClockWidget } from "../components/widgets.slint";
import { ClockSquare, AgendaSquare, FavouritesSquare, MusicSquare, AppWidgetCard } from "../components/home-widgets.slint";
import { Avatar } from "../components/lists.slint";
import { Glyph } from "../components/frame.slint";
import { Badge } from "../components/footer.slint";
import { Menu } from "../components/menu.slint";
import { Wallpapers } from "../components/wallpaper.slint";
import { Apps } from "menu.slint";
import { HomeModel, HomeCell, EditBar, AddSheet } from "home-edit.slint";
import { SwitcherScreen } from "switcher.slint";
import { ShadeNote } from "../components/shade.slint";
import { NeoList } from "../components/scroll.slint";

component DockIcon inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> compact;
    // ipc BADGE: missed calls, unread messages
    in property <int> badge;
    callback clicked;
    width: 64 * Theme.dp;
    height: compact ? 50 * Theme.dp : 78 * Theme.dp;
    Image {
        y: 0;
        width: compact ? 46 * Theme.dp : 54 * Theme.dp;
        height: self.width;
        source: icon;
        opacity: t.pressed ? 0.7 : 1;
    }

    if root.badge > 0: Badge {
        x: (compact ? 46 : 54) * Theme.dp - self.width / 2;
        y: -4 * Theme.dp;
        count: root.badge;
    }

    if !compact: Text {
        y: 60 * Theme.dp;
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.font-status * 0.92;
        horizontal-alignment: center;
        width: parent.width;
    }

    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The next event (dtsrv.next, DT7): its time, title and calendar colour, or "No events". Tap: Calendar.
component AgendaCard inherits Card {
    callback clicked;
    height: 30 * Theme.dp + 46 * Theme.dp + 2 * Theme.card-pad;
    VerticalLayout {
        alignment: start;
        padding: Theme.card-pad;
        spacing: 8 * Theme.dp;
        Text {
            text: "NEXT";
            color: Theme.text-dim;
            font-size: Theme.font-status * 0.9;
            font-weight: 600;
            letter-spacing: 0.06 * Theme.font-status;
        }

        if Now.next-event-title == "": Text {
            height: 40 * Theme.dp;
            text: "No events";
            color: Theme.text-dim;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }

        if Now.next-event-title != "": HorizontalLayout {
            height: 40 * Theme.dp;
            spacing: 12 * Theme.dp;
            Rectangle {
                width: 4 * Theme.dp;
                border-radius: 2 * Theme.dp;
                background: Now.next-event-colour;
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: Now.next-event-title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: Now.next-event-time;
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
            }
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Media (TP3's media session isn't there yet): nothing playing. Tap: Music.
component MusicCard inherits Card {
    callback clicked;
    HorizontalLayout {
        padding: 12 * Theme.dp;
        spacing: 12 * Theme.dp;
        Rectangle {
            width: min(self.height, 52 * Theme.dp);
            border-radius: Theme.radius-small;
            background: @linear-gradient(135deg, #e04e9b 0%, #8656e8 100%);
            Glyph {
                source: @image-url("../icons/sys/note.svg");
                size: 24 * Theme.dp;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "Nothing playing";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: "Music";
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Favourites (no contacts source in the shell yet): its empty state. Tap: Contacts.
component FavouritesCard inherits Card {
    callback clicked;
    HorizontalLayout {
        padding: 12 * Theme.dp;
        spacing: 12 * Theme.dp;
        Glyph {
            source: @image-url("../icons/sys/star.svg");
            size: 24 * Theme.dp;
            colorize: Theme.text-secondary;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "Favourites";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
            }

            Text {
                text: "No favourites yet";
                color: Theme.text-dim;
                font-size: Theme.font-label;
            }
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// One item of the layout drawn in its cells: an app's icon and name, or a widget (6 dp above and below).
component ItemView inherits Rectangle {
    in property <HomeCell> c;
    callback open-app(string);
    property <length> inset: 6 * Theme.dp;

    if c.kind == 0: Rectangle {
        for app in Apps.all: Rectangle {
            if app.key == c.key: Rectangle {
                Image {
                    y: root.inset;
                    width: min(58 * Theme.dp, root.height - 26 * Theme.dp);
                    height: self.width;
                    source: app.icon;
                }

                Text {
                    y: root.inset + min(58 * Theme.dp, root.height - 26 * Theme.dp) + 6 * Theme.dp;
                    width: root.width;
                    text: app.name;
                    color: Theme.text-secondary;
                    font-size: Theme.font-status * 0.95;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                TouchArea {
                    accessible-role: button;
                    accessible-label: app.name;
                    clicked => { root.open-app(c.key); }
                }
            }
        }
    }
    // (Part 4) the shell's widgets at 2 × 2, and the apps' widgets
    if c.kind == 1 && c.w == 2: Rectangle {
        y: root.inset;
        x: root.inset / 2;
        width: root.width - root.inset;
        height: root.height - 2 * root.inset;
        if c.widget == 1: ClockSquare {
            clicked => { root.open-app("clock"); }
        }
        if c.widget == 2: AgendaSquare {
            clicked => { root.open-app("calendar"); }
        }
        if c.widget == 3: FavouritesSquare {
            clicked => { root.open-app("contacts"); }
        }
        if c.widget == 4: MusicSquare {
            clicked => { root.open-app("music"); }
        }
    }
    if c.kind == 2: Rectangle {
        y: root.inset;
        x: c.w == 2 ? root.inset / 2 : 0;
        width: root.width - (c.w == 2 ? root.inset : 0);
        height: root.height - 2 * root.inset;
        for app in Apps.all: Rectangle {
            if app.key == c.key: AppWidgetCard {
                content: c.content;
                label: c.label;
                icon: app.icon;
                square: c.w == 2;
                // on the page its content names (none yet: just the app)
                clicked => {
                    if c.content.template != 0 {
                        HomeModel.op("open", c.content.page, 0, 0, 0, c.key);
                    }
                    root.open-app(c.key);
                }
            }
        }
    }
    if c.kind == 1 && c.w == 4 && c.widget == 1: ClockWidget {
        y: root.inset;
        width: root.width;
        clicked => { root.open-app("clock"); }
    }
    if c.kind == 1 && c.w == 4 && c.widget == 2: AgendaCard {
        y: root.inset;
        height: root.height - 2 * root.inset;
        clicked => { root.open-app("calendar"); }
    }
    if c.kind == 1 && c.w == 4 && c.widget == 3: FavouritesCard {
        y: root.inset;
        height: root.height - 2 * root.inset;
        clicked => { root.open-app("contacts"); }
    }
    if c.kind == 1 && c.w == 4 && c.widget == 4: MusicCard {
        y: root.inset;
        height: root.height - 2 * root.inset;
        clicked => { root.open-app("music"); }
    }
}

export component HomeScreen inherits Rectangle {
    // the press in progress is no long press (the UI server took it over); until the next finger goes down
    // (`hold-off` false again), as the swipe handler may hand the press to `hold` after this
    in-out property <bool> hold-off;
    public function stop-hold() {
        hold.fired = true;
        root.hold-off = true;
    }
    callback open-app(string);
    // an app on one of its pages (app key, view: host::PAGES)
    callback open-view(string, string);
    // Lanes (G5): the shade's cards (Events), a tap on one (its row); the running apps and their thumbnails (Open apps)
    in property <[ShadeNote]> notes;
    callback note-opened(int);
    in property <[string]> running;
    in property <[image]> thumbs;
    callback close-app(string);
    in-out property <int> page: 0;
    property <bool> lanes: SystemSettings.home-style == 1 && !HomeModel.editing;
    // how many pages (or lanes) side by side; the UI server's page slide reads it too
    out property <int> page-count: lanes ? 3 : max(1, HomeModel.pages);
    changed page-count => {
        if root.page >= root.page-count {
            root.page = root.page-count - 1;
        }
    }
    property <length> pad: 16 * Theme.dp;
    property <length> page-w: self.width;
    property <length> drag;
    // landscape has 360 dp of height: a compact dock without labels
    property <bool> landscape: self.width > self.height;
    property <length> dock-h: landscape ? 64 * Theme.dp : Theme.dock-h;
    // the pages' band (the UI server slides it itself, smooth-ui S2c)
    out property <length> strip-h: self.height - dock-h - 24 * Theme.dp;
    // the grid: 4 columns, 6 rows under the top margin (edit mode's bar above it)
    property <length> top: HomeModel.editing ? 56 * Theme.dp : 22 * Theme.dp;
    property <length> cell-w: (page-w - 2 * pad) / 4;
    property <length> row-h: max(56 * Theme.dp, (strip-h - top - 8 * Theme.dp) / 6);
    // display.wallpaper (D7): a colour from Settings → Display → Wallpaper
    background: Wallpapers.fill(SystemSettings.wallpaper);
    clip: true;

    // Pages, side by side. A sideways swipe moves between them; taps still reach the widgets and cards on the
    // pages (a TouchArea over the strip used to take every touch). On the device the UI server slides the pages
    // itself (smooth-ui S2c) and cancels Slint's touch when it takes over. Edit mode has no swipe (a drag moves an
    // item): its bar's ‹ › change pages.
    swipe := SwipeGestureHandler {
        y: 0;
        height: root.strip-h;
        enabled: !HomeModel.editing;
        handle-swipe-left: root.page < root.page-count - 1;
        handle-swipe-right: root.page > 0;
        moved => {
            if (!Theme.instant) {
                root.drag = (self.current-position.x - self.pressed-position.x) * 0.6;
            }
        }
        swiped => {
            if (self.current-position.x - self.pressed-position.x < -60 * Theme.dp && root.page < root.page-count - 1) {
                root.page += 1;
            } else if (self.current-position.x - self.pressed-position.x > 60 * Theme.dp && root.page > 0) {
                root.page -= 1;
            }
            root.drag = 0;
        }
        cancelled => {
            root.drag = 0;
        }

        strip := Rectangle {
            x: -page * page-w + drag;
            animate x { duration: Theme.instant ? 0ms : Theme.page; easing: ease-out-quad; }
            width: root.page-count * page-w;
            height: root.strip-h;

            // a long press on the pages' empty part: Edit home · Wallpaper (D20; home has no ⋮ in any mode)
            // a press the UI server takes over (its page slide, the pull down to the shade: `stop-hold`) is no long
            // press: Slint keeps it `pressed` (no release comes), and the swipe handler above keeps its moves
            hold := TouchArea {
                property <bool> fired;
                changed pressed => {
                    if self.pressed {
                        self.fired = false;
                    }
                }
            }
            Timer {
                interval: 500ms;
                running: hold.pressed && !hold.fired && !root.hold-off && !HomeModel.editing;
                triggered => {
                    hold.fired = true;
                    home-menu.show();
                }
            }

            // Pages: the layout's items where the packer put them; in edit mode each has an outline and ×, and a drag
            // moves it (let go over a cell: there; held 400 ms at a side: to the end of the page beside it)
            if !root.lanes: Rectangle {
                for c in HomeModel.cells: cell := Rectangle {
                    property <length> dx;
                    property <length> dy;
                    // the finger across the screen while dragging, and the side it is held at (-1, 0, 1)
                    property <length> finger-x: self.x + ct.mouse-x - root.page * root.page-w;
                    property <int> side: !ct.pressed ? 0 : self.finger-x < 24 * Theme.dp ? -1 : self.finger-x > root.page-w - 24 * Theme.dp ? 1 : 0;
                    x: c.page * root.page-w + root.pad + c.col * root.cell-w + dx;
                    y: root.top + c.row * root.row-h + dy;
                    width: c.w * root.cell-w;
                    height: c.h * root.row-h;
                    z: ct.pressed ? 10 : 0;
                    opacity: ct.pressed ? 0.85 : 1;

                    ItemView {
                        c: c;
                        open-app(a) => {
                            if a == "phone" {
                                root.open-view("phone", "dial");
                            } else {
                                root.open-app(a);
                            }
                        }
                    }

                    if HomeModel.editing: Rectangle {
                        y: 2 * Theme.dp;
                        height: parent.height - 4 * Theme.dp;
                        border-radius: Theme.radius;
                        border-width: max(1px, 1.5 * Theme.dp);
                        border-color: ct.pressed ? Theme.accent : #ffffff55;
                    }

                    ct := TouchArea {
                        enabled: HomeModel.editing;
                        // the cell moves with the finger, so each move adds what moved since (Slint's drag)
                        moved => {
                            cell.dx += self.mouse-x - self.pressed-x;
                            cell.dy += self.mouse-y - self.pressed-y;
                        }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.up && (cell.dx != 0 || cell.dy != 0) {
                                // the cell under the finger, on this page
                                let col = Math.floor((c.col * root.cell-w + cell.dx + self.mouse-x) / root.cell-w);
                                let row = Math.floor((c.row * root.row-h + cell.dy + self.mouse-y) / root.row-h);
                                cell.dx = 0;
                                cell.dy = 0;
                                HomeModel.op("drop", c.page, c.index, max(0, min(3, col)), max(0, min(5, row)), "");
                            }
                        }
                    }
                    Timer {
                        interval: 400ms;
                        running: HomeModel.editing && cell.side != 0;
                        triggered => {
                            let to = c.page + cell.side;
                            cell.dx = 0;
                            cell.dy = 0;
                            HomeModel.op("edge", c.page, c.index, cell.side, 0, "");
                            if HomeModel.message == "" && to >= 0 {
                                root.page = min(to, HomeModel.pages - 1);
                            }
                        }
                    }

                    // × removes it
                    if HomeModel.editing: Rectangle {
                        x: parent.width - self.width + 6 * Theme.dp;
                        y: -6 * Theme.dp;
                        width: 36 * Theme.dp;
                        height: 36 * Theme.dp;
                        accessible-role: button;
                        accessible-label: "Remove";
                        accessible-action-default => { HomeModel.op("remove", c.page, c.index, 0, 0, ""); }
                        Rectangle {
                            width: 24 * Theme.dp;
                            height: 24 * Theme.dp;
                            border-radius: self.width / 2;
                            background: x-t.pressed ? Theme.pressed : #2a2e35;
                            Glyph {
                                source: @image-url("../icons/sys/close.svg");
                                size: 14 * Theme.dp;
                                colorize: Theme.text-secondary;
                            }
                        }

                        x-t := TouchArea {
                            clicked => { HomeModel.op("remove", c.page, c.index, 0, 0, ""); }
                        }
                    }
                }
            }

            // Lanes (G5): Events, Home, Open apps
            if root.lanes: Rectangle {
                x: 0;
                width: root.page-w;
                NeoList {
                    content-height: 22 * Theme.dp + 130 * Theme.dp + max(1, root.notes.length) * 84 * Theme.dp;
                    VerticalLayout {
                        padding: root.pad;
                        padding-top: 22 * Theme.dp;
                        spacing: 10 * Theme.dp;
                        alignment: start;
                        AgendaCard {
                            clicked => { root.open-app("calendar"); }
                        }

                        if root.notes.length == 0: Text {
                            height: 48 * Theme.dp;
                            text: "No notifications";
                            color: Theme.text-dim;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                        }
                        for n[i] in root.notes: Card {
                            height: 74 * Theme.dp;
                            background: n-t.pressed ? Theme.pressed : Theme.card;
                            accessible-role: button;
                            accessible-label: n.app + ": " + n.title;
                            accessible-action-default => { root.note-opened(i); }
                            VerticalLayout {
                                padding: 12 * Theme.dp;
                                spacing: 2 * Theme.dp;
                                Text {
                                    text: n.app + " · " + n.time;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-label;
                                    overflow: elide;
                                }

                                Text {
                                    text: n.title;
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: n.text;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-label;
                                    overflow: elide;
                                }
                            }

                            n-t := TouchArea {
                                clicked => { root.note-opened(i); }
                            }
                        }
                    }
                }
            }
            if root.lanes: Rectangle {
                x: root.page-w;
                width: root.page-w;
                NeoList {
                    content-height: root.top + max(1, HomeModel.lane-rows) * root.row-h + 8 * Theme.dp;
                    for c in HomeModel.lane-cells: Rectangle {
                        x: root.pad + c.col * root.cell-w;
                        y: root.top + c.row * root.row-h;
                        width: c.w * root.cell-w;
                        height: c.h * root.row-h;
                        ItemView {
                            c: c;
                            open-app(a) => {
                                if a == "phone" {
                                    root.open-view("phone", "dial");
                                } else {
                                    root.open-app(a);
                                }
                            }
                        }
                    }
                }
                if HomeModel.lane-cells.length == 0: Text {
                    text: "Nothing on home yet: long-press here, then Edit home";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            if root.lanes: Rectangle {
                x: 2 * root.page-w;
                width: root.page-w;
                SwitcherScreen {
                    background: transparent;
                    running: root.running;
                    thumbs: root.thumbs;
                    shown: root.page == 2;
                    open-app(a) => { root.open-app(a); }
                    close-app(a) => { root.close-app(a); }
                }
            }
        }
    }

    PageDots {
        y: parent.height - dock-h - 20 * Theme.dp;
        height: 8 * Theme.dp;
        count: root.page-count;
        current: page;
    }

    // Dock: the layout's four slots, then Apps (in every mode, D10). In edit mode a tap on a slot picks its app.
    Rectangle {
        y: parent.height - dock-h;
        height: dock-h;
        background: #0d0f13e6;
        Rectangle {
            y: 0;
            height: max(1px, Theme.dp / 2);
            background: Theme.hairline;
        }

        HorizontalLayout {
            alignment: space-around;
            padding-top: (landscape ? 7 : 10) * Theme.dp;
            for key[slot] in HomeModel.dock: Rectangle {
                width: 64 * Theme.dp;
                for app[i] in Apps.all: Rectangle {
                    if app.key == key: DockIcon {
                        x: 0;
                        y: 0;
                        compact: landscape;
                        icon: app.icon;
                        label: app.name;
                        badge: Apps.badges[i];
                        clicked => {
                            if HomeModel.editing {
                                HomeModel.dock-slot = slot;
                                HomeModel.sheet = "dock";
                            } else if key == "phone" {
                                root.open-view("phone", "dial");
                            } else {
                                root.open-app(key);
                            }
                        }
                    }
                }
                if key == "" && HomeModel.editing: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    width: (landscape ? 46 : 54) * Theme.dp;
                    height: self.width;
                    border-radius: Theme.radius;
                    border-width: max(1px, 1.5 * Theme.dp);
                    border-color: #ffffff55;
                    accessible-role: button;
                    accessible-label: "Dock slot " + (slot + 1);
                    accessible-action-default => {
                        HomeModel.dock-slot = slot;
                        HomeModel.sheet = "dock";
                    }
                    Glyph {
                        source: @image-url("../icons/sys/add.svg");
                        size: 22 * Theme.dp;
                        colorize: Theme.text-secondary;
                    }
                    TouchArea {
                        clicked => {
                            HomeModel.dock-slot = slot;
                            HomeModel.sheet = "dock";
                        }
                    }
                }
            }

            DockIcon {
                compact: landscape;
                icon: @image-url("../icons/apps/menu.svg");
                label: "Apps";
                opacity: HomeModel.editing ? 0.4 : 1;
                clicked => {
                    if !HomeModel.editing {
                        root.open-app("menu");
                    }
                }
            }
        }
    }

    // edit mode's bar (Add, the page, Done) and the Add sheet
    if HomeModel.editing: EditBar {
        y: 0;
        page <=> root.page;
        pages: root.page-count;
    }
    if HomeModel.editing: AddSheet {
        open: HomeModel.sheet != "";
        page: root.page;
    }

    // Edit home enters edit mode; Wallpaper opens Settings' picker (D7)
    home-menu := Menu {
        x: 0;
        y: 0;
        right-aligned: false;
        at-x: max(8 * Theme.dp, min(root.width - Theme.menu-w - 8 * Theme.dp, hold.pressed-x - Theme.menu-w / 2));
        at-y: min(root.height - 2 * Theme.header-h - 16 * Theme.dp - root.dock-h, hold.pressed-y);
        items: ["Edit home", "Wallpaper"];
        picked(i) => {
            if i == 0 {
                HomeModel.op("enter", 0, 0, 0, 0, "");
            } else {
                root.open-view("settings", "wallpaper");
            }
        }
    }
}
