// Settings: grouped root list (default), and the sub-pages "connectivity", "display", "about".
import { SystemSettings } from "../system-settings.slint";
import { Theme } from "../theme.slint";
import { NeoList } from "../components/scroll.slint";
import { ListRow, SectionHeader } from "../components/lists.slint";
import { Slider, Card, Button } from "../components/controls.slint";
import { WifiNet } from "../data.slint";

component Tinted inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    width: 30 * Theme.dp;
    height: self.width;
    border-radius: 8 * Theme.dp;
    background: tint;
    Image {
        width: 18 * Theme.dp;
        height: self.width;
        source: icon;
        colorize: white;
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <image> icon;
    in property <color> tint;
    callback clicked;
    height: Theme.list-row-h;
    background: t.pressed ? Theme.pressed : transparent;
    HorizontalLayout {
        padding-left: Theme.margin + 4 * Theme.dp;
        padding-right: Theme.margin + 4 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Tinted {
                icon: icon;
                tint: tint;
            }
        }

        Text {
            text: title;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: value;
            color: Theme.text-dim;
            font-size: Theme.font-label;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Image {
                width: 18 * Theme.dp;
                height: self.width;
                source: @image-url("../icons/sys/chevron_right.svg");
                colorize: Theme.text-dim;
            }
        }
    }

    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The sheet a tapped Wi-Fi network opens (Android/iOS style): what the phone knows about it, the password and
// Connect. Joining comes with Wi-Fi W4 (docs wifi.md); until then Connect says so instead of pretending.
component WifiSheet inherits Rectangle {
    in property <WifiNet> net;
    callback closed;
    property <bool> tried;
    background: #000000b0;
    TouchArea { clicked => { root.closed(); } }

    Rectangle {
        x: 0;
        width: root.width;
        height: card.preferred-height;
        y: root.height - self.height;
        background: Theme.bg-raised;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
        TouchArea { }  // taps on the card don't close it

        card := VerticalLayout {
            padding: 20 * Theme.dp;
            spacing: 14 * Theme.dp;
            Text { text: net.name; font-size: Theme.font-title; font-weight: 600; color: Theme.text; }
            Text {
                text: "Signal " + net.signal + " · " + (net.secured ? "Secured (WPA2/WPA3)" : "Open") + " · " + net.band + " · channel " + net.channel;
                font-size: Theme.font-label;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            if net.secured: Rectangle {
                height: 48 * Theme.dp;
                border-radius: 8 * Theme.dp;
                border-width: 1px;
                border-color: Theme.text-dim;
                Text { x: 14 * Theme.dp; text: "Password"; color: Theme.text-dim; font-size: Theme.font-body; }
            }
            if tried: Text {
                text: "Connecting to networks is the next Wi-Fi step. The phone can already find this network.";
                font-size: Theme.font-status;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12 * Theme.dp;
                Button { text: "Cancel"; primary: false; clicked => { root.closed(); } }
                Button { text: "Connect"; clicked => { root.tried = true; } }
            }
        }
    }
}

export component SettingsScreen inherits Rectangle {
    in-out property <string> view;
    // in: which build is running, one line each for the kernel, the user-side ROM and neoui (the UI server reads them)
    in property <[string]> build;
    in property <string> battery-text: "--%";
    in property <string> battery-voltage: "unknown";
    in property <string> battery-state: "Unknown";
    in property <string> battery-usb: "unknown";
    in property <string> battery-storage;
    in property <[float]> battery-history;
    in property <string> wifi-status: "Searching…";
    in property <[WifiNet]> wifi-networks;
    in property <int> wifi-count;  // named networks (hidden ones not counted)
    in property <int> wifi-hidden;
    in property <bool> wifi-scanning;
    callback wifi-refresh();
    // the network whose sheet is open: a copy, so a rescan that reorders the list can't swap it
    property <WifiNet> wifi-current;
    property <bool> wifi-sheet;
    // the switches below show and edit the system settings (SystemSettings, kept by the UI server)
    property <bool> wifi: SystemSettings.wifi;
    property <bool> bluetooth: SystemSettings.bluetooth;
    property <bool> data: SystemSettings.mobile-data;
    property <bool> dark: SystemSettings.dark;

    if view == "": NeoList {
        VerticalLayout {
            SectionHeader { text: "Connections"; }
            SettingRow {
                title: "Wi-Fi";
                value: wifi ? "Not connected" : "Off";
                icon: @image-url("../icons/sys/wifi.svg");
                tint: #2f80ed;
                clicked => { root.view = "wifi"; }
            }

            SettingRow {
                title: "Bluetooth";
                value: bluetooth ? "On" : "Off";
                icon: @image-url("../icons/sys/bluetooth.svg");
                tint: #2f80ed;
                clicked => { root.view = "connectivity"; }
            }

            SettingRow {
                title: "Mobile network";
                value: data ? "4G" : "Off";
                icon: @image-url("../icons/sys/signal.svg");
                tint: #22b46a;
                clicked => { root.view = "connectivity"; }
            }

            SectionHeader { text: "Device"; }
            SettingRow {
                title: "Display";
                value: dark ? "Dark" : "Light";
                icon: @image-url("../icons/sys/brightness.svg");
                tint: #e2a92a;
                clicked => { root.view = "display"; }
            }

            SettingRow {
                title: "Sounds";
                value: "Ringing";
                icon: @image-url("../icons/sys/volume.svg");
                tint: #e5484d;
            }

            SettingRow {
                title: "Battery";
                value: battery-text;
                clicked => { root.view = "battery"; }
                icon: @image-url("../icons/sys/battery_saver.svg");
                tint: #14a37f;
            }

            SettingRow {
                title: "Apps";
                value: "12";
                icon: @image-url("../icons/sys/apps.svg");
                tint: #8656e8;
            }

            SectionHeader { text: "System"; }
            SettingRow {
                title: "Language";
                value: "English";
                icon: @image-url("../icons/sys/language.svg");
                tint: #1fa9c4;
            }

            SettingRow {
                title: "Privacy";
                icon: @image-url("../icons/sys/privacy.svg");
                tint: #5b6472;
            }

            SettingRow {
                title: "Developer options";
                value: SystemSettings.usb-debugging ? "USB debugging" : "Off";
                icon: @image-url("../icons/sys/usb.svg");
                tint: #5b6472;
                clicked => { root.view = "developer"; }
            }

            SettingRow {
                title: "About phone";
                icon: @image-url("../icons/sys/info.svg");
                tint: #5b6472;
                clicked => { root.view = "about"; }
            }
        }
    }

    if view == "connectivity": NeoList {
        VerticalLayout {
            SectionHeader { text: "Wireless"; }
            ListRow {
                title: "Wi-Fi";
                subtitle: wifi ? wifi-status : "Off";
                chevron: true;
                clicked => { root.view = "wifi"; }
                has-icon: true;
                icon: @image-url("../icons/sys/wifi.svg");
                has-switch: true;
                switch-on <=> SystemSettings.wifi;
            }

            ListRow {
                title: "Bluetooth";
                subtitle: bluetooth ? "Visible to nearby devices" : "Off";
                has-icon: true;
                icon: @image-url("../icons/sys/bluetooth.svg");
                has-switch: true;
                switch-on <=> SystemSettings.bluetooth;
            }

            SectionHeader { text: "Mobile"; }
            ListRow {
                title: "Mobile data";
                subtitle: data ? "4G · 1.2 GB this month" : "Off";
                has-icon: true;
                icon: @image-url("../icons/sys/data.svg");
                has-switch: true;
                switch-on <=> SystemSettings.mobile-data;
            }

            ListRow {
                title: "Airplane mode";
                has-icon: true;
                icon: @image-url("../icons/sys/lock.svg");
                has-switch: true;
                switch-on <=> SystemSettings.airplane;
                divider: false;
            }
        }
    }

    if view == "developer": NeoList {
        VerticalLayout {
            SectionHeader { text: "Debugging"; }
            ListRow {
                title: "USB debugging";
                subtitle: SystemSettings.usb-debugging ? "Shell on the second USB port (phone.py sh)" : "Off";
                has-icon: true;
                icon: @image-url("../icons/sys/usb.svg");
                has-switch: true;
                switch-on <=> SystemSettings.usb-debugging;
                divider: false;
            }
        }
    }

    if view == "display": NeoList {
        VerticalLayout {
            SectionHeader { text: "Brightness"; }
            HorizontalLayout {
                padding-left: Theme.margin + 8 * Theme.dp;
                padding-right: Theme.margin + 8 * Theme.dp;
                height: 56 * Theme.dp;
                Slider {
                    value <=> SystemSettings.brightness;
                }
            }

            SectionHeader { text: "Appearance"; }
            ListRow {
                title: "Dark theme";
                has-icon: true;
                icon: @image-url("../icons/sys/theme.svg");
                has-switch: true;
                switch-on <=> SystemSettings.dark;
            }

            ListRow {
                title: "24-hour time";
                has-icon: true;
                icon: @image-url("../icons/sys/stopwatch.svg");
                has-switch: true;
                switch-on <=> SystemSettings.clock-24h;
            }

            ListRow {
                title: "Font size";
                value: "Medium";
                has-icon: true;
                icon: @image-url("../icons/sys/edit.svg");
                chevron: true;
            }

            // a tap steps through the choices (no picker widget yet)
            ListRow {
                title: "Screen timeout";
                value: SystemSettings.screen-timeout == 0 ? "Never"
                    : SystemSettings.screen-timeout < 60 ? "\{SystemSettings.screen-timeout} seconds"
                    : SystemSettings.screen-timeout == 60 ? "1 minute"
                    : "\{SystemSettings.screen-timeout / 60} minutes";
                has-icon: true;
                icon: @image-url("../icons/sys/stopwatch.svg");
                divider: false;
                clicked => {
                    SystemSettings.screen-timeout = SystemSettings.screen-timeout == 15 ? 30
                        : SystemSettings.screen-timeout == 30 ? 60 : SystemSettings.screen-timeout == 60 ? 120
                        : SystemSettings.screen-timeout == 120 ? 300 : SystemSettings.screen-timeout == 300 ? 600
                        : SystemSettings.screen-timeout == 600 ? 0 : 15;
                }
            }
        }
    }

    if view == "about": NeoList {
        VerticalLayout {
            padding: Theme.margin;
            spacing: 12 * Theme.dp;
            alignment: start;
            Card {
                height: 132 * Theme.dp;
                VerticalLayout {
                    padding: Theme.card-pad;
                    spacing: 4 * Theme.dp;
                    alignment: center;
                    Text {
                        text: "NeoSymbian";
                        color: Theme.text;
                        font-size: Theme.font-title * 1.3;
                        font-weight: 700;
                    }

                    Text {
                        text: "Developer preview · neoui";
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                    }

                    Text {
                        text: "EKA2 on AArch64 (ILP32) · 2010 user side";
                        color: Theme.text-dim;
                        font-size: Theme.font-label;
                    }
                }
            }

            for kv in [["Model", "Pixel 3a XL (bonito)"], ["Kernel", "EKA2, AArch64 ILP32"], ["User side", "Symbian^3 (2010), ARMv5TE"], ["UI", "neoui (Rust + Slint)"]]: HorizontalLayout {
                height: 40 * Theme.dp;
                padding-left: 4 * Theme.dp;
                padding-right: 4 * Theme.dp;
                Text {
                    text: kv[0];
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: kv[1];
                    color: Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "Build";
                color: Theme.text-dim;
                font-size: Theme.font-label;
            }

            for line in (build.length > 0 ? build : ["—"]): Text {
                text: line;
                color: Theme.text;
                font-size: Theme.font-label;
                wrap: word-wrap;
            }
        }
    }

    if view == "wifi": Rectangle {
        NeoList {
            VerticalLayout {
                ListRow {
                    title: "Wi-Fi";
                    subtitle: wifi ? "Not connected" : "Off";
                    has-icon: true;
                    icon: @image-url("../icons/sys/wifi.svg");
                    has-switch: true;
                    switch-on <=> SystemSettings.wifi;
                }

                // the section header with "Searching…" and the refresh button on its baseline
                if wifi: Rectangle {
                    height: 48 * Theme.dp;
                    SectionHeader { y: parent.height - self.height; width: parent.width; text: "Available networks"; }
                    Text {
                        x: parent.width - self.width - 56 * Theme.dp;
                        y: parent.height - self.height - 6 * Theme.dp;
                        text: wifi-scanning ? "Searching…" : "";
                        color: Theme.text-dim;
                        font-size: Theme.font-status;
                    }
                    Image {
                        width: 22 * Theme.dp;
                        height: self.width;
                        x: parent.width - self.width - Theme.margin;
                        y: parent.height - self.height - 4 * Theme.dp;
                        source: @image-url("../icons/sys/refresh.svg");
                        colorize: wifi-scanning ? Theme.text-dim : Theme.accent;
                    }
                    TouchArea {
                        x: parent.width - 64 * Theme.dp;
                        width: 64 * Theme.dp;
                        clicked => { if !wifi-scanning { root.wifi-refresh(); } }
                    }
                }

                for net in (wifi ? wifi-networks : []): ListRow {
                    title: net.name;
                    subtitle: net.detail;
                    has-icon: true;
                    icon: @image-url("../icons/sys/wifi.svg");
                    icon-tint: net.bars >= 3 ? Theme.text : net.bars >= 1 ? Theme.text-secondary : Theme.text-dim;
                    clicked => {
                        root.wifi-current = net;
                        root.wifi-sheet = true;
                    }
                }

                if wifi && wifi-networks.length == 0: Text {
                    x: Theme.margin;
                    height: 64 * Theme.dp;
                    vertical-alignment: center;
                    text: wifi-scanning ? "Looking for networks…" : "No networks found. Tap refresh to search again.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
                if wifi && wifi-hidden > 0: Text {
                    x: Theme.margin;
                    height: 48 * Theme.dp;
                    vertical-alignment: center;
                    text: wifi-hidden == 1 ? "1 hidden network nearby" : wifi-hidden + " hidden networks nearby";
                    color: Theme.text-dim;
                    font-size: Theme.font-status;
                }
                if !wifi: Text {
                    x: Theme.margin;
                    height: 64 * Theme.dp;
                    vertical-alignment: center;
                    text: "Turn on Wi-Fi to see available networks.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
            }
        }
        if wifi-sheet: WifiSheet {
            width: parent.width;
            height: parent.height;
            net: wifi-current;
            closed => { root.wifi-sheet = false; }
        }
    }

    if view == "battery": NeoList {
        VerticalLayout {
            spacing: 14 * Theme.dp;
            padding: Theme.margin;
            Text { text: battery-text; font-size: Theme.font-title * 2; color: Theme.text; }
            Text { text: battery-state + " · USB " + battery-usb; font-size: Theme.font-body; color: Theme.text-secondary; wrap: word-wrap; }
            Text { text: "Battery voltage: " + battery-voltage; font-size: Theme.font-label; color: Theme.text; }
            Text { text: "Reported by the PMIC · battery profile unverified"; font-size: Theme.font-status; color: Theme.text-dim; wrap: word-wrap; }
            SectionHeader { text: "Battery level · last 24 hours"; }
            chart := Rectangle {
                height: 180 * Theme.dp;
                background: #151719;
                for value[i] in battery-history: Rectangle {
                    x: i / 1440 * chart.width;
                    width: chart.width / 1440;
                    height: value < 0 ? 0px : max(1px, value * (chart.height - 20 * Theme.dp));
                    y: chart.height - self.height;
                    background: #22b46a;
                }
            }
            HorizontalLayout {
                Text { text: "24 hours ago"; font-size: Theme.font-status; color: Theme.text-dim; }
                Text { text: "Now"; horizontal-stretch: 1; horizontal-alignment: right; font-size: Theme.font-status; color: Theme.text-dim; }
            }
            Text { text: "0–100% · one sample per minute. Gaps mean no reading; history begins with real observations."; font-size: Theme.font-status; color: Theme.text-dim; wrap: word-wrap; }
            Text { text: battery-storage; font-size: Theme.font-status; color: Theme.text-dim; wrap: word-wrap; }
        }
    }
}
