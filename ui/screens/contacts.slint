// Contacts: A-Z list with search and a favourites strip (default), a contact card ("card").
import { Theme } from "../theme.slint";
import { Data } from "../data.slint";
import { SearchField, RoundButton } from "../components/controls.slint";
import { ListRow, SectionHeader, Avatar } from "../components/lists.slint";

export component ContactsScreen inherits Rectangle {
    in-out property <string> view;
    in-out property <int> current: 0;
    callback open-app(string);
    if view == "": Flickable {
        VerticalLayout {
            padding-top: 8 * Theme.dp;
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: Theme.margin;
                padding-bottom: 4 * Theme.dp;
                SearchField {
                    placeholder: "Search " + Data.people.length + " contacts";
                }
            }

            SectionHeader {
                text: "Favourites";
            }

            for p[i] in Data.people: ListRow {
                visible: p.favourite;
                height: p.favourite ? Theme.list-row-h + 8 * Theme.dp : 0;
                title: p.name;
                avatar: p.initials;
                avatar-tint: p.tint;
                clicked => {
                    root.current = i;
                    root.view = "card";
                }
            }
            SectionHeader {
                text: "All contacts";
            }

            for p[i] in Data.people: ListRow {
                height: Theme.list-row-h + 8 * Theme.dp;
                title: p.name;
                avatar: p.initials;
                avatar-tint: p.tint;
                clicked => {
                    root.current = i;
                    root.view = "card";
                }
            }
        }
    }

    if view == "card": Flickable {
        VerticalLayout {
            padding-top: 28 * Theme.dp;
            spacing: 10 * Theme.dp;
            HorizontalLayout {
                alignment: center;
                Avatar {
                    initials: Data.people[current].initials;
                    tint: Data.people[current].tint;
                    size: Theme.avatar-large;
                }
            }

            Text {
                text: Data.people[current].name;
                color: Theme.text;
                font-size: Theme.font-title * 1.3;
                font-weight: 600;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                padding-top: 10 * Theme.dp;
                padding-bottom: 14 * Theme.dp;
                alignment: center;
                spacing: 28 * Theme.dp;
                RoundButton {
                    icon: @image-url("../icons/sys/call.svg");
                    label: "Call";
                    fill: Theme.ok;
                    clicked => { root.open-app("phone"); }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/message.svg");
                    label: "Message";
                    fill: Theme.accent;
                    clicked => { root.open-app("messages"); }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/video.svg");
                    label: "Video";
                }
            }

            ListRow {
                title: Data.people[current].number;
                subtitle: Data.people[current].label;
                icon: @image-url("../icons/sys/call.svg");
                has-icon: true;
            }

            ListRow {
                title: Data.people[current].initials.to-lowercase() + "@example.org";
                subtitle: "Email";
                icon: @image-url("../icons/sys/message.svg");
                has-icon: true;
            }

            ListRow {
                title: Data.people[current].favourite ? "In favourites" : "Add to favourites";
                icon: @image-url("../icons/sys/star.svg");
                has-icon: true;
                icon-tint: Data.people[current].favourite ? #f2c94c : Theme.text;
                divider: false;
            }
        }
    }
}
