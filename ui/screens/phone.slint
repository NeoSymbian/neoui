// SPDX-License-Identifier: Apache-2.0
// Phone: dialer (default), Recents ("log", "logdetail"), speed dial ("speed"), in-call ("call"). The call comes from
// the modem (telephony C5): the UI server sets call-state / call-number / call-incoming (+ muted / speaker /
// call-volume, C6) and acts on `action` ("answer", "hangup", "mute"/"speaker" + "1"/"0", "dtmf" + key). The dialer,
// Recents and speed dial (C8) go through PhoneData.
import { Theme } from "../theme.slint";
import { NeoList } from "../components/scroll.slint";
import { TabBar, RoundButton, Button } from "../components/controls.slint";
import { ListRow, Avatar } from "../components/lists.slint";
import { Glyph } from "../components/frame.slint";
import { PhoneData, SpeedCell } from "../phone-data.slint";

component Key inherits Rectangle {
    in property <string> digit;
    in property <string> letters;
    callback pressed(string);
    // held 0.6 s (Symbian^3): 1 calls the voice mailbox, 2..9 speed-dial (the UI server decides)
    callback long-pressed(string);
    property <duration> down-at;
    height: Theme.key-h;
    border-radius: Theme.radius;
    background: t.pressed ? Theme.pressed : transparent;
    VerticalLayout {
        alignment: center;
        Text {
            text: digit;
            color: Theme.text;
            font-size: 30 * Theme.dp;
            font-weight: 400;
            horizontal-alignment: center;
        }

        Text {
            text: letters;
            color: Theme.text-dim;
            font-size: 10.5 * Theme.dp;
            letter-spacing: 1.5 * Theme.dp;
            horizontal-alignment: center;
        }
    }

    t := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.down-at = animation-tick();
            }
        }
        clicked => {
            if animation-tick() - root.down-at >= 600ms {
                root.long-pressed(digit);
            } else {
                root.pressed(digit);
            }
        }
    }
}

export struct LiveCall { id: int, number: string, state: string, incoming: bool, held: bool, waiting: bool }

export component PhoneScreen inherits Rectangle {
    in-out property <string> view;
    // in: the call's audio (telephony C6, from NeoModem): the buttons show what the phone does, not a guess
    in property <bool> muted;
    in property <bool> speaker;
    // the volume step 0..10 while a call's audio runs, else -1
    in property <int> call-volume: -1;
    property <bool> pad;
    // the in-call keypad closes with the call view
    changed view => {
        if (root.view != "call") {
            root.pad = false;
        }
    }
    // in: the modem's call: "" (none), "Calling…", "Ringing", "Incoming call", "Connected", "Call ended"
    in property <string> call-state;
    in property <string> call-number;
    in property <bool> call-incoming;
    in property <[LiveCall]> calls;
    in property <bool> pending;
    in property <string> feedback;
    callback action(string, string);
    property <int> tab: view == "log" || view == "logdetail" ? 1 : view == "speed" ? 2 : 0;
    TabBar {
        y: 0;
        tabs: ["Keypad", "Recent", "Speed dial"];
        current: tab;
        visible: view != "call";
        tab-clicked(i) => {
            root.view = i == 1 ? "log" : i == 2 ? "speed" : "";
            if i == 1 {
                PhoneData.act("log-tab", PhoneData.log-tab);
            } else if i == 2 {
                PhoneData.act("speed-show", "");
            }
        }
    }

    if view != "call" && calls.length > 0: Button {
        y: Theme.tab-h;
        x: Theme.margin;
        width: parent.width - 2 * Theme.margin;
        text: "Return to call";
        clicked => { root.view = "call"; }
    }

    // Dialer: the number (or "Enter number or name"), the contacts its digits spell, the keypad
    if view == "": Rectangle {
        y: Theme.tab-h + (calls.length > 0 ? Theme.field-h : 0px);
        height: parent.height - self.y;
        VerticalLayout {
            padding-left: 28 * Theme.dp;
            padding-right: 28 * Theme.dp;
            padding-bottom: 18 * Theme.dp;
            spacing: 4 * Theme.dp;
            // smart-dial matches, the best one nearest the number
            VerticalLayout {
                vertical-stretch: 1;
                alignment: end;
                min-height: 90 * Theme.dp;
                for m[i] in PhoneData.matches: Rectangle {
                    visible: i < 3;
                    height: i < 3 ? 34 * Theme.dp : 0;
                    background: mt.pressed ? Theme.pressed : transparent;
                    border-radius: Theme.radius-small;
                    HorizontalLayout {
                        padding-left: 8 * Theme.dp;
                        padding-right: 8 * Theme.dp;
                        Text {
                            text: m.name;
                            font-family: "DejaVu Sans";
                            color: Theme.text;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: m.number;
                            color: Theme.text-secondary;
                            font-size: Theme.font-label;
                            vertical-alignment: center;
                        }
                    }
                    mt := TouchArea {
                        clicked => { PhoneData.act("dial-match", m.id); }
                    }
                }
                Text {
                    text: PhoneData.number == "" ? "Enter number or name" : PhoneData.number;
                    color: PhoneData.number == "" ? Theme.text-dim : Theme.text;
                    font-size: PhoneData.number == "" ? Theme.font-title : 34 * Theme.dp;
                    font-weight: 300;
                    horizontal-alignment: center;
                    overflow: elide;
                    width: parent.width;
                }
                if PhoneData.number != "": Text {
                    text: "Add to contacts";
                    color: Theme.accent;
                    font-size: Theme.font-label;
                    horizontal-alignment: center;
                    TouchArea {
                        clicked => { PhoneData.act("add-contact", PhoneData.number); }
                    }
                }
            }

            for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                for d in row: Key {
                    digit: d;
                    letters: d == "2" ? "ABC" : d == "3" ? "DEF" : d == "4" ? "GHI" : d == "5" ? "JKL" : d == "6" ? "MNO" : d == "7" ? "PQRS" : d == "8" ? "TUV" : d == "9" ? "WXYZ" : d == "0" ? "+" : d == "1" ? "∞" : d == "*" ? "+ p w" : "";
                    pressed(c) => { PhoneData.act("key", c); }
                    long-pressed(c) => { PhoneData.act("key-long", c); }
                }
            }
            HorizontalLayout {
                padding-top: 10 * Theme.dp;
                alignment: space-around;
                Rectangle { width: 56 * Theme.dp; }

                RoundButton {
                    icon: @image-url("../icons/sys/call.svg");
                    size: 68 * Theme.dp;
                    fill: Theme.ok;
                    // an empty number opens Recents (Symbian^3); the UI server dials and opens the call view
                    clicked => { PhoneData.act("call", ""); }
                }

                bs := RoundButton {
                    icon: @image-url("../icons/sys/backspace.svg");
                    fill: transparent;
                    opacity: PhoneData.number == "" ? 0.35 : 1;
                    clicked => { PhoneData.act("backspace", ""); }
                }
            }
        }
    }

    // Recents: missed, received, dialled
    if view == "log": Rectangle {
        y: Theme.tab-h;
        height: parent.height - Theme.tab-h;
        TabBar {
            y: 0;
            tabs: ["Missed", "Received", "Dialled"];
            current: PhoneData.log-tab;
            tab-clicked(i) => {
                PhoneData.log-tab = i;
                PhoneData.act("log-tab", i);
            }
        }
        NeoList {
            y: Theme.tab-h;
            height: parent.height - Theme.tab-h;
            VerticalLayout {
                if PhoneData.log.length == 0: Text {
                    height: 120 * Theme.dp;
                    text: PhoneData.log-tab == 0 ? "No missed calls" : PhoneData.log-tab == 1 ? "No received calls" : "No dialled calls";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for c in PhoneData.log: ListRow {
                    title: c.title + (c.count > 1 ? " (" + c.count + ")" : "");
                    title-font: "DejaVu Sans";
                    subtitle: c.subtitle;
                    value: c.when;
                    has-icon: true;
                    icon: c.kind == 3 || c.kind == 4 ? @image-url("../icons/sys/missed_call.svg") : @image-url("../icons/sys/call.svg");
                    icon-tint: c.kind == 3 ? Theme.danger : c.kind == 1 ? Theme.ok : Theme.text;
                    chevron: true;
                    clicked => {
                        PhoneData.act("log-open", c.id);
                        root.view = "logdetail";
                    }
                }
            }
        }
    }

    if view == "logdetail": NeoList {
        y: Theme.tab-h;
        height: parent.height - Theme.tab-h;
        VerticalLayout {
            alignment: start;
            padding-top: 16 * Theme.dp;
            spacing: 4 * Theme.dp;
            Text {
                text: PhoneData.detail.title;
                font-family: "DejaVu Sans";
                color: Theme.text;
                font-size: Theme.font-title * 1.2;
                font-weight: 600;
                horizontal-alignment: center;
            }
            ListRow { title: "Direction"; value: PhoneData.detail.direction; }
            ListRow { title: "Time"; value: PhoneData.detail.when; }
            if PhoneData.detail.duration != "": ListRow { title: "Duration"; value: PhoneData.detail.duration; }
            if PhoneData.detail.number != "": ListRow { title: "Tel no"; value: PhoneData.detail.number; }
            HorizontalLayout {
                padding: Theme.margin;
                spacing: 10 * Theme.dp;
                if PhoneData.detail.number != "": Button {
                    text: "Call";
                    tint: Theme.ok;
                    clicked => { PhoneData.act("dial", PhoneData.detail.number); }
                }
                if PhoneData.detail.number != "": Button {
                    text: PhoneData.detail.known ? "Contact" : "Add to contacts";
                    primary: false;
                    clicked => { PhoneData.act(PhoneData.detail.known ? "open-contact" : "add-contact", PhoneData.detail.number); }
                }
                Button {
                    text: "Delete";
                    tint: Theme.danger;
                    clicked => {
                        PhoneData.act("log-delete", PhoneData.detail.id);
                        root.view = "log";
                    }
                }
            }
        }
    }

    // Speed dial: 1 is the voice mailbox; 2..9 call their numbers, an empty key offers to assign one
    if view == "speed": Rectangle {
        y: Theme.tab-h;
        height: parent.height - Theme.tab-h;
        VerticalLayout {
            padding: 16 * Theme.dp;
            spacing: 10 * Theme.dp;
            for row in [[1, 2, 3], [4, 5, 6], [7, 8, 9]]: HorizontalLayout {
                spacing: 10 * Theme.dp;
                vertical-stretch: 1;
                for k in row: Rectangle {
                    property <SpeedCell> cell: k == 1 ? { key: 1, name: "Voice mail", number: "" } : PhoneData.speed[k - 2];
                    // equal cells whatever their text
                    preferred-width: 1px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius;
                    background: st.pressed ? Theme.pressed : Theme.field;
                    VerticalLayout {
                        alignment: center;
                        padding: 6 * Theme.dp;
                        Text {
                            text: k;
                            color: Theme.text-dim;
                            font-size: Theme.font-label;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: cell.name != "" ? cell.name : cell.number != "" ? cell.number : "Assign";
                            font-family: "DejaVu Sans";
                            color: cell.name == "" && cell.number == "" ? Theme.text-dim : Theme.text;
                            font-size: Theme.font-body;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    st := TouchArea {
                        clicked => { PhoneData.act("speed", k); }
                    }
                }
            }
            if PhoneData.assigning > 0: Text {
                text: "Choose a contact for key " + PhoneData.assigning;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                horizontal-alignment: center;
            }
        }
    }

    // In call
    if view == "call": Rectangle {
        background: @linear-gradient(180deg, #10233f 0%, #000000 100%);
        NeoList {
        VerticalLayout {
            padding: 24 * Theme.dp;
            padding-top: (calls.length > 1 ? 12 : 32) * Theme.dp;
            spacing: 12 * Theme.dp;
            if !pad && calls.length <= 1: HorizontalLayout {
                alignment: center;
                Avatar {
                    initials: "#";
                    tint: Theme.accent;
                    size: Theme.avatar-large;
                }
            }

            Text {
                text: call-number;
                font-family: "DejaVu Sans";
                color: Theme.text;
                font-size: Theme.font-title * 1.3;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }

            if PhoneData.call-detail != "": Text {
                text: PhoneData.call-detail;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }

            if feedback != "" || pending: Text {
                text: pending ? "Please wait…" : feedback;
                color: pending ? Theme.text-secondary : Theme.danger;
                font-size: Theme.font-label;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if calls.length > 1 && !pad: VerticalLayout {
                spacing: 6 * Theme.dp;
                for c in calls: VerticalLayout {
                    spacing: 4 * Theme.dp;
                    Text {
                        text: c.number + " · " + c.state;
                        color: Theme.text-secondary;
                        font-size: Theme.font-label;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6 * Theme.dp;
                        if c.incoming || c.waiting: Button {
                            text: "Answer";
                            tint: Theme.ok;
                            clicked => { if !root.pending { root.action("answer", c.id); } }
                        }
                        if !c.incoming && !c.waiting: Button {
                            text: c.held ? "Resume" : "Hold";
                            primary: false;
                            clicked => { if !root.pending { root.action(c.held ? "resume" : "hold", c.id); } }
                        }
                        Button {
                            text: c.incoming || c.waiting ? "Reject" : "End";
                            tint: Theme.danger;
                            clicked => { if !root.pending { root.action("hangup", c.id); } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6 * Theme.dp;
                    Button { text: "Swap"; primary: false; clicked => { if !root.pending { root.action("swap", ""); } } }
                    Button { text: "Merge"; primary: false; clicked => { if !root.pending { root.action("merge", ""); } } }
                }
            }

            Text {
                text: (call-state != "" ? call-state : "Calling…") + (PhoneData.call-time != "" ? "  ·  " + PhoneData.call-time : "") + (call-volume >= 0 ? "  ·  Volume " + call-volume : "");
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }

            // in-call keypad: each key sends its tone to the other side (DTMF)
            if pad: VerticalLayout {
                spacing: 4 * Theme.dp;
                for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    for d in row: Key {
                        digit: d;
                        letters: "";
                        pressed(c) => {
                            root.action("dtmf", c);
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            if calls.length == 1 && !call-incoming && !pad: Button {
                text: call-state == "On hold" ? "Resume" : "Hold";
                primary: false;
                clicked => { if !root.pending { root.action(call-state == "On hold" ? "resume" : "hold", ""); } }
            }

            if !call-incoming && !pad: Button {
                text: "Add call";
                primary: false;
                clicked => { root.view = ""; }
            }

            HorizontalLayout {
                alignment: space-around;
                RoundButton {
                    icon: muted ? @image-url("../icons/sys/mic_off.svg") : @image-url("../icons/sys/mic.svg");
                    label: "Mute";
                    active: muted;
                    clicked => { root.action("mute", muted ? "0" : "1"); }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/keypad.svg");
                    label: "Keypad";
                    active: pad;
                    clicked => { root.pad = !root.pad; }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/speaker.svg");
                    label: "Speaker";
                    active: speaker;
                    clicked => { root.action("speaker", speaker ? "0" : "1"); }
                }
            }

            Rectangle { height: 18 * Theme.dp; }

            HorizontalLayout {
                alignment: space-around;
                if call-incoming && (call-state == "Incoming call" || call-state == "Call waiting"): RoundButton {
                    icon: @image-url("../icons/sys/call.svg");
                    size: 68 * Theme.dp;
                    fill: Theme.ok;
                    clicked => {
                        root.action("answer", "");
                    }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/end_call.svg");
                    size: 68 * Theme.dp;
                    fill: Theme.danger;
                    // the view closes when the modem says the call is over (phone.rs), not on a guess
                    clicked => {
                        root.action("hangup", "");
                    }
                }
            }
        }
        }
    }

    if PhoneData.note != "" && view != "call": Rectangle {
        y: parent.height - self.height - 12 * Theme.dp;
        x: Theme.margin;
        width: parent.width - 2 * Theme.margin;
        height: nt.preferred-height + 20 * Theme.dp;
        border-radius: Theme.radius;
        background: Theme.bg-raised;
        nt := Text {
            text: PhoneData.note;
            font-family: "DejaVu Sans";
            color: Theme.text;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: parent.width - 24 * Theme.dp;
        }
        TouchArea { clicked => { PhoneData.act("note-dismiss", ""); } }
    }
}
