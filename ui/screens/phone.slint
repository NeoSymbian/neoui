// SPDX-License-Identifier: Apache-2.0
// Phone: dialer (default), call log ("log"), in-call ("call"). The call comes from the modem (telephony C5): the UI
// server sets call-state / call-number / call-incoming and acts on `action` ("dial" + number, "answer", "hangup").
import { Theme } from "../theme.slint";
import { NeoList } from "../components/scroll.slint";
import { Data } from "../data.slint";
import { TabBar, RoundButton } from "../components/controls.slint";
import { ListRow, Avatar } from "../components/lists.slint";
import { Glyph } from "../components/frame.slint";

component Key inherits Rectangle {
    in property <string> digit;
    in property <string> letters;
    callback pressed(string);
    height: Theme.key-h;
    border-radius: Theme.radius;
    background: t.pressed ? Theme.pressed : transparent;
    VerticalLayout {
        alignment: center;
        Text {
            text: digit;
            color: Theme.text;
            font-size: 30 * Theme.dp;
            font-weight: 400;
            horizontal-alignment: center;
        }

        Text {
            text: letters;
            color: Theme.text-dim;
            font-size: 10.5 * Theme.dp;
            letter-spacing: 1.5 * Theme.dp;
            horizontal-alignment: center;
        }
    }

    t := TouchArea {
        clicked => {
            root.pressed(digit);
        }
    }
}

export component PhoneScreen inherits Rectangle {
    in-out property <string> view;
    in-out property <string> number: "";
    in-out property <bool> muted;
    in-out property <bool> speaker;
    // in: the modem's call: "" (none), "Calling…", "Ringing", "Incoming call", "Connected", "Call ended"
    in property <string> call-state;
    in property <string> call-number;
    in property <bool> call-incoming;
    callback action(string, string);
    property <int> tab: view == "log" ? 1 : 0;
    TabBar {
        y: 0;
        tabs: ["Keypad", "Recent"];
        current: tab;
        visible: view != "call";
        tab-clicked(i) => {
            root.view = i == 1 ? "log" : "";
        }
    }

    // Dialer
    if view == "": Rectangle {
        y: Theme.tab-h;
        height: parent.height - Theme.tab-h;
        VerticalLayout {
            padding-left: 28 * Theme.dp;
            padding-right: 28 * Theme.dp;
            padding-bottom: 18 * Theme.dp;
            spacing: 4 * Theme.dp;
            Rectangle {
                vertical-stretch: 1;
                min-height: 90 * Theme.dp;
                Text {
                    text: number == "" ? "Enter number" : number;
                    color: number == "" ? Theme.text-dim : Theme.text;
                    font-size: number == "" ? Theme.font-title : 34 * Theme.dp;
                    font-weight: 300;
                    horizontal-alignment: center;
                    width: parent.width;
                }
            }

            for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                for d in row: Key {
                    digit: d;
                    letters: d == "2" ? "ABC" : d == "3" ? "DEF" : d == "4" ? "GHI" : d == "5" ? "JKL" : d == "6" ? "MNO" : d == "7" ? "PQRS" : d == "8" ? "TUV" : d == "9" ? "WXYZ" : d == "0" ? "+" : d == "1" ? "∞" : "";
                    pressed(c) => {
                        root.number += c;
                    }
                }
            }
            HorizontalLayout {
                padding-top: 10 * Theme.dp;
                alignment: space-around;
                Rectangle { width: 56 * Theme.dp; }

                RoundButton {
                    icon: @image-url("../icons/sys/call.svg");
                    size: 68 * Theme.dp;
                    fill: Theme.ok;
                    clicked => {
                        if (root.number != "") {
                            root.action("dial", root.number);
                            root.view = "call";
                        }
                    }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/backspace.svg");
                    fill: transparent;
                    opacity: number == "" ? 0.35 : 1;
                    // shortcut: Slint has no substring, so this clears the number; per-digit delete when the dialer moves to Rust
                    clicked => {
                        root.number = "";
                    }
                }
            }
        }
    }

    // Call log
    if view == "log": NeoList {
        y: Theme.tab-h;
        height: parent.height - Theme.tab-h;
        VerticalLayout {
            for c in Data.calls: ListRow {
                title: c.name;
                subtitle: c.kind == "missed" ? "Missed call" : c.kind == "out" ? "Outgoing" : "Incoming";
                value: c.when;
                avatar: c.initials;
                avatar-tint: c.tint;
                clicked => {
                    root.number = c.name;
                    root.view = "call";
                }
            }
        }
    }

    // In call
    if view == "call": Rectangle {
        background: @linear-gradient(180deg, #10233f 0%, #000000 100%);
        VerticalLayout {
            padding: 24 * Theme.dp;
            padding-top: 48 * Theme.dp;
            spacing: 12 * Theme.dp;
            HorizontalLayout {
                alignment: center;
                Avatar {
                    initials: number == "" ? "AL" : "#";
                    tint: Theme.accent;
                    size: Theme.avatar-large;
                }
            }

            Text {
                text: call-number != "" ? call-number : number == "" ? "Ava Lindqvist" : number;
                color: Theme.text;
                font-size: Theme.font-title * 1.3;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                text: call-state != "" ? call-state : "00:42";
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: space-around;
                RoundButton {
                    icon: muted ? @image-url("../icons/sys/mic_off.svg") : @image-url("../icons/sys/mic.svg");
                    label: "Mute";
                    active: muted;
                    clicked => { root.muted = !root.muted; }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/keypad.svg");
                    label: "Keypad";
                }

                RoundButton {
                    icon: @image-url("../icons/sys/speaker.svg");
                    label: "Speaker";
                    active: speaker;
                    clicked => { root.speaker = !root.speaker; }
                }
            }

            Rectangle { height: 18 * Theme.dp; }

            HorizontalLayout {
                alignment: space-around;
                if call-incoming && call-state == "Incoming call": RoundButton {
                    icon: @image-url("../icons/sys/call.svg");
                    size: 68 * Theme.dp;
                    fill: Theme.ok;
                    clicked => {
                        root.action("answer", "");
                    }
                }

                RoundButton {
                    icon: @image-url("../icons/sys/end_call.svg");
                    size: 68 * Theme.dp;
                    fill: Theme.danger;
                    clicked => {
                        root.action("hangup", "");
                        root.view = "";
                        root.number = "";
                    }
                }
            }
        }
    }
}
