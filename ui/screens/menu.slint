// SPDX-License-Identifier: Apache-2.0
// The app menu: a scrolling grid, 3 columns in portrait and 4 in landscape (Belle's menu, 135 dp rows). A long press
// on an app opens the kit's Menu at the finger: Add to home, or Remove from home when it has an icon there (home.md
// Part 3; saved at once, `HomePin`).
import { Theme } from "../theme.slint";
import { NeoList } from "../components/scroll.slint";
import { Badge } from "../components/footer.slint";
import { Menu } from "../components/menu.slint";
import { Toast } from "../components/feedback.slint";
import { HomePin } from "home-pin.slint";

export struct App { name: string, key: string, icon: image }

export global Apps {
    out property <[App]> all: [
        { name: "Phone", key: "phone", icon: @image-url("../icons/apps/phone.svg") },
        { name: "Messages", key: "messages", icon: @image-url("../icons/apps/messages.svg") },
        { name: "Contacts", key: "contacts", icon: @image-url("../icons/apps/contacts.svg") },
        { name: "Browser", key: "browser", icon: @image-url("../icons/apps/browser.svg") },
        { name: "Camera", key: "camera", icon: @image-url("../icons/apps/camera.svg") },
        { name: "Photos", key: "photos", icon: @image-url("../icons/apps/photos.svg") },
        { name: "Music", key: "music", icon: @image-url("../icons/apps/music.svg") },
        { name: "Calendar", key: "calendar", icon: @image-url("../icons/apps/calendar.svg") },
        { name: "Clock", key: "clock", icon: @image-url("../icons/apps/clock.svg") },
        { name: "Files", key: "files", icon: @image-url("../icons/apps/files.svg") },
        { name: "Settings", key: "settings", icon: @image-url("../icons/apps/settings.svg") },
        { name: "Terminal", key: "terminal", icon: @image-url("../icons/apps/terminal.svg") },
        { name: "Dev tools", key: "devtools", icon: @image-url("../icons/apps/devtools.svg") },
        { name: "Classic apps", key: "classic", icon: @image-url("../icons/apps/legacy.svg") },
        { name: "UI kit", key: "kit", icon: @image-url("../icons/apps/devtools.svg") },
    ];
    // the legacy bridge (LEGACY.EXE): not in the menu (Classic apps lists its apps), but named in Open apps while an
    // old app runs
    out property <App> bridge: { name: "Classic apps", key: "legacy", icon: @image-url("../icons/apps/legacy.svg") };
    // in: each app's badge count (ipc BADGE; missed calls, unread messages), in the order of `all`; 0 = none
    in property <[int]> badges;
}

export component MenuScreen inherits Rectangle {
    callback open-app(string);
    in-out property <int> selected: -1;
    property <int> cols: self.width > self.height ? 4 : 3;
    property <length> cell-w: self.width / cols;
    property <int> rows: Math.ceil(Apps.all.length / cols);
    // the long press: the app held and where (in this screen's coordinates)
    property <string> held;
    property <bool> held-pinned;
    property <length> held-x;
    property <length> held-y;
    NeoList {
        content-height: 12 * Theme.dp + rows * Theme.app-row-h;
        for app[i] in Apps.all: Rectangle {
            x: Math.mod(i, cols) * cell-w;
            y: 12 * Theme.dp + Math.floor(i / cols) * Theme.app-row-h;
            width: cell-w;
            height: Theme.app-row-h;

            // Selection: a soft plate behind the icon
            Rectangle {
                x: (parent.width - Theme.app-icon) / 2 - 8 * Theme.dp;
                y: 4 * Theme.dp;
                width: Theme.app-icon + 16 * Theme.dp;
                height: Theme.app-icon + 16 * Theme.dp;
                border-radius: Theme.radius + 6 * Theme.dp;
                background: i == selected ? Theme.selected : (touch.pressed ? Theme.pressed : transparent);
                border-width: i == selected ? max(1px, 1.5 * Theme.dp) : 0;
                border-color: Theme.hairline;
            }

            Image {
                x: (parent.width - Theme.app-icon) / 2;
                y: 12 * Theme.dp;
                width: Theme.app-icon;
                height: Theme.app-icon;
                source: app.icon;
            }

            if Apps.badges[i] > 0: Badge {
                x: (parent.width + Theme.app-icon) / 2 - self.width / 2 - 4 * Theme.dp;
                y: 8 * Theme.dp;
                count: Apps.badges[i];
            }

            Text {
                y: 12 * Theme.dp + Theme.app-icon + Theme.app-label-gap;
                width: parent.width;
                text: app.name;
                color: i == selected ? Theme.text : Theme.text-secondary;
                font-size: Theme.font-label;
                horizontal-alignment: center;
            }

            touch := TouchArea {
                // a long press is no tap: its release opens nothing
                property <bool> fired;
                changed pressed => {
                    if self.pressed {
                        self.fired = false;
                    }
                }
                clicked => {
                    if !self.fired {
                        root.selected = i;
                        root.open-app(app.key);
                    }
                }
            }
            Timer {
                interval: 500ms;
                running: touch.pressed && !touch.fired;
                triggered => {
                    touch.fired = true;
                    root.held = app.key;
                    root.held-pinned = HomePin.pinned(app.key);
                    root.held-x = touch.absolute-position.x - root.absolute-position.x + touch.mouse-x;
                    root.held-y = touch.absolute-position.y - root.absolute-position.y + touch.mouse-y;
                    app-menu.show();
                }
            }
        }
    }

    app-menu := Menu {
        x: 0;
        y: 0;
        right-aligned: false;
        bound: root.height;
        at-x: max(8 * Theme.dp, min(root.width - Theme.menu-w - 8 * Theme.dp, root.held-x - Theme.menu-w / 2));
        at-y: root.held-y;
        // shortcut: no "Add to dock" (home.md lists it: first free slot or replace one); the editor's dock slots do it
        items: [root.held-pinned ? "Remove from home" : "Add to home"];
        picked(i) => {
            HomePin.op(root.held-pinned ? "remove-home" : "add-home", root.held);
        }
    }

    // what Add to home / Remove from home did, for two seconds
    if HomePin.note != "": Toast {
        x: 12 * Theme.dp;
        width: root.width - 24 * Theme.dp;
        y: root.height - self.height - 12 * Theme.dp;
        text: HomePin.note;
    }
    Timer {
        interval: 2s;
        running: HomePin.note != "";
        triggered => {
            HomePin.note = "";
        }
    }
}
