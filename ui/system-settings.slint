// SPDX-License-Identifier: Apache-2.0
// The system settings as the UI sees them (docs/neoui-shell.md, Part 1). The UI server's settings store is the
// source of truth: it fills these at boot and whenever a value changes, through neoui-render's binding table
// (crates/neoui-render/src/settings.rs). Screens bind to these properties two-way; every change is reported with
// `edited(key)`, and the server stores it.
//
// Adding a setting the shell shows: a row in neoui-proto's registry, a property and a `changed` handler here, and a
// row in the binding table. The defaults below only matter before the server's first update (and in host tests);
// they mirror the registry's.

import { Theme } from "theme.slint";

export global SystemSettings {
    in-out property <bool> wifi: true;
    in-out property <bool> bluetooth: false;
    in-out property <bool> mobile-data: true;
    in-out property <bool> airplane: false;
    in-out property <bool> silent: false;
    in-out property <bool> vibrate: true;
    in-out property <int> ring-volume: 8;
    // media (NeoAudio): amp volume 0..10, route 0 both speakers, 1 earpiece, 2 bottom speaker
    in-out property <int> media-volume: 7;
    in-out property <int> media-route: 0;
    // the microphone recordings use: 0 main, 1 second (sound.mic)
    in-out property <int> mic: 0;
    in-out property <bool> dark: true;
    // 0.0 to 1.0; stored as 0 to 255 (display.brightness)
    in-out property <float> brightness: 160 / 255;
    in-out property <bool> clock-24h: true;
    // Settings -> Date & time
    in-out property <bool> time-auto: true;
    in-out property <bool> time-auto-zone: true;
    in-out property <int> date-format: 0;
    in-out property <bool> status-seconds: false;
    in-out property <bool> shade-date: true;
    // seconds before the screen turns off, 0 = never (display.timeout)
    in-out property <int> screen-timeout: 60;
    // 0 Buttons (the key row), 1 Gestures (the Thumb map), 2 N9 gestures (nav.mode; Navigation v2 D19)
    in-out property <int> nav-mode: 1;
    out property <string> nav-mode-name: nav-mode == 0 ? "Buttons" : nav-mode == 2 ? "N9 gestures" : "Gestures";
    in-out property <bool> usb-debugging: false;
    // Settings -> Battery -> Show percentage (SE3a): the status bar's battery shows its percent
    in-out property <bool> battery-show-percent: true;
    // Settings -> Battery -> Battery saver (SE3a): the status bar's battery fill turns amber
    in-out property <bool> battery-saver: false;
    // the system keyboard (Settings -> Language & keyboard): the languages on, the current one (an index into
    // keyboard/layouts.slint's list) and whether all are as tall as the tallest
    in-out property <bool> keyboard-en: true;
    in-out property <bool> keyboard-hy: true;
    in-out property <bool> keyboard-ru: true;
    in-out property <int> keyboard-layout: 0;
    in-out property <bool> keyboard-same-height: true;
    in-out property <bool> keyboard-hyw: false;
    // word suggestions on the keyboard's top band
    in-out property <bool> keyboard-suggest: false;
    // Settings -> Old apps: the key pads under old apps (LEGACY reads legacy.pad.*)
    in-out property <bool> legacy-pad-vibrate: true;
    in-out property <int> legacy-pad-strength: 1;
    in-out property <int> legacy-pad-default: 0;
    in-out property <int> legacy-pad-dirs: 0;
    in-out property <int> legacy-pad-a: 0;
    in-out property <int> legacy-pad-b: 0;
    in-out property <bool> legacy-pad-lefty: false;
    in-out property <bool> legacy-pad-console: false;
    in-out property <int> legacy-pad-epoch: 0;
    // (D7) home's wallpaper, a colour's name (display.wallpaper; components/wallpaper.slint), and the text size
    // (display.font_size 0..3): the shell's own text follows it through Theme.font-size
    in-out property <string> wallpaper: "night";
    in-out property <int> font-size: 1;
    // (D10) Open apps' columns 2..3 (nav.switcher_cols, G3), a drag down from the status bar closes the app in front
    // (nav.swipe_close, G4), home as 0 Pages or 1 Lanes (home.style, G5)
    in-out property <int> switcher-cols: 2;
    in-out property <bool> swipe-close: false;
    in-out property <int> home-style: 0;

    // A setting changed in the UI (its registry key); the server reads the property and stores it.
    callback edited(string);

    changed wifi => { edited("radio.wifi"); }
    changed bluetooth => { edited("radio.bt"); }
    changed mobile-data => { edited("radio.data"); }
    changed airplane => { edited("radio.airplane"); }
    changed silent => { edited("sound.silent"); }
    changed vibrate => { edited("sound.vibrate"); }
    changed ring-volume => { edited("sound.ring_volume"); }
    changed media-volume => { edited("sound.media_volume"); }
    changed media-route => { edited("sound.media_route"); }
    changed mic => { edited("sound.mic"); }
    changed dark => { edited("display.dark"); }
    changed brightness => { edited("display.brightness"); }
    changed clock-24h => { edited("clock.24h"); }
    changed time-auto => { edited("time.auto"); }
    changed time-auto-zone => { edited("time.auto_zone"); }
    changed date-format => { edited("time.date_format"); }
    changed status-seconds => { edited("status.seconds"); }
    changed shade-date => { edited("shade.date"); }
    changed screen-timeout => { edited("display.timeout"); }
    changed nav-mode => { edited("nav.mode"); }
    changed usb-debugging => { edited("developer.usb_debugging"); }
    changed battery-show-percent => { edited("battery.show_percent"); }
    changed battery-saver => { edited("battery.saver"); }
    changed keyboard-en => { edited("keyboard.en"); }
    changed keyboard-hy => { edited("keyboard.hy"); }
    changed keyboard-ru => { edited("keyboard.ru"); }
    changed keyboard-layout => { edited("keyboard.layout"); }
    changed keyboard-same-height => { edited("keyboard.same_height"); }
    changed keyboard-hyw => { edited("keyboard.hyw"); }
    changed keyboard-suggest => { edited("keyboard.suggest"); }
    changed legacy-pad-vibrate => { edited("legacy.pad.vibrate"); }
    changed legacy-pad-strength => { edited("legacy.pad.strength"); }
    changed legacy-pad-default => { edited("legacy.pad.default"); }
    changed legacy-pad-dirs => { edited("legacy.pad.dirs"); }
    changed legacy-pad-a => { edited("legacy.pad.a"); }
    changed legacy-pad-b => { edited("legacy.pad.b"); }
    changed legacy-pad-lefty => { edited("legacy.pad.lefty"); }
    changed legacy-pad-console => { edited("legacy.pad.console"); }
    changed legacy-pad-epoch => { edited("legacy.pad.epoch"); }
    changed wallpaper => { edited("display.wallpaper"); }
    changed switcher-cols => { edited("nav.switcher_cols"); }
    changed swipe-close => { edited("nav.swipe_close"); }
    changed home-style => { edited("home.style"); }
    changed font-size => {
        Theme.font-size = font-size;
        edited("display.font_size");
    }
}
