// SPDX-License-Identifier: Apache-2.0
// The system settings as the UI sees them (docs/neoui-shell.md, Part 1). The UI server's settings store is the
// source of truth: it fills these at boot and whenever a value changes, through neoui-render's binding table
// (crates/neoui-render/src/settings.rs). Screens bind to these properties two-way; every change is reported with
// `edited(key)`, and the server stores it.
//
// Adding a setting the shell shows: a row in neoui-proto's registry, a property and a `changed` handler here, and a
// row in the binding table. The defaults below only matter before the server's first update (and in host tests);
// they mirror the registry's.

export global SystemSettings {
    in-out property <bool> wifi: true;
    in-out property <bool> bluetooth: false;
    in-out property <bool> mobile-data: true;
    in-out property <bool> airplane: false;
    in-out property <bool> silent: false;
    in-out property <bool> vibrate: true;
    in-out property <int> ring-volume: 8;
    in-out property <bool> dark: true;
    // 0.0 to 1.0; stored as 0 to 255 (display.brightness)
    in-out property <float> brightness: 160 / 255;
    in-out property <bool> clock-24h: true;

    // A setting changed in the UI (its registry key); the server reads the property and stores it.
    callback edited(string);

    changed wifi => { edited("radio.wifi"); }
    changed bluetooth => { edited("radio.bt"); }
    changed mobile-data => { edited("radio.data"); }
    changed airplane => { edited("radio.airplane"); }
    changed silent => { edited("sound.silent"); }
    changed vibrate => { edited("sound.vibrate"); }
    changed ring-volume => { edited("sound.ring_volume"); }
    changed dark => { edited("display.dark"); }
    changed brightness => { edited("display.brightness"); }
    changed clock-24h => { edited("clock.24h"); }
}
