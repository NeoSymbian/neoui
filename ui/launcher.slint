// SPDX-License-Identifier: Apache-2.0
// NeoSymbian launcher: status bar, banner, grid of app tiles. Everything is
// sized from the window, so it fits 768x640 (Syborg) and 1080x2160 (Pixel).

// Bundled so the glyphs baked into the binary are the same on every build host.
import "fonts/Inter-VariableFont.ttf";

struct App {
    name: string,
    glyph: string,
    color: color,
}

export component Launcher inherits Window {
    default-font-family: "Inter";
    background: #101826;

    property <[App]> apps: [
        { name: "Phone", glyph: "P", color: #2fbf71 },
        { name: "Messages", glyph: "M", color: #3d8bfd },
        { name: "Contacts", glyph: "C", color: #f0a030 },
        { name: "Browser", glyph: "B", color: #20b2c8 },
        { name: "Camera", glyph: "Ca", color: #8a5cf6 },
        { name: "Files", glyph: "F", color: #e0b020 },
        { name: "Settings", glyph: "S", color: #7a8597 },
        { name: "Terminal", glyph: ">_", color: #e5484d },
    ];
    property <int> selected: -1;

    property <length> unit: min(self.width, self.height) / 40;
    property <int> cols: self.width > self.height ? 4 : 3;
    property <int> rows: Math.ceil(apps.length / cols);
    property <length> bar-h: unit * 2.4;
    property <length> banner-h: unit * 4;
    property <length> avail-y: bar-h + banner-h + unit;
    property <length> avail-h: self.height - avail-y - unit;
    property <length> cell-w: self.width / cols;
    property <length> cell-h: min(cell-w * 1.25, avail-h / rows);
    property <length> grid-y: avail-y + (avail-h - rows * cell-h) / 2;
    property <length> icon-size: min(cell-w, cell-h) * 0.55;

    // Status bar
    Rectangle {
        y: 0;
        height: bar-h;
        background: #070b12;
        Text {
            x: unit;
            text: "12:00";
            color: white;
            font-size: unit * 1.2;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            text: "NeoSymbian";
            color: #9fb0c8;
            font-size: unit * 1.1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Battery placeholder
        Rectangle {
            x: parent.width - unit * 3.6;
            width: unit * 2.4;
            height: unit * 1.1;
            border-width: max(1px, unit / 8);
            border-color: white;
            border-radius: unit / 5;
            Rectangle {
                x: unit / 4;
                width: (parent.width - unit / 2) * 0.7;
                height: parent.height - unit / 2;
                background: #2fbf71;
            }
        }

        Rectangle {
            x: parent.width - unit * 1.2;
            width: unit / 4;
            height: unit / 2;
            background: white;
        }
    }

    // Banner: shows the last tapped app.
    Rectangle {
        x: unit;
        y: bar-h + unit / 2;
        width: parent.width - 2 * unit;
        height: banner-h;
        border-radius: unit;
        background: selected < 0 ? #1b2738 : apps[selected].color.darker(30%);
        Text {
            text: selected < 0 ? "Tap an app" : "Opened " + apps[selected].name;
            color: white;
            font-size: unit * 1.6;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    for app[i] in apps: Rectangle {
        x: Math.mod(i, cols) * cell-w;
        y: grid-y + Math.floor(i / cols) * cell-h;
        width: cell-w;
        height: cell-h;

        // Selection halo
        Rectangle {
            x: (parent.width - icon-size) / 2 - unit / 2;
            y: unit / 2;
            width: icon-size + unit;
            height: icon-size + unit;
            border-radius: icon-size * 0.3;
            background: i == selected ? #ffffff40 : transparent;
            border-width: i == selected ? max(2px, unit / 5) : 0;
            border-color: white;
        }

        Rectangle {
            x: (parent.width - icon-size) / 2;
            y: unit;
            width: icon-size;
            height: icon-size;
            border-radius: icon-size * 0.24;
            background: touch.pressed ? app.color.darker(40%) : app.color;
            Text {
                text: app.glyph;
                color: white;
                font-size: icon-size * 0.45;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            y: unit * 1.6 + icon-size;
            width: parent.width;
            text: app.name;
            color: i == selected ? white : #c8d3e3;
            font-size: unit * 1.3;
            horizontal-alignment: center;
        }

        touch := TouchArea {
            clicked => {
                root.selected = i;
            }
        }
    }
}
