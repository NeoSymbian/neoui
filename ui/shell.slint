// SPDX-License-Identifier: Apache-2.0
// The NeoSymbian shell (Navigation v2, Shell v2): the status bar, the current screen, the bottom (the Buttons key row
// or the gesture band), dialogs, toasts, the keyboard and the notification shade. Apps draw their own header and footer
// with the kit; the shell's own screens get the kit's Header here.
// Navigation is two levels: `screen` (an app, "home" or "menu") and `view` (a sub-view of that app, "" = its main
// view). Back leaves the sub-view first, then returns to where the app was opened from.

// Bundled so the glyphs baked into the binary are the same on every build host.
import "fonts/NeoSans-Regular.ttf";
import "fonts/NeoSans-Medium.ttf";
import "fonts/NeoSans-SemiBold.ttf";
import "fonts/NeoSans-Bold.ttf";
import "fonts/UbuntuMono-Regular.ttf";
// Latin, Cyrillic and Armenian in one face: the Armenian keyboard (Slint draws a Text in one font, no fallback)
import "fonts/DejaVuSans.ttf";
import { Theme } from "theme.slint";
import { SystemSettings } from "system-settings.slint";
export { SystemSettings } from "system-settings.slint";
export { Now } from "now.slint";
import { Now } from "now.slint";
export { Scroll } from "components/scroll.slint";
export { WallpaperPicture } from "components/wallpaper.slint";
import { StatusBar, KeyRow, Band } from "components/frame.slint";
import { QueryDialog, Button, TextField } from "components/controls.slint";
import { Header } from "components/header.slint";
import { Toast } from "components/feedback.slint";
import { Shade, ShadeNote } from "components/shade.slint";
import { NotificationBanner } from "components/notification-banner.slint";
export { ShadeNote } from "components/shade.slint";
export { Apps } from "screens/menu.slint";
export { HomeModel } from "screens/home-edit.slint";
export { TilesModel, TileCell, WifiRow } from "components/tiles.slint";
import { TilesModel } from "components/tiles.slint";
export { HomePin } from "screens/home-pin.slint";
import { Keyboard } from "components/keyboard/keyboard.slint";
import { Alphabets } from "components/keyboard/glyphs.slint";
export { Layouts } from "components/keyboard/layouts.slint";
export { Layout } from "components/keyboard/types.slint";
export { KeyboardFocus } from "components/keyboard/focus.slint";
// D6: the shell's own kit controls that acted (vibrate on touch)
export { Kit } from "components/layers.slint";
import { KeyboardFocus } from "components/keyboard/focus.slint";
import { PowerMenu, PowerProfile } from "components/powermenu.slint";
import { HomeScreen } from "screens/home.slint";
import { HomeModel } from "screens/home-edit.slint";
import { MenuScreen } from "screens/menu.slint";
import { CameraScreen } from "screens/camera.slint";
import { PhotosScreen } from "screens/photos.slint";
import { MusicScreen } from "screens/music.slint";
import { WifiLink } from "data.slint";
import { TerminalScreen } from "screens/terminal.slint";
import { SwitcherScreen } from "screens/switcher.slint";

// A screen slot: fades and slides in when it becomes the current screen (Belle's app start: 0.25 s).
component Slot inherits Rectangle {
    in property <bool> active;
    visible: self.opacity > 0.01;
    opacity: active ? 1 : 0;
    animate opacity { duration: Theme.instant ? 0ms : Theme.open; easing: ease-out-quad; }
    // the content sits 16 dp lower while hidden and rises into place
    property <length> lift: active ? 0 : 16 * Theme.dp;
    animate lift { duration: Theme.instant ? 0ms : Theme.open; easing: ease-out-quad; }
    Rectangle {
        y: lift;
        width: parent.width;
        height: parent.height;
        @children
    }
}

export component Shell inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;

    in-out property <string> screen: "home";
    in-out property <string> view: "";
    in-out property <string> origin: "home";
    in-out property <bool> shade-open;
    // in: the UI server draws the screen-change fade itself from snapshots (smooth-ui S2); Slint switches at once
    in property <bool> server-transitions;
    changed server-transitions => {
        Theme.instant = self.server-transitions;
    }

    // leaving a screen or view hides the keyboard its field opened
    changed screen => {
        KeyboardFocus.close();
    }
    changed view => {
        KeyboardFocus.close();
    }

    // 1 dp = min(width, height) / 360 (the Belle reference screen is 360x640)
    property <length> dp: min(self.width, self.height) / 360;
    init => {
        Theme.dp = self.dp;
    }
    changed dp => {
        Theme.dp = self.dp;
    }

    // an app's full-screen page hides the status bar and the bottom (the UI server draws the app over both)
    property <bool> full: app-front && app-full;
    // in: Buttons' key row shows for 3 s over a full-screen page (the UI server, on a tap; rule 13)
    in property <bool> key-row-peek;
    // Buttons: the 56 dp key row; Gestures and N9: the 16 dp band (D12, D17)
    property <bool> buttons: SystemSettings.nav-mode == 0;
    property <length> bottom-h: buttons ? Theme.key-row-h : Theme.band-h;
    // out: the Symbian UI server places app processes' surfaces in this body rectangle (NeoSymbian R6)
    out property <length> body-y: Theme.status-h;
    // where the toast is (screen pixels) while one shows
    out property <length> toast-x: toast.x;
    out property <length> toast-y: toast.y;
    out property <length> toast-w: toast.width;
    out property <length> toast-h: toast.height;
    // (TP4) the banner where it is drawn (0 high while none shows): the UI server puts it back over the app's surface
    // and keeps the touches in it from the app
    out property <bool> banner-on: banner-card.visible;
    out property <length> banner-x: banner-card.x;
    out property <length> banner-y: banner-card.y;
    out property <length> banner-w: banner-card.width;
    out property <length> banner-h: banner-card.height;
    // the home screen's pages, for the UI server's swipe (smooth-ui S2c): which one shows, and the band they fill
    in-out property <int> home-page <=> home.page;
    out property <length> home-strip-h: home.strip-h;
    // (D10) home's pages (or Lanes' three lanes) side by side
    out property <int> home-page-count: home.page-count;
    // one rule for the shell's screens and apps (rule 16): Buttons 720 - 25 - 56 = 639, Gestures 720 - 25 - 16 = 679;
    // a mode switch resizes running apps once (AppEvent::Area)
    out property <length> body-h: self.height - Theme.status-h - bottom-h;
    out property <length> app-body-h: body-h;
    // in: the UI server shows the system keyboard above the key row or band, for an app that asked (R6c), in the
    // mode it asked for (0 hidden; proto::KEYBOARD's 1 text, 2 terminal, 3 number, 4 phone), and forwards what it
    // types; out: how much of an app's body it covers in each mode (rule 14: the whole keyboard; it changes with the
    // language and the settings). ˅ on the key row, a swipe down on it, or Back puts it away (KeyboardFocus.dismissed).
    in property <int> keyboard-mode;
    out property <length> keyboard-text-h: kb.text-h;
    out property <length> keyboard-term-h: kb.term-h;
    out property <length> keyboard-number-h: kb.number-h;
    out property <length> keyboard-phone-h: kb.phone-h;
    property <bool> keyboard-wanted: keyboard-mode > 0 || KeyboardFocus.open;
    callback typed(string);
    // in: an app process is in front: the shell's own mock of that screen stays hidden (an overlay shows over a dark
    // body, not over a mock)
    in property <bool> app-front;
    // in: the foreground app's page (ipc 1.8 PAGE): its name (Open apps), whether Back stays inside the app, full
    // screen. The shell reports taps through app-nav: "back", "answer" i, "note" (the toast's action).
    in property <string> app-title;
    in property <bool> app-back;
    in property <bool> app-full;
    // in: the front app is the legacy bridge (C++, no kit): the shell draws a header over its surface (the server
    // places the surface under it), ← while it keeps Back, ⋮ for its Options key ("options")
    in property <bool> app-legacy;
    in property <bool> app-legacy-options;
    // in: the foreground app's dialog (ipc 1.7 QUERY); answering closes it at once
    in-out property <bool> query-open;
    in property <string> query-text;
    in property <string> query-title;
    in property <[string]> query-buttons;
    in property <bool> query-destructive;
    callback app-nav(string, int);
    // in: a toast (ipc NOTE) above the bottom, drawn for the app that posted it; empty text = none
    in property <string> note-text;
    in property <string> note-action;
    // in: the apps' entries in the shade (ipc NOTIFY), newest first; out: the one tapped (its index)
    in property <[ShadeNote]> notes;
    callback note-opened(int, int);
    // TP2a: how many cards, a card swiped away (its row), Clear all, a group's ▾ (its row)
    in property <int> cards;
    callback note-dismissed(int);
    callback notes-cleared();
    callback group-toggled(int);
    // in: the apps the UI server keeps running, most recent first (R10); out: the switcher's close button
    in property <[string]> running;
    // (G3) their thumbnails, in the same order (an empty image: none)
    in property <[image]> thumbs;
    callback close-app(string);
    // Open apps' ⋮ Close all (the resident Phone stays)
    callback close-all();
    // in: the Power menu, opened by the UI server when Power is held (H3a); out: what it chose (2 = power off,
    // 0 = restart, -1 = dismissed)
    in property <bool> power-open;
    // the sound profiles it offers (SE2a) and the active one; choosing one is power(100 + id)
    in property <[PowerProfile]> power-profiles;
    in property <int> power-profile;
    callback power(int);
    // the shade's ⏻ (tp-shade): the UI server opens the Power menu
    callback power-asked();
    // in: the status bar's time, from the system clock (the default is the design's mock time)
    in property <string> clock: "10:24";
    in property <int> battery-percent: -1;
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    // the current link: the status bar's Wi-Fi icon (the Settings app, NEOSET, shows the rest itself)
    in property <WifiLink> wifi-link;
    // in: the modem (telephony C5, from MODEMD's NeoModem server): signal bars (-1 = no modem), operator, technology,
    // out: what the SIM prompt and the Retry banner asked
    // ("pin", "sim-dismiss", "dial", "retry"). The Phone app (NEOPHONE) draws the calls themselves.
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    in property <bool> roaming;
    // the status bar's word about the network instead of the operator's name: "" while registered, else "No SIM",
    // "No service"… (tp-statusbar)
    in property <string> network-note;
    // the status bar's app glyphs (neoui_render::status_apps: 0 bell, 1 message, 2 missed call, 3 folder, 4 alarm)
    // and how many apps more
    in property <[int]> status-glyphs;
    in property <int> status-more;
    in property <bool> phone-pending;
    in property <string> phone-feedback;
    // missed calls and unread messages (MODEMD, C9): Phone's and Messages' badges while they post none of their own
    in property <int> missed-calls;
    in property <int> unread-messages;
    // (TP4) the heads-up banner: its card, shown (the UI server times it out), a tap on it or an action (as the
    // shade's note-opened, by the banner's own card); Do not disturb's moon in the status bar
    in property <ShadeNote> banner;
    in-out property <bool> banner-shown;
    callback banner-opened(int);
    in property <bool> dnd;
    in property <bool> sim-pin-required;
    in property <bool> sim-blocked;
    in property <int> pin-attempts: -1;
    in property <bool> modem-failed;
    property <string> sim-pin;
    property <int> pin-length: sim-pin.character-count;
    changed sim-pin-required => {
        root.sim-pin = "";
        // the prompt and its field went away without letting go of the focus: the number pad closes with them
        if !self.sim-pin-required {
            focus-sink.focus();
            KeyboardFocus.close();
        }
    }
    function unlock() {
        if root.pin-length >= 4 && root.pin-length <= 8 && !root.phone-pending {
            root.phone-action("pin", root.sim-pin);
            root.sim-pin = "";
        }
    }
    callback phone-action(string, string);

    public function open(app: string) {
        // Back returns to the Apps menu, else home (an app another app opened returns to it: protocol 1.9 DONE)
        root.origin = root.screen == "menu" ? root.screen : "home";
        root.screen = app;
        root.view = "";
        root.shade-open = false;
    }

    public function back() {
        if (root.shade-open) {
            // (TP7) the Wi-Fi sheet or the tile editor first
            if !TilesModel.back() {
                root.shade-open = false;
            }
        } else if (root.screen == "home" && HomeModel.sheet != "") {
            HomeModel.sheet = "";
        } else if (root.screen == "home" && HomeModel.editing) {
            // the home editor's Back is its Done (D10): saved once
            HomeModel.op("done", 0, 0, 0, 0, "");
        } else if (root.view != "") {
            root.view = "";
        } else if (root.screen == "menu") {
            root.screen = "home";
        } else if (root.screen != "home") {
            root.screen = root.origin;
            root.origin = "home";
        }
    }

    // Back from the key row or an edge gesture (rule 10): close the shade or the dialog, then put the keyboard away,
    // then the page's own Back (the app's layers and pages), else back to where the app was opened from
    // the UI server took the touch over (Renderer::cancel_touch, the home pull): home's long press doesn't fire
    public function stop-home-hold() {
        home.stop-hold();
    }
    // a finger went down: home's long press may fire again
    public function touch-down() {
        home.hold-off = false;
    }

    public function nav-back() {
        if (root.shade-open) {
            root.back();
        } else if (root.app-front && root.query-open) {
            root.answer(root.query-buttons.length - 1);
        } else if (root.keyboard-wanted && !KeyboardFocus.dismissed) {
            if (root.app-front) {
                KeyboardFocus.dismissed = true;
            } else {
                KeyboardFocus.close();
                focus-sink.focus();
            }
        } else if (root.app-front && root.app-back) {
            root.app-nav("back", 0);
        } else {
            root.back();
        }
    }

    function answer(i: int) {
        root.query-open = false;
        root.app-nav("answer", i);
    }

    public function go-home() {
        root.screen = "home";
        root.view = "";
        root.shade-open = false;
    }

    // One line per app (titles and Options menus), so apps added in parallel don't collide on one long line.
    pure function screen-title(s: string, v: string) -> string {
        s == "home" ? ""
        : s == "menu" ? "Apps"
        : s == "phone" ? "Phone"
        : s == "contacts" ? "Contacts"
        : s == "browser" ? "Browser"
        : s == "camera" ? "Camera"
        : s == "photos" ? "Photos"
        : s == "music" ? (v == "playing" ? "Now playing" : "Music")
        : s == "calendar" ? "Calendar"
        : s == "clock" ? "Clock"
        : s == "files" ? "Files"
        : s == "settings" ? "Settings"
        : s == "terminal" ? "Terminal"
        : s == "devtools" ? "Dev tools"
        : s == "kit" ? "UI kit"
        : s == "legacy" || s == "classic" ? "Classic apps"
        : s == "switcher" ? "Open apps"
        : s
    }


    // A tap that no row, button or field takes lands here: the focused field lets go, so the keyboard closes.
    TouchArea {
        clicked => {
            focus-sink.focus();
        }
    }
    focus-sink := FocusScope {
        width: 0;
        height: 0;
    }

    // The shell's own screens get the kit's header (A3): the screen's name, ← in a sub-view, Open apps' ⋮ Close all.
    // Home has none (rule 12); an app in front draws its own.
    property <bool> has-header: (!root.app-front && root.screen != "home") || (root.app-front && root.app-legacy);
    if has-header: Header {
        y: root.body-y;
        width: root.width;
        title: root.app-front && root.app-title != "" ? root.app-title : screen-title(root.screen, root.view);
        has-back: root.app-front ? root.app-back : root.view != "";
        search: false;
        actions: root.app-front && root.app-legacy-options ? [
            { icon: @image-url("icons/sys/more.svg"), label: "Options" },
        ] : [];
        menu: !root.app-front && root.screen == "switcher" && root.running.length > 0 ? ["Close all"] : [];
        back => {
            if root.app-front {
                root.nav-back();
            } else {
                root.back();
            }
        }
        action(i) => {
            root.app-nav("options", 0);
        }
        menu-picked(i) => {
            root.close-all();
        }
    }

    // The current screen
    Rectangle {
        y: body-y + (has-header ? Theme.header-h : 0);
        height: body-h - (has-header ? Theme.header-h : 0);
        clip: true;

        Slot {
            active: screen == "home";
            home := HomeScreen {
                notes: root.notes;
                running: root.running;
                thumbs: root.thumbs;
                note-opened(i) => { root.note-opened(i, 0); }
                close-app(a) => { root.close-app(a); }
                open-app(a) => { root.open(a); }
                open-view(a, v) => { root.open(a); root.view = v; }
            }
        }

        Slot {
            active: screen == "menu";
            MenuScreen {
                open-app(a) => { root.open(a); }
            }
        }

        Slot {
            active: screen == "camera";
            CameraScreen { }
        }

        Slot {
            active: screen == "photos";
            PhotosScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "music";
            MusicScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "terminal" && !root.app-front;
            TerminalScreen { }
        }

        Slot {
            active: screen == "switcher";
            SwitcherScreen {
                running: root.running;
                thumbs: root.thumbs;
                shown: screen == "switcher";
                open-app(a) => { root.open(a); }
                close-app(a) => { root.close-app(a); }
            }
        }
    }

    Alphabets { }

    kb := Keyboard {
        // above the key row or the band (rule 14)
        y: root.height - root.bottom-h - self.height;
        // above the SIM prompt, whose PIN field uses it
        z: root.sim-pin-required ? 1 : 0;
        // the app's mode when one asked, else the one the shell's focused field wants
        mode: keyboard-mode > 0 ? keyboard-mode : KeyboardFocus.mode;
        // an app asked for it, or one of the shell's own fields has the focus, and the user didn't put it away
        visible: keyboard-wanted && !KeyboardFocus.dismissed;
        // the edit bar on the text keyboard: an app's field, or the shell's own (not the terminal, whose console would
        // get Control as a raw key, nor the pads)
        edit-bar: root.keyboard-mode > 0 ? root.app-front && root.keyboard-mode == 1 : KeyboardFocus.mode == 1;
        typed(t) => { root.typed(t); }
    }

    StatusBar {
        battery-percent: root.battery-percent;
        battery-charging: root.battery-charging;
        battery-connected: root.battery-connected;
        battery-full: root.battery-full;
        battery-show-percent: SystemSettings.battery-show-percent;
        y: 0;
        time: clock;
        bars: root.bars;
        note: root.network-note;
        rat: root.rat;
        wifi-bars: root.wifi-link.connected ? root.wifi-link.bars : -1;
        wifi-band: root.wifi-link.band;
        roaming: root.roaming;
        glyphs: root.status-glyphs;
        more: root.status-more;
        airplane: SystemSettings.airplane;
        ring-off: SystemSettings.silent || SystemSettings.ring-volume == 0;
        vibrate: SystemSettings.vibrate;
        alarm: Now.next-alarm != "";
        battery-saver: SystemSettings.battery-saver;
        dnd: root.dnd;
        visible: !root.full;
        tapped => {
            // (TP7) shell.tap: 0 the shade's first stop, 1 the control centre
            TilesModel.stop = SystemSettings.shell-tap == 1 ? 2 : 1;
            root.shade-open = !root.shade-open;
        }
        pulled => {
            root.shade-open = true;
        }
        // (TP7) a pull past the tiles goes on to the control centre
        pulled-far => {
            TilesModel.stop = 2;
        }
    }

    // the bottom (rule 06 / D17): Buttons' key row (also for 3 s over a full-screen page after a tap), or the band
    if root.buttons && (!root.full || root.key-row-peek): KeyRow {
        y: root.height - Theme.key-row-h;
        can-back: root.shade-open || (root.app-front ? root.app-back : root.screen != "home" || HomeModel.editing);
        keyboard: kb.visible;
        back => {
            root.nav-back();
        }
        home => {
            root.go-home();
        }
        apps => {
            if (root.screen != "switcher") {
                root.open("switcher");
            }
        }
    }
    if !root.buttons && !root.full: Band {
        y: root.height - Theme.band-h;
    }

    // the app's toast (ipc NOTE), 12 dp above the bottom or the keyboard; the UI server copies it back over the app's
    // surface (`toast-*`), which it composes over this frame
    toast := Toast {
        visible: root.note-text != "";
        x: 12 * Theme.dp;
        width: root.width - 24 * Theme.dp;
        y: (kb.visible ? kb.y : root.height - (root.full ? 0 : root.bottom-h)) - self.height - 12 * Theme.dp;
        text: root.note-text;
        action: root.note-action;
        acted => {
            root.app-nav("note", 0);
        }
    }

    // (TP4) an Urgent card's banner under the status bar, over the app; never over the shade or the Power menu
    banner-card := NotificationBanner {
        visible: root.banner-shown && !root.shade-open && !root.power-open;
        x: 8 * Theme.dp;
        width: root.width - 16 * Theme.dp;
        y: (root.full ? 0 : Theme.status-h) + 6 * Theme.dp;
        note: root.banner;
        opened(a) => {
            root.banner-shown = false;
            root.banner-opened(a);
        }
        closed => { root.banner-shown = false; }
    }

    // the key row stays usable under a dialog: its ← answers the last button (rule 15)
    QueryDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - (root.buttons && !root.full ? Theme.key-row-h : 0);
        open: root.app-front && root.query-open;
        text: root.query-text;
        title: root.query-title;
        buttons: root.query-buttons;
        destructive: root.query-destructive;
        answered(i) => { root.answer(i); }
    }

    Shade {
        y: Theme.status-h;
        // above Buttons' key row (tp-shade-buttons), whose Back puts it away
        height: root.height - Theme.status-h - (root.buttons && !root.full ? Theme.key-row-h : 0);
        open: shade-open;
        notes: root.notes;
        cards: root.cards;
        note-dismissed(i) => { root.note-dismissed(i); }
        notes-cleared => { root.notes-cleared(); }
        group-toggled(i) => { root.group-toggled(i); }
        note-opened(i, a) => {
            // an in-place action (kind 3, Mark read) leaves the shade open: its app isn't coming to the front
            if !(a > 0 && root.notes[i].kinds.length >= a && root.notes[i].kinds[a - 1] == 3) {
                root.shade-open = false;
            }
            root.note-opened(i, a);
        }
        open-view(a, v) => { root.open(a); root.view = v; }
        dismissed => { root.shade-open = false; }
        open-app(a) => { root.open(a); }
        // the shade stays until the UI server opens the Power menu (Renderer::set_power_menu closes it)
        power-asked => { root.power-asked(); }
    }

    PowerMenu {
        width: root.width;
        height: root.height;
        open: power-open;
        profiles: power-profiles;
        active: power-profile;
        chosen(a) => { root.power(a); }
    }

    // not over the shade or the Power menu: it would cover their buttons
    if modem-failed && !sim-pin-required && !sim-blocked && !shade-open && !power-open: Button {
        x: Theme.margin;
        y: Theme.status-h + 8 * Theme.dp;
        width: root.width - 2 * Theme.margin;
        text: "Modem unavailable · Retry";
        clicked => { root.phone-action("retry", ""); }
    }

    // PIN data lives only in this prompt, is cleared on submission, and never enters a log.
    if sim-pin-required || sim-blocked: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            x: Theme.margin;
            width: parent.width - 2 * Theme.margin;
            height: min(parent.height - 2 * Theme.margin, prompt.preferred-height);
            // centred, or above the number pad its PIN field brings up
            y: min((parent.height - self.height) / 2, (kb.visible ? kb.y : root.height) - self.height - Theme.margin);
            background: Theme.bg;
            border-radius: Theme.radius;
            prompt := VerticalLayout {
                padding: Theme.margin;
                spacing: 8 * Theme.dp;
                Text { text: root.sim-blocked ? "SIM blocked" : "Unlock SIM"; color: Theme.text; font-size: Theme.font-title; }
                Text {
                    text: root.sim-blocked ? "Unlock the SIM with your carrier's PUK procedure." : (root.pin-attempts >= 0 ? root.pin-attempts + " PIN attempts remaining" : "Enter the SIM PIN");
                    color: Theme.text-secondary;
                    font-size: Theme.font-label;
                    wrap: word-wrap;
                }
                if !root.sim-blocked: TextField {
                    placeholder: "PIN";
                    password: true;
                    keys: 3;
                    autofocus: true;
                    text <=> root.sim-pin;
                    accepted => { root.unlock(); }
                }
                if !root.sim-blocked: Button {
                    text: "Unlock";
                    clicked => { root.unlock(); }
                }
                // always a way out: an emergency call, or later (the SIM state changing brings it back)
                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    Button {
                        text: "Emergency call";
                        primary: false;
                        clicked => {
                            root.phone-action("sim-dismiss", "");
                            root.phone-action("dial", "112");
                        }
                    }
                    Button {
                        text: "Not now";
                        primary: false;
                        clicked => { root.phone-action("sim-dismiss", ""); }
                    }
                }
                if root.phone-feedback != "": Text { text: root.phone-feedback; color: Theme.danger; font-size: Theme.font-label; wrap: word-wrap; }
            }
        }
    }
}
