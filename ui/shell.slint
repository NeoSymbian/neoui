// SPDX-License-Identifier: Apache-2.0
// The NeoSymbian shell: status bar, the current screen, the toolbar, the Options menu and the notification shade.
// Navigation is two levels: `screen` (an app, "home" or "menu") and `view` (a sub-view of that app, "" = its main
// view). Back leaves the sub-view first, then returns to where the app was opened from.

// Bundled so the glyphs baked into the binary are the same on every build host.
import "fonts/Inter-VariableFont.ttf";
import "fonts/UbuntuMono-Regular.ttf";
// Latin, Cyrillic and Armenian in one face: the Armenian keyboard (Slint draws a Text in one font, no fallback)
import "fonts/DejaVuSans.ttf";
import { Theme } from "theme.slint";
export { SystemSettings } from "system-settings.slint";
export { Now } from "now.slint";
export { Scroll } from "components/scroll.slint";
import { StatusBar, Toolbar } from "components/frame.slint";
import { OptionsMenu, Button } from "components/controls.slint";
import { Shade } from "components/shade.slint";
import { Keyboard } from "components/keyboard/keyboard.slint";
import { Alphabets } from "components/keyboard/glyphs.slint";
export { Layouts } from "components/keyboard/layouts.slint";
export { Layout } from "components/keyboard/types.slint";
export { KeyboardFocus } from "components/keyboard/focus.slint";
import { KeyboardFocus } from "components/keyboard/focus.slint";
import { PowerMenu } from "components/powermenu.slint";
import { HomeScreen } from "screens/home.slint";
import { MenuScreen } from "screens/menu.slint";
import { MessagesScreen } from "screens/messages.slint";
import { BrowserScreen } from "screens/browser.slint";
import { CameraScreen } from "screens/camera.slint";
import { PhotosScreen } from "screens/photos.slint";
import { MusicScreen } from "screens/music.slint";
import { CalendarScreen } from "screens/calendar.slint";
import { ClockScreen } from "screens/clock.slint";
import { FilesScreen } from "screens/files.slint";
import { SettingsScreen } from "screens/settings.slint";
import { WifiNet, WifiLink } from "data.slint";
import { TerminalScreen } from "screens/terminal.slint";
import { SwitcherScreen } from "screens/switcher.slint";

// A screen slot: fades and slides in when it becomes the current screen (Belle's app start: 0.25 s).
component Slot inherits Rectangle {
    in property <bool> active;
    visible: self.opacity > 0.01;
    opacity: active ? 1 : 0;
    animate opacity { duration: Theme.instant ? 0ms : Theme.open; easing: ease-out-quad; }
    // the content sits 16 dp lower while hidden and rises into place
    property <length> lift: active ? 0 : 16 * Theme.dp;
    animate lift { duration: Theme.instant ? 0ms : Theme.open; easing: ease-out-quad; }
    Rectangle {
        y: lift;
        width: parent.width;
        height: parent.height;
        @children
    }
}

export component Shell inherits Window {
    default-font-family: "Inter";
    background: Theme.bg;

    in-out property <string> screen: "home";
    in-out property <string> view: "";
    in-out property <string> origin: "home";
    in-out property <bool> options-open;
    in-out property <bool> shade-open;
    // in: which build is running (kernel, user-side ROM, neoui), for Settings -> About phone
    in property <[string]> build-info;
    // in: the UI server draws the screen-change fade itself from snapshots (smooth-ui S2); Slint switches at once
    in property <bool> server-transitions;
    changed server-transitions => {
        Theme.instant = self.server-transitions;
    }

    // leaving a screen or view hides the keyboard its field opened
    changed screen => {
        KeyboardFocus.close();
    }
    changed view => {
        KeyboardFocus.close();
    }

    // 1 dp = min(width, height) / 360 (the Belle reference screen is 360x640)
    property <length> dp: min(self.width, self.height) / 360;
    init => {
        Theme.dp = self.dp;
    }
    changed dp => {
        Theme.dp = self.dp;
    }

    property <bool> has-toolbar: screen != "home";
    // out: the Symbian UI server places app processes' surfaces in this body rectangle (NeoSymbian R6)
    out property <length> body-y: Theme.status-h;
    // the home screen's pages, for the UI server's swipe (smooth-ui S2c): which one shows, and the band they fill
    in-out property <int> home-page <=> home.page;
    out property <length> home-strip-h: home.strip-h;
    out property <length> body-h: self.height - Theme.status-h - (has-toolbar ? Theme.toolbar-h : 0);
    // an app screen's body (they always have the toolbar): app surfaces are this size, also for an app started
    // while home shows (a resident app)
    out property <length> app-body-h: self.height - Theme.status-h - Theme.toolbar-h;
    // in: the UI server shows the system keyboard over the bottom of the body for an app that asked (R6c), in the
    // mode it asked for (0 hidden; proto::KEYBOARD's 1 text, 2 terminal), and forwards what it types; out: its
    // height in each mode, for the server to tell the app (it changes with the language and the settings)
    in property <int> keyboard-mode;
    out property <length> keyboard-text-h: kb.text-h;
    out property <length> keyboard-term-h: kb.term-h;
    callback typed(string);
    // in: the foreground app claimed the toolbar's Back / Options; the shell then reports them through app-nav
    // (1 = Back, 2 = Options) instead of acting (R8)
    in property <bool> app-back;
    in property <bool> app-options;
    // in: an app process is in front: the shell's own mock of that screen stays hidden (an overlay shows over a dark
    // body, not over a mock), and unclaimed toolbar buttons do nothing
    in property <bool> app-front;
    // in: what the foreground app put in the status bar's title and the toolbar's middle button (ipc 1.4 TITLE,
    // TOOLBAR: icon 0 none, 1 call, 2 add, 3 person_add, 4 edit, 5 check, 6 delete; style bits 1 pill, 2 Back is
    // Cancel, 4 empty); the middle button reports through app-nav(4)
    in property <string> app-title;
    in property <int> app-action;
    in property <string> app-action-label;
    in property <int> app-toolbar-style;
    callback app-nav(int);
    // in: the apps the UI server keeps running, most recent first (R10); out: the switcher's close button
    in property <[string]> running;
    callback close-app(string);
    // in: the Power menu, opened by the UI server when Power is held (H3a); out: what it chose (2 = power off,
    // 0 = restart, -1 = dismissed)
    in property <bool> power-open;
    callback power(int);
    // in: the status bar's time, from the system clock (the default is the design's mock time)
    in property <string> clock: "10:24";
    in property <int> battery-percent: -1;
    in property <string> battery-text: "--%";
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    in property <string> battery-voltage: "unknown";
    in property <string> battery-state: "Unknown";
    in property <string> battery-usb: "unknown";
    in property <string> battery-storage;
    in property <[float]> battery-history;
    // Wi-Fi scan results (symbian/src/wifi.rs, kernel HAL WlanScan)
    in property <string> wifi-status: "Searching…";
    in property <[WifiNet]> wifi-networks;
    in property <int> wifi-count;
    in property <int> wifi-hidden;
    in property <bool> wifi-scanning;
    // the Wi-Fi page's refresh button (symbian/src/wifi.rs scans at once)
    callback wifi-refresh();
    // Connect on a network's sheet (BSSID, password) and how that join is going (symbian/src/wifi.rs)
    callback wifi-connect(string, string);
    in property <string> wifi-message;
    // the current link (Settings' "Current network" + details, the status bar's Wi-Fi icon) and its buttons
    in property <WifiLink> wifi-link;
    callback wifi-disconnect();
    callback wifi-forget();
    // in: the modem (telephony C5, from MODEMD's NeoModem server): signal bars (-1 = no modem), operator, technology,
    // and whether a call is up (the shade's "return to call"); out: what the SIM prompt and the Retry banner asked
    // ("pin", "sim-dismiss", "dial", "retry"). The Phone app (NEOPHONE) draws the calls themselves.
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    in property <bool> in-call;
    in property <bool> phone-pending;
    in property <string> phone-feedback;
    in property <int> missed-calls;
    in property <bool> radio-online;
    in property <bool> sim-pin-required;
    in property <bool> sim-blocked;
    in property <int> pin-attempts: -1;
    in property <bool> modem-failed;
    property <string> sim-pin;
    property <int> pin-length;
    changed sim-pin-required => { root.sim-pin = ""; root.pin-length = 0; }
    callback phone-action(string, string);

    public function open(app: string) {
        root.origin = root.screen == "menu" ? "menu" : "home";
        root.screen = app;
        root.view = "";
        root.options-open = false;
        root.shade-open = false;
    }

    public function back() {
        if (root.shade-open) {
            root.shade-open = false;
        } else if (root.options-open) {
            root.options-open = false;
        } else if (root.view != "") {
            root.view = "";
        } else if (root.screen == "menu") {
            root.screen = "home";
        } else if (root.screen != "home") {
            root.screen = root.origin;
            root.origin = "home";
        }
    }

    pure function app-icon(i: int) -> image {
        i == 1 ? @image-url("icons/sys/call.svg")
        : i == 2 ? @image-url("icons/sys/add.svg")
        : i == 3 ? @image-url("icons/sys/person_add.svg")
        : i == 4 ? @image-url("icons/sys/edit.svg")
        : i == 5 ? @image-url("icons/sys/check.svg")
        : @image-url("icons/sys/delete.svg")
    }

    // One line per app (titles and Options menus), so apps added in parallel don't collide on one long line.
    pure function screen-title(s: string, v: string) -> string {
        s == "home" ? ""
        : s == "menu" ? "Menu"
        : s == "phone" ? "Phone"
        : s == "messages" ? (v == "thread" ? "Ava Lindqvist" : "Messages")
        : s == "contacts" ? "Contacts"
        : s == "browser" ? "Browser"
        : s == "camera" ? "Camera"
        : s == "photos" ? "Photos"
        : s == "music" ? (v == "playing" ? "Now playing" : "Music")
        : s == "calendar" ? "Calendar"
        : s == "clock" ? "Clock"
        : s == "files" ? "Files"
        : s == "settings" ? settings-title(v)
        : s == "terminal" ? "Terminal"
        : s == "devtools" ? "Dev tools"
        : s == "legacy" ? "Old apps"
        : s == "switcher" ? "Open apps"
        : s
    }

    pure function settings-title(v: string) -> string {
        v == "" ? "Settings"
        : v == "connectivity" ? "Connectivity"
        : v == "wifi" ? "Wi-Fi"
        : v == "display" ? "Display"
        : v == "developer" ? "Developer options"
        : v == "battery" ? "Battery"
        : v == "keyboard" ? "Language & keyboard"
        : v == "datetime" ? "Date & time"
        : v == "sounds" ? "Sounds"
        : "About phone"
    }

    pure function options(s: string, v: string) -> [string] {
        s == "messages" ? ["New message", "Mark all as read", "Delete conversations", "Settings"]
        : s == "photos" ? ["Slideshow", "Select", "Sort by date"]
        : s == "files" ? ["New folder", "Sort", "Show hidden files"]
        : s == "browser" ? ["New tab", "Bookmarks", "History", "Share page"]
        : s == "music" ? ["Shuffle all", "Playlists", "Sleep timer"]
        : ["Settings", "Help", "About"]
    }

    // The current screen
    Rectangle {
        y: body-y;
        height: body-h;
        clip: true;

        Slot {
            active: screen == "home";
            home := HomeScreen {
                open-app(a) => { root.open(a); }
                open-view(a, v) => { root.open(a); root.view = v; }
            }
        }

        Slot {
            active: screen == "menu";
            MenuScreen {
                open-app(a) => { root.open(a); }
            }
        }

        Slot {
            active: screen == "messages";
            MessagesScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "browser";
            BrowserScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "camera";
            CameraScreen { }
        }

        Slot {
            active: screen == "photos";
            PhotosScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "music";
            MusicScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "calendar";
            CalendarScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "clock" && !root.app-front;
            ClockScreen { }
        }

        Slot {
            active: screen == "files" && !root.app-front;
            FilesScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "settings";
            SettingsScreen {
                view <=> root.view;
                build: root.build-info;
                open-view(a, v) => { root.open(a); root.view = v; }
                battery-text: root.battery-text;
                battery-voltage: root.battery-voltage;
                battery-state: root.battery-state;
                battery-usb: root.battery-usb;
                battery-storage: root.battery-storage;
                battery-history: root.battery-history;
                wifi-status: root.wifi-status;
                wifi-networks: root.wifi-networks;
                wifi-count: root.wifi-count;
                wifi-hidden: root.wifi-hidden;
                wifi-scanning: root.wifi-scanning;
                wifi-refresh => { root.wifi-refresh(); }
                wifi-connect(b, p) => { root.wifi-connect(b, p); }
                wifi-message: root.wifi-message;
                wifi-link: root.wifi-link;
                wifi-disconnect => { root.wifi-disconnect(); }
                wifi-forget => { root.wifi-forget(); }
                radio-online: root.radio-online;
                phone-feedback: root.phone-feedback;
            }
        }

        Slot {
            active: screen == "terminal" && !root.app-front;
            TerminalScreen { }
        }

        Slot {
            active: screen == "switcher";
            SwitcherScreen {
                running: root.running;
                open-app(a) => { root.open(a); }
                close-app(a) => { root.close-app(a); }
            }
        }
    }

    Alphabets { }

    kb := Keyboard {
        y: body-y + body-h - self.height;
        mode: max(1, keyboard-mode);
        // an app asked for it, or one of the shell's own fields has the focus
        visible: keyboard-mode > 0 || KeyboardFocus.open;
        typed(t) => { root.typed(t); }
    }

    StatusBar {
        battery-percent: root.battery-percent;
        battery-text: root.battery-text;
        battery-charging: root.battery-charging;
        battery-connected: root.battery-connected;
        battery-full: root.battery-full;
        y: 0;
        time: clock;
        bars: root.bars;
        operator: root.operator;
        rat: root.rat;
        wifi-bars: root.wifi-link.connected ? root.wifi-link.bars : -1;
        wifi-band: root.wifi-link.band;
        title: root.app-front && root.app-title != "" ? root.app-title : screen-title(screen, view);
        tapped => {
            root.shade-open = !root.shade-open;
        }
        pulled => {
            root.shade-open = true;
        }
    }

    if has-toolbar: Toolbar {
        y: root.height - Theme.toolbar-h;
        has-action: root.app-front ? root.app-action > 0 : (screen == "messages" || screen == "browser" || screen == "clock" || screen == "menu");
        action-icon: root.app-front ? app-icon(root.app-action) : screen == "browser" ? @image-url("icons/sys/refresh.svg") : screen == "menu" ? @image-url("icons/sys/tabs.svg") : @image-url("icons/sys/add.svg");
        action-label: root.app-front ? root.app-action-label : "";
        action-pill: root.app-front && mod(root.app-toolbar-style, 2) == 1;
        back-cancel: root.app-front && mod(floor(root.app-toolbar-style / 2), 2) == 1;
        empty: root.app-front && mod(floor(root.app-toolbar-style / 4), 2) == 1;
        back => {
            if (root.app-back && !root.shade-open && !root.options-open) {
                root.app-nav(1);
            } else {
                root.back();
            }
        }
        options => {
            // an app in front owns Options (nothing when it didn't claim it); the shell's menu is for its own screens
            if (root.app-front) {
                if (root.app-options && !root.shade-open) {
                    root.app-nav(2);
                }
            } else {
                root.options-open = !root.options-open;
            }
        }
        action => {
            if (root.app-front) {
                if (!root.shade-open) {
                    root.app-nav(4);
                }
            } else if (root.screen == "messages") {
                root.view = "thread";
            } else if (root.screen == "menu") {
                root.open("switcher");
            }
        }
    }

    OptionsMenu {
        y: body-y;
        height: body-h;
        items: options(screen, view);
        open: options-open;
        dismissed => { root.options-open = false; }
        selected(i) => {
            root.options-open = false;
            if (i == "Settings") {
                root.open("settings");
            }
        }
    }

    Shade {
        y: Theme.status-h;
        height: root.height - Theme.status-h;
        open: shade-open;
        missed: root.missed-calls;
        active-call: root.in-call;
        return-call => { root.open("phone"); root.view = "call"; }
        open-view(a, v) => { root.open(a); root.view = v; }
        dismissed => { root.shade-open = false; }
        open-app(a) => { root.open(a); }
    }

    PowerMenu {
        width: root.width;
        height: root.height;
        open: power-open;
        chosen(a) => { root.power(a); }
    }

    if modem-failed && !sim-pin-required && !sim-blocked: Button {
        x: Theme.margin;
        y: Theme.status-h + 8 * Theme.dp;
        width: root.width - 2 * Theme.margin;
        text: "Modem unavailable · Retry";
        clicked => { root.phone-action("retry", ""); }
    }

    // PIN data lives only in this prompt, is cleared on submission, and never enters a log.
    if sim-pin-required || sim-blocked: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            x: Theme.margin;
            width: parent.width - 2 * Theme.margin;
            height: min(parent.height - 2 * Theme.margin, 430 * Theme.dp);
            y: (parent.height - self.height) / 2;
            background: Theme.bg;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: Theme.margin;
                spacing: 8 * Theme.dp;
                Text { text: root.sim-blocked ? "SIM blocked" : "Unlock SIM"; color: Theme.text; font-size: Theme.font-title; }
                Text {
                    text: root.sim-blocked ? "Unlock the SIM with your carrier's PUK procedure." : (root.pin-attempts >= 0 ? root.pin-attempts + " PIN attempts remaining" : "Enter the SIM PIN");
                    color: Theme.text-secondary;
                    font-size: Theme.font-label;
                    wrap: word-wrap;
                }
                if !root.sim-blocked: Text { text: root.pin-length == 0 ? "PIN" : root.pin-length + " digits entered"; color: Theme.text; font-size: Theme.font-body; }
                if !root.sim-blocked: VerticalLayout {
                    spacing: 5 * Theme.dp;
                    for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["Clear", "0", "Unlock"]]: HorizontalLayout {
                        spacing: 5 * Theme.dp;
                        for key in row: Button {
                            text: key;
                            primary: key == "Unlock";
                            clicked => {
                                if key == "Clear" { root.sim-pin = ""; root.pin-length = 0; }
                                else if key == "Unlock" {
                                    if root.pin-length >= 4 && !root.phone-pending {
                                        root.phone-action("pin", root.sim-pin);
                                        root.sim-pin = "";
                                        root.pin-length = 0;
                                    }
                                } else if root.pin-length < 8 { root.sim-pin += key; root.pin-length += 1; }
                            }
                        }
                    }
                }
                // always a way out: an emergency call, or later (the SIM state changing brings it back)
                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    Button {
                        text: "Emergency call";
                        primary: false;
                        clicked => {
                            root.phone-action("sim-dismiss", "");
                            root.phone-action("dial", "112");
                        }
                    }
                    Button {
                        text: "Not now";
                        primary: false;
                        clicked => { root.phone-action("sim-dismiss", ""); }
                    }
                }
                if root.phone-feedback != "": Text { text: root.phone-feedback; color: Theme.danger; font-size: Theme.font-label; wrap: word-wrap; }
            }
        }
    }
}
