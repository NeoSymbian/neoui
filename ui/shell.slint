// SPDX-License-Identifier: Apache-2.0
// The NeoSymbian shell: status bar, the current screen, the bottom strip, the Options sheet, dialogs and the
// notification shade (docs gestures.md, Five places: apps describe their page, the shell draws the rest).
// Navigation is two levels: `screen` (an app, "home" or "menu") and `view` (a sub-view of that app, "" = its main
// view). Back leaves the sub-view first, then returns to where the app was opened from.

// Bundled so the glyphs baked into the binary are the same on every build host.
import "fonts/Inter-VariableFont.ttf";
import "fonts/UbuntuMono-Regular.ttf";
// Latin, Cyrillic and Armenian in one face: the Armenian keyboard (Slint draws a Text in one font, no fallback)
import "fonts/DejaVuSans.ttf";
import { Theme } from "theme.slint";
import { SystemSettings } from "system-settings.slint";
export { SystemSettings } from "system-settings.slint";
export { Now } from "now.slint";
export { Scroll } from "components/scroll.slint";
import { StatusBar, Strip } from "components/frame.slint";
import { OptionsMenu, QueryDialog, Button, TextField } from "components/controls.slint";
import { Shade } from "components/shade.slint";
import { Keyboard } from "components/keyboard/keyboard.slint";
import { Alphabets } from "components/keyboard/glyphs.slint";
export { Layouts } from "components/keyboard/layouts.slint";
export { Layout } from "components/keyboard/types.slint";
export { KeyboardFocus } from "components/keyboard/focus.slint";
import { KeyboardFocus } from "components/keyboard/focus.slint";
import { PowerMenu } from "components/powermenu.slint";
import { HomeScreen } from "screens/home.slint";
import { MenuScreen } from "screens/menu.slint";
import { OldAppsScreen, OldApp } from "screens/oldapps.slint";
import { BrowserScreen } from "screens/browser.slint";
import { CameraScreen } from "screens/camera.slint";
import { PhotosScreen } from "screens/photos.slint";
import { MusicScreen } from "screens/music.slint";
import { CalendarScreen } from "screens/calendar.slint";
import { ClockScreen } from "screens/clock.slint";
import { FilesScreen } from "screens/files.slint";
import { SettingsScreen } from "screens/settings.slint";
import { WifiNet, WifiLink } from "data.slint";
import { TerminalScreen } from "screens/terminal.slint";
import { SwitcherScreen } from "screens/switcher.slint";

// A screen slot: fades and slides in when it becomes the current screen (Belle's app start: 0.25 s).
component Slot inherits Rectangle {
    in property <bool> active;
    visible: self.opacity > 0.01;
    opacity: active ? 1 : 0;
    animate opacity { duration: Theme.instant ? 0ms : Theme.open; easing: ease-out-quad; }
    // the content sits 16 dp lower while hidden and rises into place
    property <length> lift: active ? 0 : 16 * Theme.dp;
    animate lift { duration: Theme.instant ? 0ms : Theme.open; easing: ease-out-quad; }
    Rectangle {
        y: lift;
        width: parent.width;
        height: parent.height;
        @children
    }
}

export component Shell inherits Window {
    default-font-family: "Inter";
    background: Theme.bg;

    in-out property <string> screen: "home";
    in-out property <string> view: "";
    in-out property <string> origin: "home";
    in-out property <bool> options-open;
    in-out property <bool> shade-open;
    // in: which build is running (kernel, user-side ROM, neoui), for Settings -> About phone
    in property <[string]> build-info;
    // in: the UI server draws the screen-change fade itself from snapshots (smooth-ui S2); Slint switches at once
    in property <bool> server-transitions;
    changed server-transitions => {
        Theme.instant = self.server-transitions;
    }

    // leaving a screen or view hides the keyboard its field opened
    changed screen => {
        KeyboardFocus.close();
    }
    changed view => {
        KeyboardFocus.close();
    }

    // 1 dp = min(width, height) / 360 (the Belle reference screen is 360x640)
    property <length> dp: min(self.width, self.height) / 360;
    init => {
        Theme.dp = self.dp;
    }
    changed dp => {
        Theme.dp = self.dp;
    }

    // an app's full-screen page hides the status bar and the strip (the UI server draws the app over both)
    property <bool> full: app-front && app-full;
    // in: Classic's strip shows for a moment over a full-screen page (the UI server, on a tap)
    in property <bool> strip-peek;
    // Classic shows the strip everywhere, home too. Gestures: a shell screen with nothing in the strip (home, the Apps
    // menu, Settings) has none; an app keeps its body (its strip is plain black when empty)
    property <bool> has-strip: (!full || strip-peek) && (SystemSettings.nav-mode != 1 || app-front || page-busy);
    property <bool> page-busy: page-has-primary || sheet-items.length > 0;
    // out: the Symbian UI server places app processes' surfaces in this body rectangle (NeoSymbian R6)
    out property <length> body-y: Theme.status-h;
    // the home screen's pages, for the UI server's swipe (smooth-ui S2c): which one shows, and the band they fill
    in-out property <int> home-page <=> home.page;
    out property <length> home-strip-h: home.strip-h;
    out property <length> body-h: self.height - Theme.status-h - (has-strip && !full ? Theme.strip-h : 0);
    // an app screen's body (the strip is the same height in both modes): app surfaces are this size, also for an app
    // started while home shows (a resident app)
    out property <length> app-body-h: self.height - Theme.status-h - Theme.strip-h;
    // in: the UI server shows the system keyboard at the bottom, over the strip, for an app that asked (R6c), in the
    // mode it asked for (0 hidden; proto::KEYBOARD's 1 text, 2 terminal, 3 number, 4 phone), and forwards what it
    // types; out: how much of an app's body it covers in each mode, for the server to tell the app (it changes with
    // the language and the settings). Its hide key (and Back) puts it away (KeyboardFocus.dismissed).
    in property <int> keyboard-mode;
    out property <length> keyboard-text-h: max(0, kb.text-h - Theme.strip-h);
    out property <length> keyboard-term-h: max(0, kb.term-h - Theme.strip-h);
    out property <length> keyboard-number-h: max(0, kb.number-h - Theme.strip-h);
    out property <length> keyboard-phone-h: max(0, kb.phone-h - Theme.strip-h);
    property <bool> keyboard-wanted: keyboard-mode > 0 || KeyboardFocus.open;
    callback typed(string);
    // in: an app process is in front: the shell's own mock of that screen stays hidden (an overlay shows over a dark
    // body, not over a mock)
    in property <bool> app-front;
    // Installed apps advertised by LEGACY; tile taps keep the grid visible until it asks for FRONT(1).
    in property <[OldApp]> old-apps;
    callback open-entry(int);
    // in: the foreground app's page (ipc 1.7 PAGE, or the one the UI server builds from an older app's NAV, TITLE and
    // TOOLBAR): its title; whether Back stays inside the app; its primary action (icon as proto::TOOL_*, 0 none);
    // Cancel; the Options sheet's items, or (legacy) the app's own Options; page dots; full screen. The shell reports
    // taps through app-nav: "back", "options" (legacy), "primary", "cancel", "option" i, "answer" i.
    in property <string> app-title;
    in property <bool> app-back;
    in property <bool> app-has-primary;
    in property <int> app-primary-icon;
    in property <string> app-primary-label;
    in property <bool> app-cancel;
    in property <[string]> app-options;
    in property <bool> app-legacy-options;
    in property <int> app-dots;
    in property <int> app-dot;
    in property <bool> app-full;
    // in: the foreground app's dialog (ipc 1.7 QUERY); answering closes it at once
    in-out property <bool> query-open;
    in property <string> query-text;
    in property <[string]> query-buttons;
    in property <bool> query-destructive;
    callback app-nav(string, int);
    // in: the apps the UI server keeps running, most recent first (R10); out: the switcher's close button
    in property <[string]> running;
    callback close-app(string);
    // Open apps' ⋮ Close all (the resident Phone stays)
    callback close-all();
    // in: the Power menu, opened by the UI server when Power is held (H3a); out: what it chose (2 = power off,
    // 0 = restart, -1 = dismissed)
    in property <bool> power-open;
    callback power(int);
    // in: the status bar's time, from the system clock (the default is the design's mock time)
    in property <string> clock: "10:24";
    in property <int> battery-percent: -1;
    in property <string> battery-text: "--%";
    in property <bool> battery-charging;
    in property <bool> battery-connected;
    in property <bool> battery-full;
    in property <string> battery-voltage: "unknown";
    in property <string> battery-state: "Unknown";
    in property <string> battery-usb: "unknown";
    in property <string> battery-storage;
    in property <[float]> battery-history;
    // Wi-Fi scan results (symbian/src/wifi.rs, kernel HAL WlanScan)
    in property <string> wifi-status: "Searching…";
    in property <[WifiNet]> wifi-networks;
    in property <int> wifi-count;
    in property <int> wifi-hidden;
    in property <bool> wifi-scanning;
    // the Wi-Fi page's refresh button (symbian/src/wifi.rs scans at once)
    callback wifi-refresh();
    // Connect on a network's sheet (BSSID, password) and how that join is going (symbian/src/wifi.rs)
    callback wifi-connect(string, string);
    in property <string> wifi-message;
    // the current link (Settings' "Current network" + details, the status bar's Wi-Fi icon) and its buttons
    in property <WifiLink> wifi-link;
    callback wifi-disconnect();
    callback wifi-forget();
    // in: the modem (telephony C5, from MODEMD's NeoModem server): signal bars (-1 = no modem), operator, technology,
    // and whether a call is up (the shade's "return to call"); out: what the SIM prompt and the Retry banner asked
    // ("pin", "sim-dismiss", "dial", "retry"). The Phone app (NEOPHONE) draws the calls themselves.
    in property <int> bars: -1;
    in property <string> operator;
    in property <string> rat;
    in property <bool> in-call;
    in property <bool> phone-pending;
    in property <string> phone-feedback;
    in property <int> missed-calls;
    // unread messages (MODEMD, C9) and the shade's line for the newest ("+374 91 234567: Running late…")
    in property <int> unread-messages;
    in property <string> unread-line;
    in property <bool> radio-online;
    in property <bool> sim-pin-required;
    in property <bool> sim-blocked;
    in property <int> pin-attempts: -1;
    in property <bool> modem-failed;
    property <string> sim-pin;
    property <int> pin-length: sim-pin.character-count;
    changed sim-pin-required => {
        root.sim-pin = "";
        // the prompt and its field went away without letting go of the focus: the number pad closes with them
        if !self.sim-pin-required {
            focus-sink.focus();
            KeyboardFocus.close();
        }
    }
    function unlock() {
        if root.pin-length >= 4 && root.pin-length <= 8 && !root.phone-pending {
            root.phone-action("pin", root.sim-pin);
            root.sim-pin = "";
        }
    }
    callback phone-action(string, string);

    public function open(app: string) {
        root.origin = root.screen == "menu" ? "menu" : "home";
        root.screen = app;
        root.view = "";
        root.options-open = false;
        root.shade-open = false;
    }

    public function back() {
        if (root.shade-open) {
            root.shade-open = false;
        } else if (root.options-open) {
            root.options-open = false;
        } else if (root.view != "") {
            root.view = "";
        } else if (root.screen == "menu") {
            root.screen = "home";
        } else if (root.screen != "home") {
            root.screen = root.origin;
            root.origin = "home";
        }
    }

    // Back from the strip or the left-edge gesture (docs gestures.md rule 6): close the shade, the sheet or the
    // dialog, then put the keyboard away, then the page's own Back, else back to where the app was opened from
    public function nav-back() {
        if (root.shade-open || root.options-open) {
            root.back();
        } else if (root.app-front && root.query-open) {
            root.answer(root.query-buttons.length - 1);
        } else if (root.keyboard-wanted && !KeyboardFocus.dismissed) {
            if (root.app-front) {
                KeyboardFocus.dismissed = true;
            } else {
                KeyboardFocus.close();
                focus-sink.focus();
            }
        } else if (root.app-front && root.app-back) {
            root.app-nav("back", 0);
        } else {
            root.back();
        }
    }

    function answer(i: int) {
        root.query-open = false;
        root.app-nav("answer", i);
    }

    public function go-home() {
        root.screen = "home";
        root.view = "";
        root.options-open = false;
        root.shade-open = false;
    }

    // The strip's ⋮: the shell's sheet with the page's items, or an older app's own Options
    function options-pressed() {
        if (root.app-front && root.app-legacy-options && root.app-options.length == 0) {
            root.app-nav("options", 0);
        } else {
            root.options-open = !root.options-open;
        }
    }

    function primary-pressed() {
        if (root.app-front) {
            root.app-nav("primary", 0);
        } else if (root.screen == "home") {
            root.open("menu");
        } else if (root.screen == "switcher") {
            root.go-home();
        }
    }

    pure function app-icon(i: int) -> image {
        i == 1 ? @image-url("icons/sys/call.svg")
        : i == 2 ? @image-url("icons/sys/add.svg")
        : i == 3 ? @image-url("icons/sys/person_add.svg")
        : i == 4 ? @image-url("icons/sys/edit.svg")
        : i == 5 ? @image-url("icons/sys/check.svg")
        : @image-url("icons/sys/delete.svg")
    }

    // One line per app (titles and Options menus), so apps added in parallel don't collide on one long line.
    pure function screen-title(s: string, v: string) -> string {
        s == "home" ? ""
        : s == "menu" ? "Menu"
        : s == "phone" ? "Phone"
        : s == "contacts" ? "Contacts"
        : s == "browser" ? "Browser"
        : s == "camera" ? "Camera"
        : s == "photos" ? "Photos"
        : s == "music" ? (v == "playing" ? "Now playing" : "Music")
        : s == "calendar" ? "Calendar"
        : s == "clock" ? "Clock"
        : s == "files" ? "Files"
        : s == "settings" ? settings-title(v)
        : s == "terminal" ? "Terminal"
        : s == "devtools" ? "Dev tools"
        : s == "legacy" ? "Old apps"
        : s == "switcher" ? "Open apps"
        : s
    }

    pure function settings-title(v: string) -> string {
        v == "" ? "Settings"
        : v == "connectivity" ? "Connectivity"
        : v == "wifi" ? "Wi-Fi"
        : v == "display" ? "Display"
        : v == "navigation" ? "Home screen & navigation"
        : v == "developer" ? "Developer options"
        : v == "battery" ? "Battery"
        : v == "keyboard" ? "Language & keyboard"
        : v == "datetime" ? "Date & time"
        : v == "sounds" ? "Sounds"
        : "About phone"
    }

    // The shell's own pages (rule 5: ⋮ only where there are options, one primary action): Classic home's Apps, Open
    // apps' Home and Close all
    property <[string]> sheet-items: app-front ? app-options : screen == "switcher" && running.length > 0 ? ["Close all"] : [];
    property <bool> page-has-primary: app-front ? app-has-primary : (screen == "home" && SystemSettings.nav-mode != 1) || screen == "switcher";

    // A tap that no row, button or field takes lands here: the focused field lets go, so the keyboard closes.
    TouchArea {
        clicked => {
            focus-sink.focus();
        }
    }
    focus-sink := FocusScope {
        width: 0;
        height: 0;
    }

    // The current screen
    Rectangle {
        y: body-y;
        height: body-h;
        clip: true;

        Slot {
            active: screen == "home";
            home := HomeScreen {
                open-app(a) => { root.open(a); }
                open-view(a, v) => { root.open(a); root.view = v; }
            }
        }

        Slot {
            active: screen == "menu";
            MenuScreen {
                open-app(a) => { root.open(a); }
            }
        }

        Slot {
            active: screen == "browser";
            BrowserScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "camera";
            CameraScreen { }
        }

        Slot {
            active: screen == "photos";
            PhotosScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "music";
            MusicScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "calendar";
            CalendarScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "clock" && !root.app-front;
            ClockScreen { }
        }

        Slot {
            active: screen == "legacy" && !root.app-front;
            OldAppsScreen {
                entries: root.old-apps;
                open-entry(id) => { root.open-entry(id); }
            }
        }

        Slot {
            active: screen == "files" && !root.app-front;
            FilesScreen {
                view <=> root.view;
            }
        }

        Slot {
            active: screen == "settings";
            SettingsScreen {
                view <=> root.view;
                build: root.build-info;
                open-view(a, v) => { root.open(a); root.view = v; }
                battery-text: root.battery-text;
                battery-voltage: root.battery-voltage;
                battery-state: root.battery-state;
                battery-usb: root.battery-usb;
                battery-storage: root.battery-storage;
                battery-history: root.battery-history;
                wifi-status: root.wifi-status;
                wifi-networks: root.wifi-networks;
                wifi-count: root.wifi-count;
                wifi-hidden: root.wifi-hidden;
                wifi-scanning: root.wifi-scanning;
                wifi-refresh => { root.wifi-refresh(); }
                wifi-connect(b, p) => { root.wifi-connect(b, p); }
                wifi-message: root.wifi-message;
                wifi-link: root.wifi-link;
                wifi-disconnect => { root.wifi-disconnect(); }
                wifi-forget => { root.wifi-forget(); }
                radio-online: root.radio-online;
                phone-feedback: root.phone-feedback;
            }
        }

        Slot {
            active: screen == "terminal" && !root.app-front;
            TerminalScreen { }
        }

        Slot {
            active: screen == "switcher";
            SwitcherScreen {
                running: root.running;
                open-app(a) => { root.open(a); }
                close-app(a) => { root.close-app(a); }
            }
        }
    }

    Alphabets { }

    kb := Keyboard {
        y: root.height - self.height;
        // above the SIM prompt, whose PIN field uses it
        z: root.sim-pin-required ? 1 : 0;
        // the app's mode when one asked, else the one the shell's focused field wants
        mode: keyboard-mode > 0 ? keyboard-mode : KeyboardFocus.mode;
        // an app asked for it, or one of the shell's own fields has the focus, and the user didn't put it away
        visible: keyboard-wanted && !KeyboardFocus.dismissed;
        typed(t) => { root.typed(t); }
    }

    StatusBar {
        battery-percent: root.battery-percent;
        battery-text: root.battery-text;
        battery-charging: root.battery-charging;
        battery-connected: root.battery-connected;
        battery-full: root.battery-full;
        y: 0;
        time: clock;
        bars: root.bars;
        operator: root.operator;
        rat: root.rat;
        wifi-bars: root.wifi-link.connected ? root.wifi-link.bars : -1;
        wifi-band: root.wifi-link.band;
        unread: root.unread-messages > 0;
        visible: !root.full;
        title: root.app-front && root.app-title != "" ? root.app-title : screen-title(screen, view);
        dots: root.app-front ? root.app-dots : 0;
        dot: root.app-dot;
        tapped => {
            root.shade-open = !root.shade-open;
        }
        pulled => {
            root.shade-open = true;
        }
    }

    // the keyboard covers the strip (its hide key and Back put it away); the body keeps its size
    if has-strip && !kb.visible: Strip {
        y: root.height - Theme.strip-h;
        gestures: SystemSettings.nav-mode == 1;
        arrangement: SystemSettings.nav-strip;
        can-back: root.app-front ? root.app-back : root.view != "";
        cancel: root.app-front && root.app-cancel;
        has-primary: root.page-has-primary;
        primary-icon: root.app-front ? app-icon(root.app-primary-icon) : root.screen == "home" ? @image-url("icons/sys/apps.svg") : @image-url("icons/sys/home.svg");
        primary-has-icon: !root.app-front || root.app-primary-icon > 0;
        primary-label: root.app-front ? root.app-primary-label : root.screen == "home" ? "Apps" : "Home";
        has-options: root.sheet-items.length > 0 || (root.app-front && root.app-legacy-options);
        back => {
            root.nav-back();
        }
        home => {
            root.go-home();
        }
        apps => {
            if (root.screen != "switcher") {
                root.open("switcher");
            }
        }
        cancelled => {
            root.app-nav("cancel", 0);
        }
        primary => {
            root.primary-pressed();
        }
        options => {
            root.options-pressed();
        }
    }

    OptionsMenu {
        y: body-y;
        height: body-h;
        items: root.sheet-items;
        open: options-open;
        dismissed => { root.options-open = false; }
        picked(i) => {
            root.options-open = false;
            if (root.app-front) {
                root.app-nav("option", i);
            } else if (root.screen == "switcher") {
                root.close-all();
            }
        }
    }

    QueryDialog {
        width: root.width;
        height: root.height;
        open: root.app-front && root.query-open;
        text: root.query-text;
        buttons: root.query-buttons;
        destructive: root.query-destructive;
        answered(i) => { root.answer(i); }
    }

    Shade {
        y: Theme.status-h;
        height: root.height - Theme.status-h;
        open: shade-open;
        missed: root.missed-calls;
        unread: root.unread-messages;
        unread-line: root.unread-line;
        active-call: root.in-call;
        return-call => { root.open("phone"); root.view = "call"; }
        open-view(a, v) => { root.open(a); root.view = v; }
        dismissed => { root.shade-open = false; }
        open-app(a) => { root.open(a); }
    }

    PowerMenu {
        width: root.width;
        height: root.height;
        open: power-open;
        chosen(a) => { root.power(a); }
    }

    if modem-failed && !sim-pin-required && !sim-blocked: Button {
        x: Theme.margin;
        y: Theme.status-h + 8 * Theme.dp;
        width: root.width - 2 * Theme.margin;
        text: "Modem unavailable · Retry";
        clicked => { root.phone-action("retry", ""); }
    }

    // PIN data lives only in this prompt, is cleared on submission, and never enters a log.
    if sim-pin-required || sim-blocked: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            x: Theme.margin;
            width: parent.width - 2 * Theme.margin;
            height: min(parent.height - 2 * Theme.margin, prompt.preferred-height);
            // centred, or above the number pad its PIN field brings up
            y: min((parent.height - self.height) / 2, (kb.visible ? kb.y : root.height) - self.height - Theme.margin);
            background: Theme.bg;
            border-radius: Theme.radius;
            prompt := VerticalLayout {
                padding: Theme.margin;
                spacing: 8 * Theme.dp;
                Text { text: root.sim-blocked ? "SIM blocked" : "Unlock SIM"; color: Theme.text; font-size: Theme.font-title; }
                Text {
                    text: root.sim-blocked ? "Unlock the SIM with your carrier's PUK procedure." : (root.pin-attempts >= 0 ? root.pin-attempts + " PIN attempts remaining" : "Enter the SIM PIN");
                    color: Theme.text-secondary;
                    font-size: Theme.font-label;
                    wrap: word-wrap;
                }
                if !root.sim-blocked: TextField {
                    placeholder: "PIN";
                    password: true;
                    keys: 3;
                    autofocus: true;
                    text <=> root.sim-pin;
                    accepted => { root.unlock(); }
                }
                if !root.sim-blocked: Button {
                    text: "Unlock";
                    clicked => { root.unlock(); }
                }
                // always a way out: an emergency call, or later (the SIM state changing brings it back)
                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    Button {
                        text: "Emergency call";
                        primary: false;
                        clicked => {
                            root.phone-action("sim-dismiss", "");
                            root.phone-action("dial", "112");
                        }
                    }
                    Button {
                        text: "Not now";
                        primary: false;
                        clicked => { root.phone-action("sim-dismiss", ""); }
                    }
                }
                if root.phone-feedback != "": Text { text: root.phone-feedback; color: Theme.danger; font-size: Theme.font-label; wrap: word-wrap; }
            }
        }
    }
}
